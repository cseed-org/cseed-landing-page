# Copy to `.env` for local development. `.env` is gitignored; this file is not.
#
# Cloudflare Turnstile SITE key. Public by design: it is compiled into the HTML,
# so anyone can read it. The `PUBLIC_` prefix is what tells Astro that is intended.
#
# `1x00000000000000000000AA` is Cloudflare's test key — it always passes, which is
# what you want locally and in CI.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The matching SECRET key is NOT set here. It belongs to the Worker:
#   npx wrangler secret put TURNSTILE_SECRET --env staging
