# Local development template. Copy to .env; do not commit actual values.
# CI reads both settings from GitHub Actions repository secrets with these names.
# The two PUBLIC_ values appear in the built frontend.
PUBLIC_MEMBERSHIP_API_URL=https://cseed-membership-api.YOUR-SUBDOMAIN.workers.dev/api/membership
PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_PUBLIC_TURNSTILE_SITE_KEY

# Build-only settings. Never prefix these with PUBLIC_. Leave both unset for an
# empty wall in local development; production builds require both.
# MEMBER_NAMES_EXPORT_URL=https://cseed-membership-api.YOUR-SUBDOMAIN.workers.dev/internal/member-names
# MEMBER_NAMES_EXPORT_TOKEN=SET_A_RANDOM_SECRET_MATCHING_THE_WORKER
