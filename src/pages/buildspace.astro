---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Rule from '../components/core/Rule.astro';
import TextLink from '../components/core/TextLink.astro';
import TrackIcon from '../components/buildspace/TrackIcon.astro';

const facts = [
  ['duration', '6 weeks'],
  ['Priority Application Deadline', 'October 7th, 2026'],
  ['Final Application Deadline', 'October 9th, 2026'],
];

const details = [
  ['six weeks', 'One build night a week, in person, start to demo.'],
  ['new skills', 'Learn by making, with mentors in the room.'],
  ['real connections', 'People who think differently than you, building next to you.'],
  ['the gear', 'Access to the software and hardware you need to try it.'],
];

// Scattered polaroid photo collage between the intro and the four detail tiles -- position
// (l/t), size (w/h) and tilt (r, in degrees) straight from the design system's layout. Real
// photos are matched to whichever frame's aspect ratio fits them best; the rest stay
// placeholders until there are more photos to drop in.
const introPhotos: {
  id: string;
  l: number;
  t: number;
  w: number;
  h: number;
  r: number;
  src?: string;
  alt?: string;
}[] = [
  {
    id: 'bs-intro-1',
    l: 0,
    t: 90,
    w: 520,
    h: 620,
    r: -4,
    src: '/images/buildspace/intro-hardware-build.webp',
    alt: 'Members building an RC car chassis with Raspberry Pis and laptops at a build night',
  },
  {
    id: 'bs-intro-2',
    l: 490,
    t: 0,
    w: 480,
    h: 360,
    r: 3,
    src: '/images/buildspace/intro-demo-day.webp',
    alt: 'The whole buildspace cohort celebrating at demo day',
  },
  {
    id: 'bs-intro-3',
    l: 560,
    t: 400,
    w: 400,
    h: 380,
    r: -2,
    src: '/images/buildspace/intro-laptops.webp',
    alt: 'Members working together on laptops during a build night',
  },
  { id: 'bs-intro-4', l: 1010, t: 60, w: 380, h: 500, r: 5 },
  {
    id: 'bs-intro-5',
    l: 1420,
    t: 180,
    w: 460,
    h: 560,
    r: -3,
    src: '/images/buildspace/intro-thankyou-card.webp',
    alt: 'A handwritten thank-you card from the buildspace cohort 2 team',
  },
];

const projects: [string, string, string, number][] = [
  ['plantpal', 'A sensor that texts you when your plants are thirsty.', 'Maya Chen', 5],
  ['study buddy', 'Matches classmates into study groups by schedule.', 'Leo Novak', 5],
  ['thriftmap', 'A live map of secondhand stores and what just came in.', 'Zara Ahmed', 4],
  ['lofi loop', 'A browser synth for making study beats in a minute.', 'Kai Tanaka', 4],
  ['commute', 'Bus arrival times on an e-ink display by the door.', 'Omar Haddad', 3],
  ['potluck', 'Plan shared dinners without the group chat chaos.', 'Ruby Clarke', 3],
];

// `dot` is where each track's orbit dot sits, in degrees clockwise from the top.
const tracks = [
  { kind: 'hardware', label: 'hardware', ring: '#B45CE0', dot: 215 },
  { kind: 'software', label: 'software', ring: '#16A36F', dot: 35 },
  {
    kind: 'xra',
    label: 'extended reality',
    ring: '#2F5BFF',
    dot: 0,
    note: 'build with computer vision, AR and VR',
  },
  { kind: 'creatives', label: 'creatives', ring: '#FF0066', dot: 140 },
] as const;
---

<PageLayout title="buildspace — cseed">
  <section class="bs-space" id="cohort">
    <div class="bs-galaxy" data-galaxy aria-hidden="true"></div>
    <div class="bs-space-vignette" aria-hidden="true"></div>
    <div class="bs-space-copy">
      <Reveal delay={150}>
        <h2 class="t-serif" style="font-size:240px; color:var(--cseed-white)">
          join<br />cohort 6.
        </h2>
      </Reveal>
      <Reveal delay={300}>
        <p class="bs-body" style="color:var(--cseed-white); margin-top:60px; width:720px">
          Six weeks to bring your idea to life, alongside people building their own.
        </p>
      </Reveal>
      <Reveal delay={450}>
        <div class="bs-cohort-facts">
          {
            facts.map(([k, v]) => (
              <div class="bs-cohort-fact">
                <span class="bs-mono" style="font-size:18px; opacity:0.75">
                  {k}
                </span>
                <span class="bs-mono" style="font-size:30px">
                  {v}
                </span>
              </div>
            ))
          }
        </div>
      </Reveal>
      <Reveal delay={600}>
        <div style="margin-top:110px">
          <TextLink
            href="/join/"
            color="var(--cseed-white)"
            arrowLength={26}
            style="font:400 34px/1 var(--font-body); gap:14px"
          >
            apply for cohort 6
          </TextLink>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="bs-section">
    <div class="bs-intro">
      <Reveal delay={120}>
        <h1 class="t-serif" style="font-size:170px">
          What do you <span class="bs-dream"
            >dream<svg viewBox="-50 -50 100 100" aria-hidden="true"
              ><path
                d="M0 -48 C 5 -12, 12 -5, 48 0 C 12 5, 5 12, 0 48 C -5 12, -12 5, -48 0 C -12 -5, -5 -12, 0 -48 Z"
                fill="#E0636F"></path></svg
            ></span
          ><br />of making?
        </h1>
      </Reveal>
      <Reveal delay={260}>
        <div class="bs-intro-right">
          <p class="bs-body bs-intro-copy">
            Buildspace is a place to follow that half-formed thought.
          </p>
          <p class="bs-motto">
            <span class="bs-motto-highlight">Build things that don’t scale.</span>
          </p>
        </div>
      </Reveal>
    </div>

    <div class="bs-photo-collage">
      {
        introPhotos.map((p, i) => (
          <Reveal delay={i * 110} style={`position:absolute; left:${p.l}px; top:${p.t}px`}>
            <div class="bs-photo-frame" style={`transform:rotate(${p.r}deg)`}>
              {p.src ? (
                <img
                  class="bs-photo-img"
                  src={p.src}
                  alt={p.alt}
                  width={p.w}
                  height={p.h}
                  style={`width:${p.w}px; height:${p.h}px`}
                />
              ) : (
                <div class="bs-photo-slot" style={`width:${p.w}px; height:${p.h}px`}>
                  <span>photo</span>
                </div>
              )}
            </div>
          </Reveal>
        ))
      }
    </div>

    <div class="bs-details" data-bs-details>
      {
        details.map(([k, v], i) => (
          <Reveal delay={i * 120}>
            <div class="bs-detail" data-bs-detail>
              <div class="bs-detail-highlight" aria-hidden="true" />
              <Rule width="100%" weight={1} animate delay={i * 120} />
              <div class="bs-detail-title">{k}</div>
              <p class="bs-body" style="font-size:26px">
                {v}
              </p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <!-- Easter egg: click the block three times and it shatters, then reassembles. -->
  <div class="bs-explode" data-explode>
    <section class="bs-explode-block" data-explode-block>
      <div class="bs-explode-copy">
        <Reveal
          ><h2 class="t-serif" style="font-size:130px">
            Experimenting<br />is empowering.
          </h2></Reveal
        >
        <Reveal delay={150}><div class="bs-explode-tag">Explore. Experiment. Explode.</div></Reveal>
      </div>
      <img
        class="bs-cutout"
        src="/images/buildspace/explode-cutout.webp"
        alt="A cseed member presenting a hardware project"
        width="1342"
        height="1172"
      />
    </section>
  </div>

  <section class="bs-section">
    <div class="bs-head" style="margin-bottom:140px">
      <Reveal><div class="t-eyebrow">cohort 06 tracks</div></Reveal>
      <Reveal delay={120}><h2 class="t-serif">pick your track</h2></Reveal>
    </div>
    <div class="bs-tracks">
      {
        tracks.map((t, i) => (
          <Reveal delay={i * 120}>
            <div class="bs-track" data-kind={t.kind}>
              <div class="bs-track-icon" data-track-hover>
                <div class="bs-track-ring" style={`border-color:${t.ring}`} />
                <div class="bs-track-orbit" style={`transform:rotate(${t.dot}deg)`}>
                  <div class="bs-track-orbit bs-spin-5">
                    <div class="bs-track-orbit-dot" style={`background:${t.ring}`} />
                  </div>
                </div>
                <div class="bs-track-idle">
                  <div class="bs-spin-8">
                    <TrackIcon kind={t.kind} />
                  </div>
                </div>
                {'note' in t && (
                  <div class="bs-track-note">
                    <span>{t.note}</span>
                  </div>
                )}
              </div>
              <div class="bs-track-label">
                {t.label.split(' ').map((w) => (
                  <div>{w}</div>
                ))}
              </div>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <section class="bs-section">
    <div class="bs-head" style="margin-bottom:130px">
      <Reveal><div class="t-eyebrow">made at buildspace</div></Reveal>
      <Reveal delay={120}><h2 class="t-serif">past projects</h2></Reveal>
    </div>
    <div class="bs-projects">
      {
        projects.map(([name, blurb, by, cohort], i) => (
          <Reveal delay={(i % 3) * 120}>
            <div class="bs-project">
              <div class="bs-project-image">
                <span>project image</span>
              </div>
              <div class="t-eyebrow">
                cohort {String(cohort).padStart(2, '0')} / {by}
              </div>
              <h3 class="t-serif" style="font-size:64px; letter-spacing:-0.035em">
                {name}
              </h3>
              <p class="bs-body" style="font-size:26px">
                {blurb}
              </p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <div class="bs-group">
    <div class="bs-group-slot" style="height:520px"><span>group photo</span></div>
    <div class="bs-group-slot" style="height:620px"><span>group photo</span></div>
    <div class="bs-group-slot" style="height:520px"><span>group photo</span></div>
  </div>
</PageLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Track hover: cursor-following note ---------- */
  document.querySelectorAll<HTMLElement>('[data-track-hover]').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      const z = r.width / el.offsetWidth || 1;
      el.style.setProperty('--x', `${(e.clientX - r.left) / z}px`);
      el.style.setProperty('--y', `${(e.clientY - r.top) / z}px`);
    });
  });

  /* ---------- Details tiles: auto-cycling yellow highlight ---------- */
  function cycleDetails(container: HTMLElement) {
    const tiles = [...container.querySelectorAll<HTMLElement>('[data-bs-detail]')];
    if (!tiles.length || reduceMotion) return; // keep it static for reduced-motion users

    const HOLD = 2000; // how long each tile stays highlighted, in ms
    let i = 0;
    let visible = true;
    let timer = 0;

    function tick() {
      if (!visible || document.hidden) {
        timer = 0;
        return;
      }
      tiles.forEach((t, idx) => t.classList.toggle('is-highlighted', idx === i));
      i = (i + 1) % tiles.length;
      timer = window.setTimeout(tick, HOLD);
    }

    new IntersectionObserver((es) => {
      visible = es.some((e) => e.isIntersecting);
      if (visible && !document.hidden && !timer) tick();
    }).observe(container);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && visible && !timer) tick();
    });
  }
  const detailsEl = document.querySelector<HTMLElement>('[data-bs-details]');
  if (detailsEl) cycleDetails(detailsEl);

  /* ---------- Hero starfield: WebGL Galaxy shader, ported 1:1 from the cseed Design ----------
     System's Galaxy component (ui_kits/buildspace/Galaxy.jsx -- "after React Bits 'Galaxy'",
     raw WebGL, no dependency). Same shaders, same setup, same defaults; only the React-specific
     bits (useRef/useEffect) are swapped for direct DOM calls to match this file's style. The
     canvas-2D `starfield` below is that same component's own bundled fallback for browsers
     without WebGL -- it stays a fallback here too, unchanged in role. */
  const GALAXY_VERT = `
attribute vec2 position;
varying vec2 vUv;
void main() { vUv = position * 0.5 + 0.5; gl_Position = vec4(position, 0.0, 1.0); }
`;

  const GALAXY_FRAG = `
precision highp float;
uniform float uTime;
uniform vec3 uResolution;
uniform vec2 uFocal;
uniform vec2 uRotation;
uniform float uStarSpeed;
uniform float uDensity;
uniform float uHueShift;
uniform float uSpeed;
uniform vec2 uMouse;
uniform float uGlowIntensity;
uniform float uSaturation;
uniform bool uMouseRepulsion;
uniform float uTwinkleIntensity;
uniform float uRotationSpeed;
uniform float uRepulsionStrength;
uniform float uMouseActiveFactor;
uniform float uAutoCenterRepulsion;
uniform bool uTransparent;
uniform bool uUsePalette;
uniform vec3 uPalA;
uniform vec3 uPalB;
uniform vec3 uPalC;
uniform float uPalLighten;
varying vec2 vUv;

#define NUM_LAYER 4.0
#define STAR_COLOR_CUTOFF 0.2
#define MAT45 mat2(0.7071, -0.7071, 0.7071, 0.7071)
#define PERIOD 3.0

float Hash21(vec2 p) { p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
float tri(float x) { return abs(fract(x) * 2.0 - 1.0); }
float tris(float x) { float t = fract(x); return 1.0 - smoothstep(0.0, 1.0, abs(2.0 * t - 1.0)); }
float trisn(float x) { float t = fract(x); return 2.0 * (1.0 - smoothstep(0.0, 1.0, abs(2.0 * t - 1.0))) - 1.0; }
vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); }

float Star(vec2 uv, float flare) {
  float d = length(uv);
  float m = (0.05 * uGlowIntensity) / d;
  float rays = smoothstep(0.0, 1.0, 1.0 - abs(uv.x * uv.y * 1000.0));
  m += rays * flare * uGlowIntensity;
  uv *= MAT45;
  rays = smoothstep(0.0, 1.0, 1.0 - abs(uv.x * uv.y * 1000.0));
  m += rays * 0.3 * flare * uGlowIntensity;
  m *= smoothstep(1.0, 0.2, d);
  return m;
}

vec3 StarLayer(vec2 uv) {
  vec3 col = vec3(0.0);
  vec2 gv = fract(uv) - 0.5;
  vec2 id = floor(uv);
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      vec2 offset = vec2(float(x), float(y));
      vec2 si = id + offset;
      float seed = Hash21(si);
      float size = fract(seed * 345.32);
      float glossLocal = tri(uStarSpeed / (PERIOD * seed + 1.0));
      float flareSize = smoothstep(0.9, 1.0, size) * glossLocal;
      float red = smoothstep(STAR_COLOR_CUTOFF, 1.0, Hash21(si + 1.0)) + STAR_COLOR_CUTOFF;
      float blu = smoothstep(STAR_COLOR_CUTOFF, 1.0, Hash21(si + 3.0)) + STAR_COLOR_CUTOFF;
      float grn = min(red, blu) * seed;
      vec3 base = vec3(red, grn, blu);
      float hue = atan(base.g - base.r, base.b - base.r) / (2.0 * 3.14159) + 0.5;
      hue = fract(hue + uHueShift / 360.0);
      float sat = length(base - vec3(dot(base, vec3(0.299, 0.587, 0.114)))) * uSaturation;
      float val = max(max(base.r, base.g), base.b);
      base = hsv2rgb(vec3(hue, sat, val));
      if (uUsePalette) {
        float pt = Hash21(si + 7.0);
        vec3 pc = pt < 0.5 ? mix(uPalA, uPalB, pt * 2.0) : mix(uPalB, uPalC, pt * 2.0 - 1.0);
        base = mix(pc, vec3(1.0), uPalLighten) * (0.85 + 0.3 * val);
      }
      vec2 pad = vec2(tris(seed * 34.0 + uTime * uSpeed / 10.0), tris(seed * 38.0 + uTime * uSpeed / 30.0)) - 0.5;
      float star = Star(gv - offset - pad, flareSize);
      float twinkle = trisn(uTime * uSpeed + seed * 6.2831) * 0.5 + 1.0;
      twinkle = mix(1.0, twinkle, uTwinkleIntensity);
      star *= twinkle;
      col += star * size * base;
    }
  }
  return col;
}

void main() {
  vec2 focalPx = uFocal * uResolution.xy;
  vec2 uv = (vUv * uResolution.xy - focalPx) / uResolution.y;
  vec2 mouseNorm = uMouse - vec2(0.5);
  if (uAutoCenterRepulsion > 0.0) {
    float centerDist = length(uv);
    uv += normalize(uv) * (uAutoCenterRepulsion / (centerDist + 0.1)) * 0.05;
  } else if (uMouseRepulsion) {
    vec2 mousePosUV = (uMouse * uResolution.xy - focalPx) / uResolution.y;
    float mouseDist = length(uv - mousePosUV);
    uv += normalize(uv - mousePosUV) * (uRepulsionStrength / (mouseDist + 0.1)) * 0.05 * uMouseActiveFactor;
  } else {
    uv += mouseNorm * 0.1 * uMouseActiveFactor;
  }
  float a = uTime * uRotationSpeed;
  uv = mat2(cos(a), -sin(a), sin(a), cos(a)) * uv;
  uv = mat2(uRotation.x, -uRotation.y, uRotation.y, uRotation.x) * uv;
  vec3 col = vec3(0.0);
  for (float i = 0.0; i < 1.0; i += 1.0 / NUM_LAYER) {
    float depth = fract(i + uStarSpeed * uSpeed);
    float scale = mix(20.0 * uDensity, 0.5 * uDensity, depth);
    float fade = depth * smoothstep(1.0, 0.9, depth);
    col += StarLayer(uv * scale + i * 453.32) * fade;
  }
  if (uTransparent) {
    float alpha = min(smoothstep(0.0, 0.3, length(col)), 1.0);
    gl_FragColor = vec4(col, alpha);
  } else {
    gl_FragColor = vec4(col, 1.0);
  }
}
`;

  interface GalaxyOptions {
    focal?: [number, number];
    rotation?: [number, number];
    starSpeed?: number;
    density?: number;
    hueShift?: number;
    speed?: number;
    mouseInteraction?: boolean;
    glowIntensity?: number;
    saturation?: number;
    mouseRepulsion?: boolean;
    repulsionStrength?: number;
    twinkleIntensity?: number;
    rotationSpeed?: number;
    autoCenterRepulsion?: number;
    transparent?: boolean;
    palette?: [string, string, string] | null;
    paletteLighten?: number;
  }

  // Returns false (no canvas appended) when WebGL isn't available, so the caller can fall back
  // to the canvas-2D version below -- exactly what the source component does internally.
  function galaxyWebGL(ctn: HTMLElement, opts: GalaxyOptions = {}): boolean {
    const {
      focal = [0.5, 0.5],
      rotation = [1.0, 0.0],
      starSpeed = 0.5,
      density = 1,
      hueShift = 140,
      speed = 1.0,
      mouseInteraction = true,
      glowIntensity = 0.3,
      saturation = 0.0,
      mouseRepulsion = true,
      repulsionStrength = 2,
      twinkleIntensity = 0.3,
      rotationSpeed = 0.1,
      autoCenterRepulsion = 0,
      transparent = true,
      palette = null,
      paletteLighten = 0.7,
    } = opts;

    const canvas = document.createElement('canvas');
    const gl = (canvas.getContext('webgl', {
      alpha: transparent,
      premultipliedAlpha: false,
      antialias: false,
    }) || canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
    if (!gl) return false;
    canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;display:block';
    ctn.appendChild(canvas);

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, GALAXY_VERT));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, GALAXY_FRAG));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const posLoc = gl.getAttribLocation(prog, 'position');
    gl.enableVertexAttribArray(posLoc);
    gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);

    const U = (n: string) => gl.getUniformLocation(prog, n);
    const uNames = [
      'uTime',
      'uResolution',
      'uFocal',
      'uRotation',
      'uStarSpeed',
      'uDensity',
      'uHueShift',
      'uSpeed',
      'uMouse',
      'uGlowIntensity',
      'uSaturation',
      'uMouseRepulsion',
      'uTwinkleIntensity',
      'uRotationSpeed',
      'uRepulsionStrength',
      'uMouseActiveFactor',
      'uAutoCenterRepulsion',
      'uTransparent',
    ] as const;
    const u: Record<(typeof uNames)[number], WebGLUniformLocation | null> = {} as never;
    uNames.forEach((n) => {
      u[n] = U(n);
    });

    gl.uniform2fv(u.uFocal, focal);
    gl.uniform2fv(u.uRotation, rotation);
    gl.uniform1f(u.uDensity, density);
    gl.uniform1f(u.uHueShift, hueShift);
    gl.uniform1f(u.uSpeed, speed);
    gl.uniform1f(u.uGlowIntensity, glowIntensity);
    gl.uniform1f(u.uSaturation, saturation);
    gl.uniform1i(u.uMouseRepulsion, mouseRepulsion ? 1 : 0);
    gl.uniform1f(u.uTwinkleIntensity, twinkleIntensity);
    gl.uniform1f(u.uRotationSpeed, rotationSpeed);
    gl.uniform1f(u.uRepulsionStrength, repulsionStrength);
    gl.uniform1f(u.uAutoCenterRepulsion, autoCenterRepulsion);
    gl.uniform1i(u.uTransparent, transparent ? 1 : 0);

    const hx = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
    gl.uniform1i(U('uUsePalette'), palette ? 1 : 0);
    if (palette) {
      gl.uniform3fv(U('uPalA'), hx(palette[0]));
      gl.uniform3fv(U('uPalB'), hx(palette[1]));
      gl.uniform3fv(U('uPalC'), hx(palette[2]));
      gl.uniform1f(U('uPalLighten'), paletteLighten);
    }
    if (transparent) {
      gl.enable(gl.BLEND);
      gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
      gl.clearColor(0, 0, 0, 0);
    } else {
      gl.clearColor(0, 0, 0, 1);
    }

    const resize = () => {
      canvas.width = ctn.offsetWidth;
      canvas.height = ctn.offsetHeight;
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform3f(u.uResolution, canvas.width, canvas.height, canvas.width / canvas.height);
    };
    resize();
    new ResizeObserver(resize).observe(ctn);

    const target = { x: 0.5, y: 0.5, a: 0 };
    const smooth = { x: 0.5, y: 0.5, a: 0 };
    const onMove = (e: PointerEvent) => {
      const r = ctn.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = 1 - (e.clientY - r.top) / r.height;
      const inside = x >= 0 && x <= 1 && y >= 0 && y <= 1;
      if (inside) {
        target.x = x;
        target.y = y;
      }
      target.a = inside ? 1 : 0;
    };
    if (mouseInteraction) window.addEventListener('pointermove', onMove, { passive: true });

    let raf = 0;
    let visible = true;
    new IntersectionObserver((es) => {
      visible = es.some((e) => e.isIntersecting);
      if (visible && !raf) raf = requestAnimationFrame(frame);
    }).observe(ctn);

    function frame(t: number) {
      raf = 0;
      if (!reduce) {
        gl!.uniform1f(u.uTime, t * 0.001);
        gl!.uniform1f(u.uStarSpeed, (t * 0.001 * starSpeed) / 10);
      }
      smooth.x += (target.x - smooth.x) * 0.05;
      smooth.y += (target.y - smooth.y) * 0.05;
      smooth.a += (target.a - smooth.a) * 0.05;
      gl!.uniform2f(u.uMouse, smooth.x, smooth.y);
      gl!.uniform1f(u.uMouseActiveFactor, smooth.a);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      if (visible && !document.hidden) raf = requestAnimationFrame(frame);
    }
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && visible && !raf) raf = requestAnimationFrame(frame);
    });
    raf = requestAnimationFrame(frame);
    return true;
  }

  /* ---------- Hero starfield: the design's canvas-2D Galaxy fallback ---------- */
  function starfield(ctn: HTMLElement) {
    const o = {
      palette: ['#6F6BD6', '#9A5FB4', '#D65F7A'],
      paletteLighten: 0.72,
      density: 1.5,
      starSpeed: 0.5,
      speed: 1,
      twinkleIntensity: 0.3,
      rotationSpeed: 0.1,
      repulsionStrength: 0.6,
      glowIntensity: 0.5,
    };
    const canvas = document.createElement('canvas');
    canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;display:block';
    ctn.appendChild(canvas);
    const ctx = canvas.getContext('2d')!;
    const pal = o.palette.map((h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)));
    const L = o.paletteLighten;
    const col = (t: number) => {
      const [a, b] = t < 0.5 ? [pal[0], pal[1]] : [pal[1], pal[2]];
      const f = t < 0.5 ? t * 2 : t * 2 - 1;
      return a.map((v, i) => Math.round((v + (b[i] - v) * f) * (1 - L) + 255 * L));
    };
    type Star = { a: number; r: number; z: number; s: number; c: number[]; ph: number };
    let W = 0;
    let H = 0;
    let stars: Star[] = [];
    const build = () => {
      W = ctn.offsetWidth;
      H = ctn.offsetHeight;
      canvas.width = W;
      canvas.height = H;
      const n = Math.round(((W * H) / 2600) * o.density);
      stars = Array.from({ length: n }, () => ({
        a: Math.random() * Math.PI * 2,
        r: Math.sqrt(Math.random()),
        z: Math.random(),
        s: Math.random(),
        c: col(Math.random()),
        ph: Math.random() * 6.283,
      }));
    };
    build();
    new ResizeObserver(build).observe(ctn);

    const m = { x: 0, y: 0, a: 0, ta: 0 };
    window.addEventListener(
      'pointermove',
      (e) => {
        const r = ctn.getBoundingClientRect();
        const z = r.width / W || 1;
        m.x = (e.clientX - r.left) / z;
        m.y = (e.clientY - r.top) / z;
        m.ta = m.x >= 0 && m.y >= 0 && m.x <= W && m.y <= H ? 1 : 0;
      },
      { passive: true },
    );

    let raf = 0;
    let visible = true;
    const t0 = performance.now();
    new IntersectionObserver((es) => {
      visible = es.some((e) => e.isIntersecting);
      if (visible && !raf) raf = requestAnimationFrame(frame);
    }).observe(ctn);

    function frame(now: number) {
      raf = 0;
      const t = reduceMotion ? 0 : (now - t0) / 1000;
      m.a += (m.ta - m.a) * 0.05;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2;
      const cy = H / 2;
      const R = Math.hypot(cx, cy);
      const rot = t * o.rotationSpeed * 0.5;
      for (const s of stars) {
        const depth = (s.z + t * o.starSpeed * o.speed * 0.02) % 1;
        const rr = s.r * R * (0.35 + depth * 0.9);
        let x = cx + Math.cos(s.a + rot) * rr;
        let y = cy + Math.sin(s.a + rot) * rr;
        if (m.a > 0.01) {
          const dx = x - m.x;
          const dy = y - m.y;
          const d = Math.hypot(dx, dy) || 1;
          const p = ((o.repulsionStrength * 60) / (d / 100 + 0.4)) * m.a;
          x += (dx / d) * Math.min(p, 120);
          y += (dy / d) * Math.min(p, 120);
        }
        const fade = depth * Math.min(1, (1 - depth) * 10);
        const tw = 1 - o.twinkleIntensity * 0.5 * (1 + Math.sin(t * 2 + s.ph));
        const al = Math.min(1, fade * tw * 1.5);
        if (al < 0.02) continue;
        const size = (0.55 + s.s * s.s * 2.1) * (0.5 + depth);
        const [r, g, b] = s.c;
        ctx.fillStyle = `rgba(${r},${g},${b},${al})`;
        ctx.beginPath();
        ctx.arc(x, y, size, 0, 6.283);
        ctx.fill();
        if (s.s > 0.93) {
          const fl = size * 9 * o.glowIntensity * 2;
          ctx.fillStyle = `rgba(${r},${g},${b},${al * 0.14})`;
          ctx.beginPath();
          ctx.arc(x, y, size * 3.2, 0, 6.283);
          ctx.fill();
          ctx.fillStyle = `rgba(${r},${g},${b},${al * 0.55})`;
          ctx.fillRect(x - fl, y - 0.5, fl * 2, 1);
          ctx.fillRect(x - 0.5, y - fl, 1, fl * 2);
        }
      }
      if (visible && !document.hidden && !reduceMotion) raf = requestAnimationFrame(frame);
    }
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && visible && !raf) raf = requestAnimationFrame(frame);
    });
    raf = requestAnimationFrame(frame);
  }
  // Exact props from the source's <Galaxy> usage in SpaceCohort (BuildspacePage.jsx). The WebGL
  // shader is the real hero; the canvas-2D version only runs when WebGL truly isn't available --
  // same fallback boundary the source component draws itself.
  const galaxy = document.querySelector<HTMLElement>('[data-galaxy]');
  if (galaxy) {
    const ok = galaxyWebGL(galaxy, {
      mouseRepulsion: true,
      mouseInteraction: true,
      repulsionStrength: 0.6,
      density: 1.5,
      glowIntensity: 0.5,
      saturation: 0.8,
      hueShift: 240,
      palette: ['#6F6BD6', '#9A5FB4', '#D65F7A'],
      paletteLighten: 0.72,
    });
    if (!ok) starfield(galaxy);
  }

  /* ---------- Explode easter egg (ui_kits/buildspace/Explode.jsx) ---------- */
  function explode(wrap: HTMLElement, clicksNeeded = 3, overflowTop = 240) {
    const block = wrap.querySelector<HTMLElement>('[data-explode-block]')!;
    let clicks = 0;
    let busy = false;

    block.addEventListener('click', (e) => {
      if (busy) return;
      clicks += 1;
      if (clicks < clicksNeeded) {
        const a = 3 + clicks * 3;
        block.animate(
          [
            { transform: 'none' },
            { transform: `translate(${-a}px, ${a * 0.4}px) rotate(-0.4deg)` },
            { transform: `translate(${a}px, ${-a * 0.3}px) rotate(0.5deg)` },
            { transform: `translate(${-a * 0.5}px, 0)` },
            { transform: 'none' },
          ],
          { duration: 360, easing: 'ease-out' },
        );
        return;
      }
      clicks = 0;
      busy = true;

      const W = block.offsetWidth;
      const H = block.offsetHeight;
      const r = block.getBoundingClientRect();
      const z = r.width / W || 1;
      const ox = (e.clientX - r.left) / z;
      const oy = (e.clientY - r.top) / z;
      const cols = 8;
      const rows = 6;
      const top = -overflowTop;
      const cw = W / cols;
      const ch = (H - top) / rows;
      const pts: number[][] = [];
      for (let j = 0; j <= rows; j++)
        for (let i = 0; i <= cols; i++) {
          const edge = i === 0 || j === 0 || i === cols || j === rows;
          pts.push([
            i * cw + (edge ? 0 : (Math.random() - 0.5) * cw * 0.7),
            top + j * ch + (edge ? 0 : (Math.random() - 0.5) * ch * 0.7),
          ]);
        }
      const P = (i: number, j: number) => pts[j * (cols + 1) + i];

      const layer = document.createElement('div');
      layer.setAttribute('aria-hidden', 'true');
      layer.style.cssText = `position:absolute;left:0;top:0;width:${W}px;height:${H}px;pointer-events:none;z-index:20`;
      const pieces: { el: HTMLElement; vx: number; vy: number; vr: number; vz: number }[] = [];

      for (let j = 0; j < rows; j++)
        for (let i = 0; i < cols; i++) {
          const a = P(i, j);
          const b = P(i + 1, j);
          const c = P(i + 1, j + 1);
          const d = P(i, j + 1);
          const tris =
            (i + j) % 2
              ? [
                  [a, b, c],
                  [a, c, d],
                ]
              : [
                  [a, b, d],
                  [b, c, d],
                ];
          for (const t of tris) {
            const cx = (t[0][0] + t[1][0] + t[2][0]) / 3;
            const cy = (t[0][1] + t[1][1] + t[2][1]) / 3;
            const dx = cx - ox;
            const dy = cy - oy;
            const dist = Math.hypot(dx, dy) || 1;
            const force = 900 + 1400 * Math.exp(-dist / 500) + Math.random() * 500;
            const el = document.createElement('div');
            el.style.cssText = `position:absolute;left:0;top:0;width:${W}px;height:${H}px;will-change:transform,opacity;transform-origin:${cx}px ${cy}px;clip-path:polygon(${t.map(([x, y]) => `${x}px ${y}px`).join(',')})`;
            const copy = block.cloneNode(true) as HTMLElement;
            copy.removeAttribute('data-explode-block');
            copy.style.cssText = 'position:absolute;inset:0;margin:0;visibility:visible';
            copy.querySelectorAll('[data-reveal]').forEach((n) => {
              n.classList.add('is-shown');
              (n as HTMLElement).style.transition = 'none';
            });
            el.append(copy);
            layer.append(el);
            pieces.push({
              el,
              vx: (dx / dist) * force,
              vy: (dy / dist) * force - 700 - Math.random() * 500,
              vr: (Math.random() - 0.5) * 720,
              vz: Math.random() * 0.6,
            });
          }
        }

      wrap.append(layer);
      block.style.visibility = 'hidden';

      const DUR = reduceMotion ? 0.6 : 1.9;
      const G = 2600;
      let start: number | null = null;
      const tick = (now: number) => {
        if (start == null) start = now;
        const t = (now - start) / 1000;
        for (const p of pieces) {
          if (reduceMotion) {
            p.el.style.opacity = String(Math.max(0, 1 - t / DUR));
            continue;
          }
          const x = p.vx * t;
          const y = p.vy * t + 0.5 * G * t * t;
          p.el.style.transform = `translate(${x}px, ${y}px) rotate(${p.vr * t}deg) scale(${1 - p.vz * Math.min(1, t)})`;
          p.el.style.opacity = String(Math.max(0, 1 - Math.max(0, t - 1.1) / (DUR - 1.1)));
        }
        if (t < DUR) {
          requestAnimationFrame(tick);
          return;
        }
        layer.remove();
        block.style.visibility = '';
        block.animate(
          [
            { opacity: 0, transform: 'scale(0.96)' },
            { opacity: 1, transform: 'none' },
          ],
          {
            duration: 700,
            easing: 'cubic-bezier(.2,.8,.2,1)',
          },
        );
        busy = false;
      };
      requestAnimationFrame(tick);
    });
  }
  const explodeWrap = document.querySelector<HTMLElement>('[data-explode]');
  if (explodeWrap) explode(explodeWrap);
</script>

