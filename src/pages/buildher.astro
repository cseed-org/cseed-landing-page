---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Rule from '../components/core/Rule.astro';
import PondHero from '../components/buildher/PondHero.astro';

const pillars = [
  {
    kind: 'community' as const,
    title: 'community',
    body: 'Casual, fun events to meet women and non-binary builders across the community.',
    tilt: -1.8,
    photo: '/images/buildher/community.webp',
    alt: 'buildher members together at a social',
  },
  {
    kind: 'building' as const,
    title: 'building',
    body: 'Hands-on sessions and workshops where you make something alongside people doing the same.',
    tilt: 1.4,
    photo: '/images/buildher/launchpad.webp',
    alt: 'a hardware project being built at buildher',
  },
  {
    kind: 'mentorship' as const,
    title: 'mentorship',
    body: 'Time with industry professionals who can share their expertise and answer any questions you may have.',
    tilt: -0.6,
    photo: '/images/buildher/mentors.webp',
    alt: 'mochis and mentors event 2026',
  },
];

// Launchpad
const launchFacts = [
  ['when', 'every winter quarter'],
  ['duration', '6 weeks'],
  ['applications', 'open yearly'],
];
---

<PageLayout title="cseed | buildher" compactFooter responsive>
  <div class="bh-page">
  <PondHero>
    <div class="bh-hero-copy">
      <Reveal><h1 class="bh-hero-title">build<span class="bh-hero-her">her</span></h1></Reveal>
      <Reveal delay={160}>
        <p class="bh-hero-sub" style="white-space:pre-line">
          {'A safe and inclusive environment for women and non-binary students to build, learn, and explore entrepreneurship.'}
        </p>
      </Reveal>
    </div>
  </PondHero>

  <section class="bh-section">
    <Rule width="100%" weight={0.5} animate class="bh-rule" />
    <div class="bh-head" style="margin:70px 0 120px">
      <Reveal><div class="t-eyebrow">what we do</div></Reveal>
      <Reveal delay={120}><h2 class="t-serif">general events</h2></Reveal>
    </div>
    <div class="bh-events">
      {
        pillars.map((p, i) => (
          <Reveal delay={i * 130}>
            <div
              class="bh-event"
              style={`--tilt:${p.tilt}deg; --tape:${[-4, 3, -2][i]}deg; --tape-c:${['rgba(231,155,176,0.62)', 'rgba(140,176,110,0.58)', 'rgba(245,209,64,0.62)'][i]}; ${i === 1 ? 'margin-top:52px;' : ''}`}
            >
              <div class="bh-event-photo">
                <img src={p.photo} alt={p.alt} />
              </div>
              <h3 class="bh-event-title">{p.title}</h3>
              <p class="bh-body" style="font-size:21px">{p.body}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <section class="bh-launch">
    <div class="bh-launch-inner">
      <div class="bh-launch-copy">
        <Reveal><div class="t-eyebrow">the yearly cohort</div></Reveal>
        <Reveal delay={150}>
          <h2 class="bh-launch-title">launchpad</h2>
        </Reveal>
        <Reveal delay={300}>
          <p class="bh-body" style="margin-top:36px; max-width:900px">
            A cohort program designed to bring together and support women and non-binary builders interested in 
            creating anything from personal projects to startups!
          </p>
        </Reveal>
        <Reveal delay={450}>
          <div class="bh-launch-facts">
            {
              launchFacts.map(([k, v]) => (
                <div class="bh-launch-fact">
                  <span class="t-eyebrow t-eyebrow-sm">{k}</span>
                  <span class="bh-fact-value">{v}</span>
                </div>
              ))
            }
          </div>
        </Reveal>
        <Reveal delay={600}>
          <div class="bh-launch-status" style="margin-top:70px">
            <span class="bh-launch-dot"></span>application opening in the winter
          </div>
        </Reveal>
      </div>

      <div class="bh-scene">
        <svg class="bh-pond-water" viewBox="0 0 600 520" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <filter id="pond-edge" x="-20%" y="-20%" width="140%" height="140%">
              <feTurbulence type="fractalNoise" baseFrequency="0.004 0.005" numOctaves="1" seed="7" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="58" xChannelSelector="R" yChannelSelector="G" />
            </filter>
            <radialGradient id="pond-fill" cx="40%" cy="34%" r="76%">
              <stop offset="0%" stop-color="#54a2ad" />
              <stop offset="55%" stop-color="#3a8894" />
              <stop offset="100%" stop-color="#2c727e" />
            </radialGradient>
          </defs>
          <path
            filter="url(#pond-edge)"
            d="M300,44 C438,34 556,120 548,262 C540,392 428,472 300,470 C168,468 58,392 54,258 C50,118 168,54 300,44 Z"
            fill="url(#pond-fill)"
          />
        </svg>
        <div class="bh-scene-item bh-si-photo1 bh-float bh-f1">
          <Reveal mode="fade">
            <div class="bh-lp-photo" style="width:420px; aspect-ratio:1039/985; transform:rotate(-5deg)">
              <img class="bh-lp-frame" src="/images/buildher/lilypad-outline1.png" alt="" aria-hidden="true" />
              <div
                class="bh-lp-mask"
                style="-webkit-mask:url('/images/buildher/lilypad-outline1.png') center/contain no-repeat; mask:url('/images/buildher/lilypad-outline1.png') center/contain no-repeat"
              >
                <img src="/images/buildher/launchpad1.webp" alt="builder presenting at launchpad cohort 0" />
              </div>
            </div>
          </Reveal>
        </div>
        <div class="bh-scene-item bh-si-photo2 bh-float bh-f2">
          <Reveal mode="fade" delay={150}>
            <div class="bh-lp-photo" style="width:380px; aspect-ratio:1043/1025">
              <img class="bh-lp-frame" src="/images/buildher/lilypad-outline2.png" alt="" aria-hidden="true" />
              <div
                class="bh-lp-mask"
                style="-webkit-mask:url('/images/buildher/lilypad-outline2.png') center/contain no-repeat; mask:url('/images/buildher/lilypad-outline2.png') center/contain no-repeat"
              >
                <img src="/images/buildher/launchpad2.webp" alt="buildher launchpad cohort 0 event" />
              </div>
            </div>
          </Reveal>
        </div>
        <div class="bh-scene-item bh-si-lily1 bh-float bh-f4"><img class="bh-lily-img" src="/images/buildher/lily.webp" alt="" style="width:96px" /></div>
        <div class="bh-scene-item bh-si-lily2 bh-float bh-f2"><img class="bh-lily-img" src="/images/buildher/lily.webp" alt="" style="width:64px" /></div>
      </div>
    </div>
  </section>

  <div style="height:220px"></div>
  </div>
</PageLayout>

<style is:global>
  /* soft sage text-selection highlight, buildher page only */
  .bh-page ::selection {
    background: #c5e0b4;
    color: var(--cseed-ink);
  }
  .bh-page ::-moz-selection {
    background: #c5e0b4;
    color: var(--cseed-ink);
  }
</style>

<style>
  .bh-body {
    margin: 0;
    font: 300 34px/1.5 var(--font-body);
    color: var(--cseed-ink);
    text-wrap: pretty;
  }

  /* ---- pond hero ---- */
  .bh-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
    text-shadow: 0 2px 20px rgba(0, 20, 24, 0.45);
  }
  .bh-hero-eyebrow {
    color: var(--cseed-white);
  }
  .bh-hero-title {
    margin: 0;
    font: var(--weight-display) 240px/0.95 var(--font-display);
    letter-spacing: -0.045em;
    color: var(--cseed-white);
  }
  /* Uppercased in CSS so the heading still reads "buildher" to screen readers and search. */
  .bh-hero-her {
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #d97e98;
  }
  .bh-hero-tagline {
    font: 400 52px/1 var(--font-hand);
    letter-spacing: 0.03em;
    color: var(--cseed-seed);
    transform: rotate(-3deg);
    padding-left: 6px;
  }
  .bh-hero-sub {
    margin: 14px 0 0;
    max-width: 760px;
    font: 300 34px/1.5 var(--font-body);
    color: rgba(255, 255, 255, 0.92);
  }

  /* ---- header (no longer used) ---- */
  .bh-header {
    position: relative;
    padding: 330px 100px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }
  .bh-header-left {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .bh-title {
    background: linear-gradient(transparent 66%, rgba(245, 209, 64, 0.5) 66%, rgba(245, 209, 64, 0.5) 90%, transparent 90%);
    width: fit-content;
    padding-right: 8px;
  }
  .bh-tagline {
    font: 400 46px/1 var(--font-hand);
    letter-spacing: 0.03em;
    color: var(--cseed-ink);
    transform: rotate(-3deg);
    padding-left: 12px;
  }
  .bh-garden {
    position: absolute;
    top: 150px;
    right: 90px;
    width: 620px;
    height: 320px;
    pointer-events: none;
    z-index: 5;
  }
  .bh-garden .bh-float { position: absolute; }
  .bh-garden .bh-f1 { top: 40px; right: 380px; }
  .bh-garden .bh-f2 { top: 120px; right: 250px; }
  .bh-garden .bh-f3 { top: 8px; right: 150px; }
  .bh-garden .bh-f4 { top: 150px; right: 60px; }
  /* the header pads/lilies can be picked up and rearranged */
  .bh-draggable {
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
  }
  .bh-draggable.is-dragging {
    cursor: grabbing;
  }
  /* tiny hint that the pads/lilies are draggable; disappears after the first drag */
  .bh-drag-hint {
    position: absolute;
    top: 236px;
    right: 150px;
    z-index: 6;
    white-space: nowrap;
    font: 400 23px/1 var(--font-hand);
    color: var(--cseed-ink-soft);
    transform: rotate(-6deg);
    animation: bh-bob 4.5s var(--ease-inout) infinite alternate;
    transition: opacity 400ms var(--ease-soft);
    pointer-events: none;
  }
  .bh-drag-hint.is-hidden {
    animation: none;
    opacity: 0;
    pointer-events: none;
  }

  /* ---- section scaffold ---- */
  /* A hairline rule (not a colour block) marks the shift from the header. */
  .bh-section {
    padding: 150px 100px 60px;
  }
  .bh-head {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  /* ---- general events: scrapbook polaroids ---- */
  .bh-events {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
    align-items: start;
  }
  .bh-event {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 16px 16px 24px;
    background: #fffdf7; /* warm photo-paper white */
    border-radius: 3px;
    box-shadow:
      0 16px 34px -18px rgba(40, 34, 20, 0.34),
      0 2px 6px rgba(40, 34, 20, 0.09);
    transform: rotate(var(--tilt));
    transition:
      transform 600ms var(--ease-soft),
      box-shadow 600ms var(--ease-soft);
  }
  /* Hover-only, so a tapped card doesn't stay lifted on touch screens. */
  @media (hover: hover) {
    .bh-event:hover {
      transform: rotate(0deg) translateY(-12px);
      box-shadow:
        0 30px 56px -22px rgba(40, 34, 20, 0.4),
        0 4px 12px rgba(40, 34, 20, 0.1);
    }
    .bh-event:hover .bh-event-photo img {
      transform: scale(1.04);
    }
  }
  /* a strip of washi tape holding each polaroid up, lapping onto the photo */
  .bh-event::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    width: 150px;
    height: 46px;
    z-index: 3;
    transform: translateX(-50%) rotate(var(--tape, -3deg));
    background: var(--tape-c, rgba(245, 209, 64, 0.5));
    box-shadow: 0 1px 2px rgba(40, 34, 20, 0.08);
  }
  .bh-event-photo {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--cseed-mist);
  }
  .bh-event-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms var(--ease-soft);
  }
  .bh-event-title {
    margin: 22px 8px 8px;
    font: 400 40px/1 var(--font-hand);
    letter-spacing: 0.01em;
    color: var(--cseed-ink);
  }
  .bh-event .bh-body {
    padding: 0 8px;
    line-height: 1.45;
  }
  /* ---- launchpad ---- */
  .bh-launch {
    --bh-water: #2e6e7e;
    --bh-water-hi: #4c8a9a;
    --bh-lily-deep: #d97e98;
    position: relative;
    margin-top: 200px;
    padding: 40px 100px 0;
  }
  .bh-launch-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 40px;
    align-items: center;
  }
  .bh-launch-copy {
    position: relative;
  }
  .bh-launch-title {
    margin: 30px 0 0;
    font: italic 400 150px/0.95 var(--font-display);
    letter-spacing: -0.04em;
    color: var(--bh-lily-deep);
  }
  .bh-launch-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
    margin-top: 70px;
    max-width: 720px;
  }
  .bh-launch-fact {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid var(--cseed-ink);
    padding-top: 20px;
  }
  .bh-fact-value {
    font: 400 46px/1.05 var(--font-display);
    letter-spacing: -0.03em;
  }
  .bh-hand {
    position: absolute;
    top: -8px;
    right: 10px;
    font: 400 36px/1 var(--font-hand);
    letter-spacing: 0.04em;
    color: var(--bh-lily-deep);
    transform: rotate(-6deg);
  }
  .bh-launch-status {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font: 300 28px/1 var(--font-body);
    color: var(--cseed-ink);
  }
  .bh-launch-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #9cc07a;
    flex: none;
  }

  .bh-scene {
    position: relative;
    height: 780px;
  }
  .bh-pond-water {
    position: absolute;
    left: -4%;
    top: 8px;
    width: 108%;
    height: 720px;
    z-index: 0;
    opacity: 0.95;
    filter: drop-shadow(0 22px 40px rgba(0, 20, 24, 0.12));
  }
  .bh-water {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 20px 34px rgba(40, 34, 20, 0.14));
  }
  .bh-scene-item {
    position: absolute;
  }
  .bh-si-photo1 { left: 10px; top: 40px; z-index: 3; }
  .bh-si-photo2 { right: 8px; top: 356px; z-index: 3; }
  .bh-si-lily1 { left: 344px; top: 352px; z-index: 6; }
  .bh-si-lily2 { right: 320px; top: 630px; z-index: 6; }
  .bh-lp-photo {
    position: relative;
    aspect-ratio: 1039 / 985;
    filter: drop-shadow(0 14px 22px rgba(0, 20, 24, 0.36));
  }
  .bh-lp-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .bh-lp-mask {
    position: absolute;
    inset: 2.5%;
  }
  .bh-lp-mask img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bh-lily-img {
    display: block;
    filter: drop-shadow(0 8px 14px rgba(0, 20, 24, 0.28));
  }

  .bh-float { animation: bh-bob 6s var(--ease-inout) infinite alternate; }
  .bh-f1 { animation-duration: 6.4s; }
  .bh-f2 { animation-duration: 7.6s; animation-delay: -1.4s; }
  .bh-f3 { animation-duration: 5.4s; animation-delay: -0.8s; }
  .bh-f4 { animation-duration: 8.2s; animation-delay: -2.1s; }
  .bh-drift { animation: bh-bob 7s var(--ease-inout) infinite alternate; }
  .bh-d1 { animation-duration: 7.5s; }
  .bh-d2 { animation-duration: 6.6s; animation-delay: -1.2s; }
  .bh-d3 { animation-duration: 8s; animation-delay: -2s; }

  @keyframes bh-bob {
    from { transform: translateY(3px); }
    to { transform: translateY(-9px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bh-float, .bh-drift { animation: none; }
  }

  /* ---------- mobile canvas ---------- */
  @media (max-width: 900px), (pointer: coarse) and (max-height: 500px) {
    :global(html[data-responsive]) .bh-hero-title { font-size: 96px; }
    :global(html[data-responsive]) .bh-hero-sub { font-size: 26px; max-width: none; }

    :global(html[data-responsive]) .bh-section { padding: 90px 40px 20px; }
    :global(html[data-responsive]) .bh-head { margin: 50px 0 70px !important; }
    :global(html[data-responsive]) .bh-events { grid-template-columns: 1fr; gap: 72px; }
    :global(html[data-responsive]) .bh-event { margin: 0 auto !important; max-width: 460px; }
    :global(html[data-responsive]) .bh-event-title { font-size: 36px; }
    :global(html[data-responsive]) .bh-event .bh-body { font-size: 22px !important; }

    :global(html[data-responsive]) .bh-launch { padding: 60px 40px 0; }
    :global(html[data-responsive]) .bh-launch-inner { grid-template-columns: 1fr; gap: 24px; }
    :global(html[data-responsive]) .bh-launch-title { font-size: 84px; }
    :global(html[data-responsive]) .bh-launch .bh-body { font-size: 24px; }
    :global(html[data-responsive]) .bh-launch-facts { grid-template-columns: minmax(0, 1fr); gap: 24px; max-width: none; }
    :global(html[data-responsive]) .bh-fact-value { font-size: 36px; }
    :global(html[data-responsive]) .bh-scene { height: 700px; margin-top: 20px; }
  }
</style>

<script>
  const zoomOf = (el: HTMLElement) => {
    const r = el.getBoundingClientRect();
    return r.width / el.offsetWidth || 1;
  };
  document.querySelectorAll<HTMLElement>('.bh-draggable').forEach((el) => {
    let sx = 0, sy = 0, ox = 0, oy = 0, z = 1, dragging = false;
    el.addEventListener('pointerdown', (e) => {
      dragging = true;
      el.setPointerCapture(e.pointerId);
      el.classList.add('is-dragging');
      document.querySelector('[data-drag-hint]')?.classList.add('is-hidden'); // dismiss the hint once they try it
      el.style.animation = 'none'; // stop the bob while held
      z = zoomOf(el);
      ox = el.offsetLeft;
      oy = el.offsetTop;
      el.style.left = ox + 'px';
      el.style.top = oy + 'px';
      el.style.right = 'auto';
      el.style.bottom = 'auto';
      sx = e.clientX;
      sy = e.clientY;
      e.preventDefault();
    });
    el.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      el.style.left = ox + (e.clientX - sx) / z + 'px';
      el.style.top = oy + (e.clientY - sy) / z + 'px';
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      el.classList.remove('is-dragging');
    };
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);
  });
</script>
