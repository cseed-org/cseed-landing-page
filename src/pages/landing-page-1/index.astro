---
import '../../styles/landing-page-1-tokens.css';

import Hero from '../../components/landing-page-1/Hero.astro';
import NavBar from '../../components/landing-page-1/NavBar.astro';
import ProgramsCollage from '../../components/landing-page-1/ProgramsCollage.astro';
import CommunityBand from '../../components/landing-page-1/CommunityBand.astro';
import SponsorStrip from '../../components/landing-page-1/SponsorStrip.astro';
import MissionPrompt from '../../components/landing-page-1/MissionPrompt.astro';

import heroImg from '../../assets/landing-page-1/hero-rooftop.webp';
import sponsorMadrona from '../../assets/landing-page-1/sponsor-madrona.png';
import sponsorAllen from '../../assets/landing-page-1/sponsor-allen-school.png';
import sponsorA from '../../assets/landing-page-1/sponsor-a.png';
import sponsorFive from '../../assets/landing-page-1/sponsor-five.png';

const sponsors = [
  { src: sponsorMadrona.src, alt: 'Madrona Venture Labs' },
  { src: sponsorAllen.src, alt: 'Paul G. Allen School of Computer Science & Engineering' },
  { src: undefined, alt: 'Pioneer Square Labs' },
  { src: sponsorA.src, alt: 'Partner' },
  { src: sponsorFive.src, alt: 'Pack Ventures' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>cseed — good people. curious ideas.</title>
    <meta name="description" content="cseed: a community for building, designing, or trying something new." />
  </head>
  <body>
    <div id="cseed-page" style="width:2083px;background:var(--surface-page);overflow:hidden;">
      <div id="top"></div>

      <div id="cseed-hero-wrap">
        <Hero imageSrc={heroImg.src} />
      </div>

      <div id="cseed-nav-wrap">
        <NavBar />
      </div>

      <div style="height:96px;"></div>
      <div id="about"></div>
      <div id="programs"></div>

      <ProgramsCollage />

      <div id="join"></div>
      <CommunityBand />

      <div id="sponsors" style="height:176px;"></div>
      <SponsorStrip logos={sponsors} />

      <div style="height:176px;"></div>
      <MissionPrompt />
      <div style="height:240px;"></div>
    </div>

    <script>
      const CANVAS_WIDTH = 2083;
      const root = document.documentElement;

      function currentZoom() {
        const z = parseFloat(getComputedStyle(root).getPropertyValue('--page-zoom'));
        return z > 0 ? z : 1;
      }

      function fitCanvas() {
        const w = window.innerWidth || root.clientWidth || CANVAS_WIDTH;
        root.style.setProperty('--page-zoom', String(Math.min(1, w / CANVAS_WIDTH) || 1));
      }

      function fitHero() {
        const h = window.innerHeight || root.clientHeight || 1293;
        const next = Math.round(h / currentZoom());
        root.style.setProperty('--hero-h', `${Number.isFinite(next) && next > 320 ? next : 1293}px`);
      }

      const navWrap = document.getElementById('cseed-nav-wrap');
      const heroWrap = document.getElementById('cseed-hero-wrap');

      function updateNavVisibility() {
        if (!navWrap || !heroWrap) return;
        const bottom = heroWrap.getBoundingClientRect().bottom;
        const shouldShow = bottom <= (window.innerHeight || 800) * 0.45;
        navWrap.classList.toggle('is-visible', shouldShow);
      }

      function settle() {
        fitCanvas();
        fitHero();
        updateNavVisibility();
      }

      settle();
      requestAnimationFrame(settle);
      window.addEventListener('load', settle);
      window.addEventListener('resize', settle);
      window.addEventListener('scroll', updateNavVisibility, { passive: true });
      if (window.ResizeObserver) new ResizeObserver(settle).observe(root);

      // smooth-scroll anchors, offset for the fixed nav
      document.querySelectorAll('[data-nav-link]').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.getAttribute('data-nav-target') || 'top';
          const el = document.getElementById(targetId);
          if (!el) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
          const navPx = 140 * currentZoom();
          const r = el.getBoundingClientRect();
          window.scrollTo({ top: Math.max(0, window.scrollY + r.top - navPx - 24), behavior: 'smooth' });
        });
      });

      // scroll-triggered reveal for [data-reveal], [data-rule-animate], [data-stroke]
      const revealTargets = document.querySelectorAll('[data-reveal], [data-rule-animate], [data-stroke]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.01 }
        );
        revealTargets.forEach((el) => io.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('is-revealed'));
      }
    </script>

    <style>
      #cseed-nav-wrap {
        position: fixed;
        top: 0;
        left: 0;
        width: 2083px;
        z-index: 10;
        transform: translateY(-100%);
        opacity: 0;
        transition: transform 620ms var(--ease-soft), opacity 420ms var(--ease-soft);
        pointer-events: none;
      }
      #cseed-nav-wrap.is-visible {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
      }
      html {
        zoom: var(--page-zoom, 1);
      }
    </style>
  </body>
</html>
