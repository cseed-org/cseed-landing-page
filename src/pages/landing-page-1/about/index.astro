---
import '../../../styles/landing-page-1-tokens.css';

import NavBar from '../../../components/landing-page-1/NavBar.astro';
import Footer from '../../../components/landing-page-1/Footer.astro';
import Rule from '../../../components/landing-page-1/Rule.astro';
import TextLink from '../../../components/landing-page-1/TextLink.astro';
import StatsRow from '../../../components/landing-page-1/about/StatsRow.astro';
import SectionHead from '../../../components/landing-page-1/about/SectionHead.astro';
import TeamSection from '../../../components/landing-page-1/about/TeamSection.astro';
import MembersWall from '../../../components/landing-page-1/about/MembersWall.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>about us — cseed</title>
    <meta name="description" content="The cseed team, our members, and what we're building." />
  </head>
  <body>
    <div id="cseed-page" style="width:2083px;background:var(--surface-page);overflow:hidden;">
      <div id="top"></div>

      <div id="cseed-nav-wrap">
        <NavBar page="about" />
      </div>

      <div style="height:330px;"></div>

      <div class="cseed-about__opener">
        <StatsRow direction="column" size={150} gap={80} />
        <div class="cseed-about__opener-copy">
          <div data-reveal style="transition-delay:150ms;">
            <h1 class="cseed-about__headline">build things<br />you imagine.</h1>
          </div>
          <div data-reveal style="transition-delay:300ms;margin-top:60px;">
            <h1 class="cseed-about__headline cseed-about__headline--italic">build things<br />that don't scale.</h1>
          </div>
          <div data-reveal style="transition-delay:450ms;margin-top:110px;">
            <TextLink href="/landing-page-1/" arrowLength={26} style="font:400 30px/1 var(--font-body);gap:14px;">join cseed</TextLink>
          </div>
        </div>
      </div>

      <div style="padding:0 100px;margin-top:280px;">
        <Rule width="100%" weight={0.5} animate />
      </div>

      <section style="padding:220px 100px 0;">
        <SectionHead eyebrow="the cseed team" title="meet the team" align="right" />
        <TeamSection />
      </section>

      <div style="padding:0 100px;margin-top:240px;">
        <Rule width="100%" weight={0.5} animate />
      </div>

      <section style="padding:220px 100px 0;">
        <SectionHead eyebrow="1,040 and counting" title="members" align="right" />
        <MembersWall />
      </section>

      <div style="height:260px;"></div>

      <Footer page="about" />
    </div>

    <script>
      const CANVAS_WIDTH = 2083;
      const root = document.documentElement;

      function currentZoom() {
        const z = parseFloat(getComputedStyle(root).getPropertyValue('--page-zoom'));
        return z > 0 ? z : 1;
      }

      function fitCanvas() {
        const w = window.innerWidth || root.clientWidth || CANVAS_WIDTH;
        root.style.setProperty('--page-zoom', String(Math.min(1, w / CANVAS_WIDTH) || 1));
      }

      fitCanvas();
      requestAnimationFrame(fitCanvas);
      window.addEventListener('load', fitCanvas);
      window.addEventListener('resize', fitCanvas);
      if (window.ResizeObserver) new ResizeObserver(fitCanvas).observe(root);

      // smooth-scroll in-page anchors; cross-page links are plain <a> tags
      // and fall through to normal navigation untouched.
      document.querySelectorAll('[data-nav-link]').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.getAttribute('data-nav-target') || 'top';
          const el = document.getElementById(targetId);
          if (!el) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
          const navPx = 140 * currentZoom();
          const r = el.getBoundingClientRect();
          window.scrollTo({ top: Math.max(0, window.scrollY + r.top - navPx - 24), behavior: 'smooth' });
        });
      });

      // scroll-triggered reveal for [data-reveal], [data-rule-animate], [data-stroke]
      const revealTargets = document.querySelectorAll('[data-reveal], [data-rule-animate], [data-stroke]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.01 }
        );
        revealTargets.forEach((el) => io.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('is-revealed'));
      }
    </script>

    <style>
      #cseed-nav-wrap {
        position: fixed;
        top: 0;
        left: 0;
        width: 2083px;
        z-index: 10;
      }
      .cseed-about__opener {
        padding: 0 100px;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        column-gap: 160px;
        align-items: start;
      }
      .cseed-about__opener-copy {
        text-align: right;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        padding-top: 20px;
      }
      .cseed-about__headline {
        font: 400 150px/0.95 var(--font-display);
        letter-spacing: -0.045em;
        color: var(--cseed-ink);
        margin: 0;
      }
      .cseed-about__headline--italic {
        font-style: italic;
      }
      html {
        zoom: var(--page-zoom, 1);
      }
    </style>
  </body>
</html>
