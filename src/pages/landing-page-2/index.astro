---
import '../../styles/landing-page-2-tokens.css';

import NavBar from '../../components/landing-page-2/NavBar.astro';
import Hero from '../../components/landing-page-2/Hero.astro';
import AboutSection from '../../components/landing-page-2/AboutSection.astro';
import ProgramsSection from '../../components/landing-page-2/ProgramsSection.astro';
import SponsorsSection from '../../components/landing-page-2/SponsorsSection.astro';
import SiteFooter from '../../components/landing-page-2/SiteFooter.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>cseed — find your way to build</title>
    <meta name="description" content="cseed: a place where people of every experience level come to ship something. buildspace, buildher, and saturdays." />
  </head>
  <body>
    <div id="top"></div>
    <NavBar />
    <Hero />
    <AboutSection />
    <ProgramsSection />
    <SponsorsSection />
    <SiteFooter />

    <script>
      // Smooth-scroll for in-page nav links, offset for the sticky-less nav.
      document.querySelectorAll<HTMLElement>('[data-nav-link]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const targetId = link.getAttribute('data-nav-target') || 'top';
          const el = document.getElementById(targetId);
          if (!el) return;
          e.preventDefault();
          const top = el === document.getElementById('top') ? 0 : window.scrollY + el.getBoundingClientRect().top - 40;
          window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
        });
      });

      // Scroll-triggered reveal for simple fade/rise elements and edge-draw lines.
      const revealTargets = document.querySelectorAll<HTMLElement>(
        '[data-reveal], [data-reveal-edge], [data-reveal-mark], [data-reveal-words]'
      );
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.2 }
        );
        revealTargets.forEach((el) => io.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('is-revealed'));
      }

      // Program marks counter-rotate gently with scroll position once revealed.
      const spinTargets = document.querySelectorAll<HTMLElement>('[data-mark-spin]');
      const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (spinTargets.length && !reduceMotion) {
        let raf = 0;
        const onScroll = () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            spinTargets.forEach((el) => {
              const r = el.getBoundingClientRect();
              const p = Math.max(-1, Math.min(1, (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight));
              el.style.setProperty('--spin', `${(p * -8).toFixed(2)}deg`);
            });
          });
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
