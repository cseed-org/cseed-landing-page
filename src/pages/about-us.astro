---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import { TEAM } from '../data/community';
import { loadMemberNames } from '../data/member-names.mjs';
const memberNames = await loadMemberNames({
  url: import.meta.env.MEMBER_NAMES_EXPORT_URL,
  token: import.meta.env.MEMBER_NAMES_EXPORT_TOKEN,
  development: import.meta.env.DEV,
});
const ABOUT_STATS = [
  { value: memberNames.length.toLocaleString('en-US'), label: 'members' },
  { value: '300+', label: 'projects' },
  { value: 'unlimited', label: 'potential' },
];
---

<PageLayout title="cseed | about us" compactFooter responsive>
  <div class="ab-shrink">
    <div class="ab-top-space"></div>

    <div class="ab-opener">
      <div class="ab-stats">
        {
          ABOUT_STATS.map((s, i) => (
            <Reveal delay={i * 120}>
              <div class="ab-stat">
                <div class="ab-stat-value">{s.value}</div>
                <div class="ab-stat-bar" />
                <div class="t-eyebrow">{s.label}</div>
              </div>
            </Reveal>
          ))
        }
      </div>
      <div class="ab-opener-copy">
        <Reveal delay={150}>
          <div class="t-eyebrow">our vision</div>
          <h1 class="t-serif ab-vision">
            Inspire engineers, designers, and creators to turn what they care about into reality.
          </h1>
        </Reveal>
        <Reveal delay={300}>
          <div class="ab-execution">
            <div class="t-eyebrow">how we make it happen</div>
            <p>
              By creating the warmest, most welcoming community of builders at the University of
              Washington and across Seattle.
            </p>
          </div>
        </Reveal>
      </div>
    </div>

    <div class="ab-divider">
      <div class="ab-slogans" aria-label="Build things you imagine. Build things that don't scale.">
        <span aria-hidden="true">build things you imagine.</span>
        <span aria-hidden="true">build things that don't scale.</span>
      </div>
    </div>

    <section class="ab-team">
      <div class="ab-section-head">
        <Reveal><div class="t-eyebrow">the cseed team</div></Reveal>
        <Reveal delay={120}><h2 class="t-serif">meet the team</h2></Reveal>
      </div>
      <div class="ab-wall">
        {
          TEAM.map(({ name, photo }, i) => (
            <Reveal mode="fade" delay={(i % 5) * 80}>
              <div class="ab-person">
                <div class="team-photo">
                  <div class="team-photo-slot">
                    <img
                      src={photo}
                      alt={name}
                      width="720"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
                <div class="ab-person-name">{name}</div>
              </div>
            </Reveal>
          ))
        }
      </div>
    </section>

    <div style="height:260px"></div>
  </div>
</PageLayout>

<style>
  /* The page renders at 85%, matching the landing page. */
  .ab-shrink {
    zoom: 0.85;
    width: var(--canvas-width);
    margin-inline: auto;
  }
  .ab-top-space {
    height: 230px;
  }
  .ab-opener {
    padding: 0 100px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 130px;
    align-items: start;
  }
  .ab-stats {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }
  .ab-stat {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .ab-stat-value {
    font: 400 150px/0.9 var(--font-display);
    letter-spacing: -0.045em;
  }
  .ab-stat-bar {
    height: 3px;
    width: 100%;
    background: var(--cseed-ink);
  }
  .ab-opener-copy {
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 0;
  }
  .ab-vision {
    font-size: 100px;
    line-height: 1.05;
    margin-top: 30px;
    text-wrap: balance;
  }
  .ab-execution {
    margin-top: 44px;
    max-width: 880px;
  }
  .ab-execution p {
    font: 400 34px/1.45 var(--font-body);
    margin: 24px 0 0;
  }
  .ab-divider {
    position: relative;
    margin: 100px 100px 0;
    padding: 16px 0;
    border-block: 1px solid var(--cseed-ink);
  }
  .ab-slogans {
    display: grid;
    overflow: hidden;
    font: italic 400 60px/1.2 var(--font-display);
    text-align: center;
  }
  .ab-slogans span {
    grid-area: 1 / 1;
    animation: slogan-rotate 10s infinite;
  }
  .ab-slogans span + span {
    animation-delay: -5s;
  }
  @keyframes slogan-rotate {
    0%,
    40% {
      opacity: 1;
      transform: translateY(0);
    }
    48% {
      opacity: 0;
      transform: translateY(-100%);
    }
    49%,
    90% {
      opacity: 0;
      transform: translateY(100%);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ab-slogans span {
      animation: none;
      grid-area: auto;
    }
  }
  .ab-team {
    padding: 120px 100px 0;
  }
  .ab-section-head {
    display: flex;
    flex-direction: column;
    gap: 34px;
    align-items: flex-end;
    margin-bottom: 80px;
  }
  .ab-wall {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: 40px;
    row-gap: 70px;
  }
  .ab-person {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ab-person-name {
    font: 400 26px/1.2 var(--font-body);
    color: var(--cseed-ink);
  }

  .team-photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    z-index: 1;
  }

  .team-photo-slot {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cseed-mist);
  }
  .team-photo-slot img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  /* ---------- Mobile canvas (780px, phones and small tablets) ---------- */
  @media (max-width: 900px) {
    .ab-shrink {
      zoom: 1;
      width: auto;
    }
    .ab-top-space {
      height: 170px;
    }
    .ab-opener {
      padding: 0 40px;
      display: flex;
      flex-direction: column;
      gap: 72px;
    }
    .ab-opener-copy {
      order: -1;
      text-align: left;
      align-items: flex-start;
      padding-top: 0;
    }
    .ab-opener-copy h1 {
      font-size: 76px;
    }

    .ab-stats {
      align-self: stretch;
      gap: 64px;
    }
    .ab-stat-value {
      font-size: 120px;
    }
    .ab-divider {
      margin: 80px 40px 0;
      padding-block: 14px;
    }
    .ab-slogans {
      font-size: 40px;
    }
    .ab-execution p {
      font-size: 32px;
    }
    .ab-team {
      padding: 90px 40px 0;
    }
    .ab-section-head {
      align-items: flex-start;
      margin-bottom: 80px;
    }
    /* One column of names, each row a small headshot beside the name. */
    .ab-wall {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 28px;
    }
    .ab-person {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
    .team-photo {
      flex: none;
      width: 160px;
    }
    .ab-person-name {
      font-size: 34px;
    }
  }
</style>
