---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import NavBar from '../components/navigation/NavBar.astro';
import ProgramsCollage from '../components/landing/ProgramsCollage.astro';
import CommunityBand from '../components/landing/CommunityBand.astro';
import SponsorStrip from '../components/sections/SponsorStrip.astro';
import MissionPrompt from '../components/sections/MissionPrompt.astro';
import Footer from '../components/landing/Footer.astro';

const sponsors = ['Madrona Venture Labs', 'Allen School', 'Pioneer Square Labs', 'Partner', 'Pack Ventures'];
---

<BaseLayout>
  <div class="canvas-frame">
    <div class="canvas" id="top">
      <Hero />
      <div class="navbar-wrap" data-navbar-wrap>
        <NavBar />
      </div>
      <div style="height:96px"></div>
      <div id="about"></div>
      <ProgramsCollage />
      <CommunityBand />
      <div id="sponsors" style="height:176px"></div>
      <SponsorStrip names={sponsors} />
      <div style="height:176px"></div>
      <MissionPrompt />
      <div style="height:240px"></div>
      <Footer />
    </div>
  </div>
</BaseLayout>

<style>
  .canvas-frame {
    width: 100%;
    overflow-x: hidden;
  }
  .canvas {
    width: 2083px;
    background: var(--surface-page);
  }
  .navbar-wrap {
    position: fixed;
    top: 0;
    left: 0;
    width: 2083px;
    z-index: 10;
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 620ms var(--ease-soft),
      opacity 420ms var(--ease-soft);
  }
  .navbar-wrap.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
</style>
