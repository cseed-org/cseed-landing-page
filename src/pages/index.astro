---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import NavBar from '../components/navigation/NavBar.astro';
import ProgramsCollage from '../components/landing/ProgramsCollage.astro';
import CommunityBand from '../components/landing/CommunityBand.astro';
import SponsorStrip from '../components/sections/SponsorStrip.astro';
import MissionPrompt from '../components/sections/MissionPrompt.astro';
import Footer from '../components/landing/Footer.astro';

const sponsors = [
  { src: '/images/sponsors/allen-school.png', alt: 'Paul G. Allen School of Computer Science & Engineering' },
  { src: '/images/sponsors/pioneer-square-labs.png', alt: 'Pioneer Square Labs' },
  { src: '/images/sponsors/a.png', alt: 'Partner' },
  { src: '/images/sponsors/five.png', alt: 'Pack Ventures' },
];
---

<BaseLayout responsive>
  <div class="canvas-frame">
    <div class="canvas" id="top">
      <Hero />
      <div class="navbar-wrap" data-navbar-wrap>
        <NavBar />
      </div>
      <div style="height:82px"></div>
      <div id="about"></div>
      <div class="shrink">
        <ProgramsCollage />
        <CommunityBand />
      </div>
      <div id="sponsors" style="height:150px"></div>
      <div class="shrink-bleed sponsor-band">
        <SponsorStrip logos={sponsors} />
      </div>
      <div style="height:150px"></div>
      <div class="shrink">
        <MissionPrompt />
      </div>
      <div style="height:204px"></div>
      <div class="shrink-bleed">
        <Footer />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .canvas-frame {
    width: 100%;
    overflow-x: hidden;
  }
  .canvas {
    width: var(--canvas-width);
    background: var(--surface-page);
  }
  /* Everything below the hero renders at 85%. Content sections keep their
     2083px authored layout and sit centered; full-bleed bands widen by
     1/0.85 so they still span the canvas after zoom. */
  .shrink {
    zoom: 0.85;
    width: 2083px;
    margin-inline: auto;
  }
  .shrink-bleed {
    zoom: 0.85;
    width: calc(2083px / 0.85);
  }
  /* The sponsor band renders at half the size of the rest (0.85 * 0.5). */
  .shrink-bleed.sponsor-band {
    zoom: 0.425;
    width: calc(2083px / 0.425);
  }
  .navbar-wrap {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--canvas-width);
    z-index: 10;
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 620ms var(--ease-soft),
      opacity 420ms var(--ease-soft);
  }
  .navbar-wrap.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* Mobile canvas: sections are authored at their final size, so drop the shrinks. */
  @media (max-width: 900px), (hover: none) and (pointer: coarse) and (max-width: 1400px) {
    .shrink,
    .shrink-bleed,
    .shrink-bleed.sponsor-band {
      zoom: 1;
      width: auto;
    }
  }
</style>
