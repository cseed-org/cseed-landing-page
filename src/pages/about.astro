---
/** Static content page — served at /about/ */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
---

<BaseLayout title="About" description="Who CSEED is, what we run, and how to get involved.">
  <Hero
    eyebrow="About"
    title="Who we are"
    lede="A student-run group organising events that are actually worth showing up to."
  />

  <div class="wrap prose body">
    <p>
      <strong>This page is placeholder copy.</strong> Replace it with the real thing — it exists to show
      how a plain content page differs from the collection-driven event pages.
    </p>

    <h2>What we do</h2>
    <p>
      We run three kinds of things: low-commitment social events, hands-on workshops, and
      facilitated dialogues. Everything is free and open to any student.
    </p>

    <h2>How we work</h2>
    <ul>
      <li>Working groups plan their own events, with a shared budget.</li>
      <li>Anyone can propose an event; there is no membership requirement.</li>
      <li>We meet weekly during the quarter, and go quiet over breaks.</li>
    </ul>

    <h2>Getting involved</h2>
    <p>
      Come to any event and say hello, or use the <a href="/#contact">contact form</a> on the home page.
      There is no application.
    </p>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: var(--space-xl);
  }

  h2 {
    margin-top: var(--space-lg);
  }

  ul {
    padding-left: 1.3em;
  }
</style>
