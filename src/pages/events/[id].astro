---
/**
 * One page per event — /events/fall-kickoff-mixer/ and so on.
 *
 * The `[id]` in the filename is a dynamic segment. Because this is a static build,
 * Astro needs the full list of pages up front: that is what `getStaticPaths` returns.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatDate, formatTime, isoDate, SITE_TIME_ZONE } from '~/lib/datetime';

export const getStaticPaths = (async () => {
  const events = await getCollection(
    'event-graphics',
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}) satisfies GetStaticPaths;

const { event } = Astro.props;
const { title, date, location, summary, graphic, graphicAlt, tags, rsvpUrl, draft } = event.data;

// Renders the Markdown body below the frontmatter into a component.
const { Content } = await render(event);
---

<BaseLayout title={title} description={summary} noindex={draft}>
  <article>
    <div class="wrap head">
      <p class="crumb"><a href="/events/">&larr; All events</a></p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>

      <dl class="facts">
        <div>
          <dt>When</dt>
          <dd>
            <time datetime={isoDate(date)}>
              {formatDate(date)} at {formatTime(date)}
            </time>
            <span class="tz">({SITE_TIME_ZONE.split('/')[1].replace('_', ' ')} time)</span>
          </dd>
        </div>
        <div>
          <dt>Where</dt>
          <dd>{location}</dd>
        </div>
        {
          tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd>{tags.join(', ')}</dd>
            </div>
          )
        }
      </dl>

      {
        rsvpUrl && (
          <p>
            <a class="button button--primary" href={rsvpUrl} rel="noopener">
              RSVP
            </a>
          </p>
        )
      }
    </div>

    <div class="wrap">
      <Image
        class="banner"
        src={graphic}
        alt={graphicAlt}
        widths={[600, 1000, 1600]}
        sizes="(max-width: 70rem) 100vw, 70rem"
        loading="eager"
      />
    </div>

    <div class="wrap prose body">
      <!-- The Markdown body of the .md file lands here. -->
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-lg) var(--space-md);
    max-width: var(--measure);
  }

  .crumb {
    font-size: var(--step--1);
    margin-bottom: var(--space-md);
  }

  .crumb a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .crumb a:hover {
    color: var(--brand);
  }

  .lede {
    margin-top: var(--space-md);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-block: var(--space-lg);
    padding-block: var(--space-md);
    border-block: 1px solid var(--border);
  }

  dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  dd {
    margin: 0;
    font-weight: 550;
  }

  .tz {
    display: block;
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--text-muted);
  }

  .banner {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .body {
    padding-block: var(--space-lg);
  }

  /* `:global` is needed because <Content /> markup is generated at build time and
     does not carry this component's scoping attribute. */
  .body :global(h2) {
    margin-top: var(--space-lg);
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.3em;
  }

  .body :global(li + li) {
    margin-top: var(--space-xs);
  }
</style>
