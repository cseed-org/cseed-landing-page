  .jn-band {
    position: absolute;
    /* Bleeds past the 85% canvas to both edges of the window, like the members wall. */
    left: calc((2083px - 2083px / 0.85) / 2);
    right: calc((2083px - 2083px / 0.85) / 2);
    top: 230px;
    height: 470px;
    overflow: hidden;
    pointer-events: none;
  }
  .jn-band-track {
    display: flex;
    gap: 24px;
    width: max-content;
