---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Rule from '../components/core/Rule.astro';
import { marked } from 'marked';
import raw from '../data/code-of-conduct.md?raw';

// The doc's own top-level "# ..." heading becomes the page's <h1> above, so strip it here
// and render the rest of the markdown as the body.
const body = raw.replace(/^#[^\n]*\n/, '');
const html = marked.parse(body) as string;
---

<PageLayout
  title="member code of conduct — cseed"
  description="What cseed expects from every member."
  compactFooter
>
  <div class="coc-shrink" data-coc>
    <header class="coc-header">
      <Reveal><div class="t-eyebrow">cseed</div></Reveal>
      <Reveal delay={120}
        ><h1 class="t-serif" style="font-size:96px">member code of conduct</h1></Reveal
      >
    </header>
    <div style="padding:0 100px; margin-top:70px"><Rule width="100%" weight={0.5} animate /></div>
    <Reveal mode="fade">
      <article class="coc-body" set:html={html} />
    </Reveal>
    <div style="height:260px"></div>
  </div>
</PageLayout>

<style>
  /* The page renders at 85%, matching the other pages. */
  .coc-shrink {
    zoom: 0.85;
    width: 2083px;
    margin-inline: auto;
  }
  .coc-header {
    padding: 260px 100px 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .coc-body {
    max-width: 1200px;
    margin: 80px auto 0;
    padding: 0 100px;
    font: 300 24px/1.6 var(--font-body);
    color: var(--cseed-ink);
  }
  .coc-body :global(h2) {
    margin: 64px 0 20px;
    font: 400 42px/1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--cseed-ink);
  }
  .coc-body :global(h2:first-child) {
    margin-top: 0;
  }
  .coc-body :global(p) {
    margin: 0 0 24px;
  }
  .coc-body :global(em) {
    color: var(--cseed-ink-soft);
  }
  .coc-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--cseed-ink);
    opacity: 0.25;
    margin: 60px 0;
  }
  .coc-body :global(a) {
    color: var(--cseed-ink);
  }
  .coc-body :global(strong) {
    font-weight: 500;
  }
  .coc-body :global(h4) {
    margin: 40px 0 12px;
    font: 500 24px/1.3 var(--font-body);
  }
  /* The "if you ever feel unsafe" callout. */
  .coc-body :global(blockquote) {
    margin: 40px 0;
    padding: 28px 36px;
    background: var(--cseed-sun);
  }
  .coc-body :global(blockquote p) {
    margin: 0;
  }
  .coc-body :global(ul) {
    margin: 0 0 24px;
    padding-left: 1.2em;
  }
  .coc-body :global(li) {
    margin: 0 0 10px;
  }
  .coc-body :global(li > ul) {
    margin: 10px 0 0;
  }
  .coc-body :global(li > ul > li) {
    list-style: circle;
  }
</style>
