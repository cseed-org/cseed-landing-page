---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Rule from '../components/core/Rule.astro';
import { marked } from 'marked';
import raw from '../data/code-of-conduct.md?raw';

// The doc's own top-level "# ..." heading becomes the page's <h1> above, so strip it here
// and render the rest of the markdown as the body.
const body = raw.replace(/^#[^\n]*\n/, '');
const html = marked.parse(body) as string;
---

<PageLayout
  title="member code of conduct — cseed"
  description="What cseed expects from every member."
>
  <div data-coc>
    <header class="coc-header">
      <Reveal><div class="t-eyebrow">cseed</div></Reveal>
      <Reveal delay={120}
        ><h1 class="t-serif" style="font-size:120px">member code of conduct</h1></Reveal
      >
    </header>
    <div style="padding:0 100px; margin-top:70px"><Rule width="100%" weight={0.5} animate /></div>
    <Reveal mode="fade">
      <article class="coc-body" set:html={html} />
    </Reveal>
    <div style="height:260px"></div>
  </div>
</PageLayout>

<style>
  .coc-header {
    padding: 260px 100px 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .coc-body {
    max-width: 1400px;
    margin: 90px auto 0;
    padding: 0 100px;
    font: 300 30px/1.6 var(--font-body);
    color: var(--cseed-ink);
  }
  .coc-body :global(h2) {
    margin: 70px 0 24px;
    font: 400 56px/1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--cseed-ink);
  }
  .coc-body :global(h2:first-child) {
    margin-top: 0;
  }
  .coc-body :global(p) {
    margin: 0 0 30px;
  }
  .coc-body :global(em) {
    color: var(--cseed-ink-soft);
  }
  .coc-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--cseed-ink);
    opacity: 0.25;
    margin: 60px 0;
  }
  .coc-body :global(a) {
    color: var(--cseed-ink);
  }
</style>
