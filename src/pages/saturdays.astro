---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';

const faq: { q: string; a: string; link?: { label: string; href: string } }[] = [
  { q: 'do i need to sign up?', a: 'Nope. Just show up.' },
  { q: 'what should i bring?', a: 'A laptop and whatever you are working on.' },
  { q: 'do i need a project?', a: 'No. Come figure one out with us.' },
  { q: 'do i need to be a member?', a: "Yes! It's super easy:", link: { label: 'join here', href: '/join/' } },
];
const units = ['days', 'hours', 'min', 'sec'];
---

<PageLayout title="cseed | saturdays" responsive>
  <header class="sa-header">
    <div class="sa-header-left">
      <Reveal><div class="t-eyebrow">a weekly build sesh</div></Reveal>
      <Reveal delay={120}><h1 class="t-serif sa-title">saturdays</h1></Reveal>
    </div>
    <Reveal delay={240}>
      <p class="sa-body" style="margin-bottom:30px; white-space:pre-line">
        {'Bring what you are building.\nNo cohort, no pressure.'}
      </p>
    </Reveal>
  </header>

  <section class="sa-next" data-countdown>
    <Reveal><div class="t-eyebrow" data-countdown-label>join the next saturday</div></Reveal>
    <div class="sa-units">
      {
        units.map((k, i) => (
          <Reveal delay={i * 100}>
            <div class="sa-unit">
              <div class="sa-unit-value" data-unit={k}>
                00
              </div>
              <div class="sa-bar" />
              <div class="t-eyebrow">{k}</div>
            </div>
          </Reveal>
        ))
      }
    </div>
    <div class="sa-facts">
      <div class="sa-fact">
        <span class="t-eyebrow t-eyebrow-sm">when</span>
        <span class="sa-fact-value">saturday, october 17</span>
      </div>
      <div class="sa-fact">
        <span class="t-eyebrow t-eyebrow-sm">time</span>
        <span class="sa-fact-value">1:00pm</span>
      </div>
      <div class="sa-fact">
        <span class="t-eyebrow t-eyebrow-sm">where</span>
        <span class="sa-fact-value">@ tbd</span>
      </div>
    </div>
    <div class="sa-hand">just show up :)</div>
  </section>

  <section class="sa-faq">
    <Reveal><h2 class="t-serif" style="font-size:80px">quick q's</h2></Reveal>
    <div class="sa-faq-list">
      {
        faq.map(({ q, a, link }, i) => (
          <Reveal delay={i * 100}>
            <div class="sa-faq-row">
              <span class="sa-faq-q">{q}</span>
              <p class="sa-body">
                {a}
                {link && (
                  <>
                    {' '}
                    <a class="sa-highlight" href={link.href}>
                      {link.label}
                    </a>
                  </>
                )}
              </p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <div style="height:260px"></div>
</PageLayout>

<script>
  // Next session: October 17, 1:00pm Seattle time.
  const TARGET = new Date('2026-10-17T13:00:00-07:00').getTime();

  const root = document.querySelector('[data-countdown]');
  if (root) {
    const label = root.querySelector('[data-countdown-label]')!;
    const cells = Object.fromEntries(
      [...root.querySelectorAll<HTMLElement>('[data-unit]')].map((el) => [el.dataset.unit, el]),
    );
    const tick = () => {
      const diff = Math.max(0, TARGET - Date.now());
      const values: Record<string, number> = {
        days: Math.floor(diff / 864e5),
        hours: Math.floor(diff / 36e5) % 24,
        min: Math.floor(diff / 6e4) % 60,
        sec: Math.floor(diff / 1e3) % 60,
      };
      for (const [k, v] of Object.entries(values)) cells[k].textContent = String(v).padStart(2, '0');
      label.textContent = diff === 0 ? 'happening now' : 'join the next saturday';
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .sa-body {
    margin: 0;
    font: 300 32px/1.5 var(--font-body);
    color: var(--cseed-ink);
    text-wrap: pretty;
  }
  .sa-header {
    padding: 330px 100px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }
  .sa-header-left {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .sa-title {
    font-size: 240px;
  }
  .sa-next {
    position: relative;
    margin: 200px 100px 0;
    padding: 110px 100px 120px;
    background: var(--cseed-sun);
  }
  .sa-units {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
    margin-top: 70px;
  }
  .sa-unit {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .sa-unit-value {
    font: 400 260px/0.85 var(--font-display);
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .sa-bar {
    height: 3px;
    background: var(--cseed-ink);
  }
  .sa-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin-top: 130px;
  }
  .sa-fact {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .sa-fact-value {
    font: 400 56px/1.05 var(--font-display);
    letter-spacing: -0.03em;
  }
  .sa-hand {
    position: absolute;
    right: 100px;
    top: 100px;
    font: 400 38px/1 var(--font-hand);
    letter-spacing: 0.04em;
    transform: rotate(-5deg);
  }
  .sa-faq {
    padding: 240px 100px 0;
    display: grid;
    grid-template-columns: 520px minmax(0, 1fr);
    column-gap: 120px;
  }
  .sa-faq-list {
    display: flex;
    flex-direction: column;
  }
  .sa-faq-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
    padding: 44px 0;
    border-top: 1px solid var(--cseed-ink);
  }
  /* Same yellow marker as the nav's "join". */
  .sa-highlight {
    color: var(--cseed-ink);
    padding: 0 6px;
    margin: 0 -2px;
    background: linear-gradient(transparent 42%, var(--cseed-sun) 42%, var(--cseed-sun) 92%, transparent 92%);
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .sa-highlight:hover {
    color: var(--cseed-ink);
    opacity: 0.62;
  }
  .sa-faq-q {
    font: 400 40px/1.2 var(--font-display);
    letter-spacing: -0.02em;
  }

  /* ---------- Mobile canvas (780px, phones and small tablets) ---------- */
  @media (max-width: 900px) {
    .sa-header {
      padding: 190px 40px 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 36px;
    }
    .sa-next {
      margin: 110px 40px 0;
      padding: 70px 36px 80px;
    }
    /* Two by two: at full size "00" overflows a quarter of the column. */
    .sa-units {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 44px 28px;
      margin-top: 50px;
    }
    .sa-unit-value {
      font-size: 170px;
    }
    .sa-facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      margin-top: 80px;
    }
    .sa-fact-value {
      font-size: 46px;
    }
    /* Follows the facts instead of floating over the eyebrow. */
    .sa-hand {
      position: static;
      margin-top: 56px;
      text-align: right;
    }
    .sa-faq {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
      padding: 140px 40px 0;
    }
    .sa-faq-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding: 34px 0;
    }
  }
</style>
