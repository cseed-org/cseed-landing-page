---
import BaseLayout from './BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Footer from '../components/landing/Footer.astro';

/* Shell for every page except the landing page: the nav is fixed and always
   visible from the top (the landing page instead reveals it after the hero). */
interface Props {
  title: string;
  description?: string;
  /** Render the footer at 85%, like the landing page. */
  compactFooter?: boolean;
}
const { title, description, compactFooter = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="canvas-frame">
    <div class="canvas page-canvas" id="top">
      <div class="page-nav"><NavBar /></div>
      <slot />
      {
        compactFooter ? (
          <div class="footer-compact">
            <Footer />
          </div>
        ) : (
          <Footer />
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  /* Pages with a dark hero mark it data-nav-dark-hero; the nav goes transparent with
     white type until the hero has scrolled out from behind it. */
  const hero = document.querySelector<HTMLElement>('[data-nav-dark-hero]');
  const nav = document.querySelector<HTMLElement>('.page-nav');
  if (hero && nav) {
    const update = () => {
      const navBottom = nav.getBoundingClientRect().bottom;
      nav.classList.toggle('is-on-dark', hero.getBoundingClientRect().bottom > navBottom);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>

<style>
  .canvas-frame {
    width: 100%;
    overflow-x: hidden;
  }
  .page-canvas {
    width: 2083px;
    background: var(--surface-page);
    overflow: hidden;
  }
  .footer-compact {
    zoom: 0.85;
    width: calc(2083px / 0.85);
  }
  .page-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 2083px;
    z-index: 10;
  }
</style>
