---
import '../styles/global.css';
import SEO from '../components/core/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  /** Scale to fill any screen width, with a stacked mobile canvas on narrow screens. */
  responsive?: boolean;
}

const {
  responsive = false,
  title = 'cseed — good people. curious ideas.',
  description = 'cseed runs community programs for people who want to build something: buildspace, buildher, and saturdays.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-responsive={responsive ? true : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <SEO title={title} description={description} />
    <noscript>
      <style is:global>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
        [data-navbar-wrap] { opacity: 1 !important; transform: none !important; pointer-events: auto !important; }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
    <script>
      const CANVAS_WIDTH = 2083;
      const NAV_HEIGHT = 100;

      function zoom(): number {
        const z = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--page-zoom'));
        return z > 0 ? z : 1;
      }

      const RESPONSIVE = document.documentElement.hasAttribute('data-responsive');

      /* The canvas width in play: 2083px, or the 780px mobile canvas that
         responsive pages switch to on narrow screens (see tokens/layout.css). */
      function canvasWidth(): number {
        const v = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--canvas-width'));
        return v > 0 ? v : CANVAS_WIDTH;
      }

      /* The whole page is authored on a fixed-width canvas and scaled as one unit.
         Responsive pages scale to exactly fill the screen, up as well as down; the
         rest only ever scale down, as before. */
      function fit() {
        const w = window.innerWidth || document.documentElement.clientWidth || CANVAS_WIDTH;
        const z = RESPONSIVE ? w / canvasWidth() : Math.min(1, w / CANVAS_WIDTH);
        document.documentElement.style.setProperty('--page-zoom', String(z || 1));
      }

      function fitHero() {
        const hero = document.querySelector<HTMLElement>('[data-hero]');
        if (!hero) return;
        const h = window.innerHeight || document.documentElement.clientHeight || 1293;
        const next = Math.round(h / zoom());
        hero.style.height = (Number.isFinite(next) && next > 320 ? next : 1293) + 'px';
      }

      function initNavVisibility() {
        const hero = document.querySelector<HTMLElement>('[data-hero]');
        const nav = document.querySelector<HTMLElement>('[data-navbar-wrap]');
        if (!hero || !nav) return;
        const onScroll = () => {
          const heroPx = hero.offsetHeight * zoom();
          nav.classList.toggle('is-visible', window.scrollY >= heroPx * 0.55);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
      }

      /* Mirrors the source Reveal: IntersectionObserver plus a plain position
         check on scroll, so zero-size or absolutely placed wrappers still fire. */
      function initReveal() {
        const pending = new Set<Element>(document.querySelectorAll('[data-reveal], [data-draw], [data-rule-animate]'));
        const show = (el: Element) => {
          el.classList.add('is-shown');
          pending.delete(el);
        };
        const check = () => {
          const vh = window.innerHeight || document.documentElement.clientHeight || 0;
          pending.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < vh * 0.94 && r.bottom > -vh) show(el);
          });
        };
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) =>
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  show(e.target);
                  io.unobserve(e.target);
                }
              }),
            { rootMargin: '0px 0px -6% 0px', threshold: 0.01 },
          );
          pending.forEach((el) => io.observe(el));
        }
        check();
        requestAnimationFrame(check);
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check);
      }

      function scrollToEl(el: Element, behavior: ScrollBehavior) {
        const r = el.getBoundingClientRect();
        window.scrollTo({ top: Math.max(0, window.scrollY + r.top - NAV_HEIGHT * zoom() - 24), behavior });
      }

      function initAnchorScroll() {
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement)?.closest?.('a') as HTMLAnchorElement | null;
          if (!a || !a.hash || a.pathname !== location.pathname || a.origin !== location.origin) return;
          const el = document.getElementById(a.hash.slice(1));
          if (!el) return;
          e.preventDefault();
          history.replaceState(null, '', a.hash);
          scrollToEl(el, 'smooth');
        });
        window.addEventListener('load', () => {
          if (!location.hash) return;
          const el = document.getElementById(location.hash.slice(1));
          if (el) scrollToEl(el, 'auto');
        });
      }

      function settle() {
        fit();
        fitHero();
      }

      settle();
      requestAnimationFrame(settle);
      window.addEventListener('load', settle);
      window.addEventListener('resize', settle);
      if (window.ResizeObserver) new ResizeObserver(settle).observe(document.documentElement);

      initNavVisibility();
      initReveal();
      initAnchorScroll();
    </script>
  </body>
</html>

<style is:global>
  html {
    background: var(--surface-page);
  }
  body {
    margin: 0;
    background: var(--surface-page);
  }
  .canvas {
    zoom: var(--page-zoom, 1);
  }
</style>
