---
import '../styles/global.css';
import SEO from '../components/core/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  /** Scale to fill any screen width, with a stacked mobile canvas on narrow screens. */
  responsive?: boolean;
}

const {
  responsive = false,
  title = 'cseed',
  description = 'cseed runs community programs for people who want to build something: buildspace, buildher, and saturdays.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-responsive={responsive ? true : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The site has no dark theme; stop browsers (Samsung Internet, Chrome) recoloring it. -->
    <meta name="color-scheme" content="only light" />
    <script is:inline>
      /* The whole page is authored on a fixed-width canvas and scaled as one unit.
         This runs inline in the head so the scale is set before the first paint;
         set any later, phones briefly (or on slow connections, for seconds) paint the
         unscaled canvas, zoomed in and cut off. Responsive pages scale to exactly fill
         the screen, up as well as down; the rest only ever scale down. */
      (function () {
        var root = document.documentElement;
        var responsive = root.hasAttribute('data-responsive');
        // The mobile canvas query, kept identical to the one in styles/tokens/layout.css.
        var mobile = window.matchMedia(
          '(max-width: 900px), (hover: none) and (pointer: coarse) and (max-width: 1400px)',
        );
        function fit() {
          // clientWidth, not innerWidth: it leaves out the scrollbar and holds still while
          // the page is pinch-zoomed.
          var w = root.clientWidth || window.innerWidth || 2083;
          var canvas = responsive && mobile.matches ? 780 : 2083;
          var z = responsive ? w / canvas : Math.min(1, w / canvas);
          root.style.setProperty('--page-zoom', String(z || 1));
        }
        fit();
        window.addEventListener('resize', fit);
        window.addEventListener('load', fit);
        if (window.ResizeObserver) new ResizeObserver(fit).observe(root);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Poppins is used at weight 275 in the source design; it has no 275 master, so
         ExtraLight (200) is the shipped weight. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,200;0,300;0,400;1,200&family=Ubuntu:wght@400;500;700&family=Anonymous+Pro:ital,wght@0,400;0,700;1,400&family=Shadows+Into+Light+Two&display=swap"
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <SEO title={title} description={description} />
    <noscript>
      <style is:global>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
        [data-navbar-wrap] { opacity: 1 !important; transform: none !important; pointer-events: auto !important; }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
    <script>
      const CANVAS_WIDTH = 2083;
      const NAV_HEIGHT = 100;

      function zoom(): number {
        const z = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--page-zoom'));
        return z > 0 ? z : 1;
      }

      /* On touch screens the browser toolbar shows and hides while scrolling, which
         changes innerHeight; refitting then makes the page jump. So there the hero
         only refits when the width or scale changes (a rotation). clientWidth, unlike
         innerWidth, doesn't change while the page is pinch-zoomed. */
      const COARSE = window.matchMedia('(pointer: coarse)').matches;
      let heroFit = '';

      function fitHero() {
        const hero = document.querySelector<HTMLElement>('[data-hero]');
        if (!hero) return;
        const w = document.documentElement.clientWidth;
        const z = zoom();
        if (COARSE && `${w}@${z}` === heroFit) return;
        const h = window.innerHeight || document.documentElement.clientHeight || 1293;
        if (window.innerHeight) heroFit = `${w}@${z}`;
        const next = Math.round(h / z);
        /* The mobile canvas keeps room for the wordmark above the wrapped headline,
           so landscape phones don't push the headline up under it. The canvas in play
           follows from the head script's scale, so the two can never disagree. */
        const min = w / z < CANVAS_WIDTH - 1 ? 760 : 320;
        hero.style.height = (Number.isFinite(next) && next > 320 ? Math.max(next, min) : 1293) + 'px';
      }

      function initNavVisibility() {
        const hero = document.querySelector<HTMLElement>('[data-hero]');
        const nav = document.querySelector<HTMLElement>('[data-navbar-wrap]');
        if (!hero || !nav) return;
        const onScroll = () => {
          const vh = window.innerHeight || 800;
          nav.classList.toggle('is-visible', window.scrollY >= vh * 0.6);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
      }

      /* Mirrors the source Reveal: IntersectionObserver plus a plain position
         check on scroll, so zero-size or absolutely placed wrappers still fire. */
      function initReveal() {
        const pending = new Set<Element>(document.querySelectorAll('[data-reveal], [data-draw], [data-rule-animate]'));
        const show = (el: Element) => {
          el.classList.add('is-shown');
          pending.delete(el);
        };
        const check = () => {
          const vh = window.innerHeight || document.documentElement.clientHeight || 0;
          pending.forEach((el) => {
            const r = el.getBoundingClientRect();
            // Safari can coalesce scroll events across several screens. Reveal content
            // already passed as well, so a skipped viewport never leaves it hidden.
            if (r.top < vh * 0.94) show(el);
          });
        };
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) =>
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  show(e.target);
                  io.unobserve(e.target);
                }
              }),
            { rootMargin: '0px 0px -6% 0px', threshold: 0.01 },
          );
          pending.forEach((el) => io.observe(el));
        }
        check();
        requestAnimationFrame(check);
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check);
      }

      function scrollToEl(el: Element, behavior: ScrollBehavior) {
        const r = el.getBoundingClientRect();
        window.scrollTo({ top: Math.max(0, window.scrollY + r.top - NAV_HEIGHT * zoom() - 24), behavior });
      }

      function initAnchorScroll() {
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement)?.closest?.('a') as HTMLAnchorElement | null;
          if (!a || !a.hash || a.pathname !== location.pathname || a.origin !== location.origin) return;
          const el = document.getElementById(a.hash.slice(1));
          if (!el) return;
          e.preventDefault();
          history.replaceState(null, '', a.hash);
          scrollToEl(el, 'smooth');
        });
        window.addEventListener('load', () => {
          if (!location.hash) return;
          const el = document.getElementById(location.hash.slice(1));
          if (el) scrollToEl(el, 'auto');
        });
      }

      /* The head script refits the scale on the same events first; the hero follows. */
      fitHero();
      requestAnimationFrame(fitHero);
      window.addEventListener('load', fitHero);
      window.addEventListener('resize', fitHero);
      if (window.ResizeObserver) new ResizeObserver(fitHero).observe(document.documentElement);

      initNavVisibility();
      initReveal();
      initAnchorScroll();
    </script>
  </body>
</html>

<style is:global>
  html {
    background: var(--surface-page);
  }
  body {
    margin: 0;
    background: var(--surface-page);
  }
  .canvas {
    zoom: var(--page-zoom, 1);
  }
</style>
