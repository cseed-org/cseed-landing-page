---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'cseed — a community for the next generation of builders',
  description = 'CSEED is a student-run community that helps builders turn ideas into impact through people, resources, and real opportunities.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
