---
import Arrow from './Arrow.astro';

interface Props {
  href?: string;
  variant?: 'default' | 'mono';
  arrow?: boolean;
  arrowLength?: number;
  color?: string;
  style?: string;
  class?: string;
}

const {
  href = '#',
  variant = 'default',
  arrow = variant === 'default',
  arrowLength = 30.052,
  color,
  style = '',
  class: className,
} = Astro.props;
const mono = variant === 'mono';
const ink = color || (mono ? 'var(--link-on-photo)' : 'var(--link-ink)');
---

<a class:list={['text-link', className]} data-variant={variant} href={href} style={`color:${ink}; ${style}`}>
  <span class="text-link-label" style={`background-image:linear-gradient(${ink}, ${ink})`}>
    <slot />
  </span>
  {
    arrow && (
      <span class="text-link-arrow-wrap">
        <Arrow length={arrowLength} angle={-45} color={ink} />
      </span>
    )
  }
</a>

<style>
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    text-decoration: none;
    font: var(--type-body-default);
    letter-spacing: var(--tracking-body);
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .text-link[data-variant='mono'] {
    align-items: baseline;
    gap: 0;
    font: var(--type-mono-cta);
    letter-spacing: var(--tracking-mono);
  }
  .text-link:hover {
    opacity: 0.62;
    color: inherit;
  }
  .text-link-label {
    position: relative;
    padding-bottom: 6px;
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 100% 0.5px;
  }
  .text-link[data-variant='mono'] .text-link-label {
    padding-bottom: 14px;
    background-size: 100% 1.5px;
  }
  .text-link-arrow-wrap {
    display: inline-flex;
    flex: none;
    transform: translateY(-3px);
    transition: transform var(--dur-hover) var(--ease-soft);
  }
  .text-link:hover .text-link-arrow-wrap {
    transform: translateY(-3px) translate(6px, 0);
  }
</style>
