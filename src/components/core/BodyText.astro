---
interface Props {
  width?: number;
  leading?: number;
  align?: 'left' | 'center' | 'right';
  color?: string;
  as?: 'p' | 'div' | 'span';
  class?: string;
}

const { width = 703, leading = 61, align = 'left', color = 'var(--text-body)', as: Tag = 'p', class: className } =
  Astro.props;
---

<Tag class:list={['body-text', className]} style={`width:${width}px; text-align:${align}; color:${color}`}>
  <slot />
</Tag>

<style define:vars={{ leading: `${leading}px` }}>
  .body-text {
    margin: 0;
    font: var(--weight-body) var(--size-body) / var(--leading) var(--font-body);
    letter-spacing: var(--tracking-body);
    white-space: pre-line;
  }
</style>
