---
interface Props {
  size?: number;
  width?: number;
  align?: 'left' | 'center' | 'right';
  color?: string;
  as?: 'h2' | 'h3';
  class?: string;
}

const { size = 96, width = 740, align = 'center', color = 'var(--text-body)', as: Tag = 'h2', class: className } =
  Astro.props;
---

<Tag
  class:list={['section-heading', className]}
  style={`width:${width}px; font-size:${size}px; text-align:${align}; color:${color}`}
>
  <slot />
</Tag>

<style>
  .section-heading {
    margin: 0;
    height: 200px;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    line-height: 200px;
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }

  /* Mobile canvas (responsive pages only): wrap to the column instead of a fixed
     one-line box. */
  @media (max-width: 900px), (pointer: coarse) and (max-height: 500px) {
    :global(html[data-responsive]) .section-heading {
      width: auto !important;
      max-width: 100%;
      height: auto;
      font-size: 84px !important;
      line-height: 1;
      white-space: normal;
    }
  }
</style>
