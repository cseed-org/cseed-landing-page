---
interface Props {
  glyph?: string;
  size?: 'sm' | 'md' | 'lg';
  tone?: 'on-photo' | 'solid' | 'deep';
  label?: string;
  href?: string;
  class?: string;
}

const { glyph = '↗', size = 'md', tone = 'on-photo', label = 'open', href, class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['icon-btn', className]} data-size={size} data-tone={tone} href={href} aria-label={label}>
  <span aria-hidden="true">{glyph}</span>
</Tag>

<style>
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid transparent;
    backdrop-filter: blur(var(--blur-capsule));
    transition:
      transform var(--dur-hover) var(--ease-out-soft),
      background var(--dur-hover) var(--ease-out-soft);
  }
  .icon-btn[data-size='sm'] {
    width: 32px;
    height: 32px;
    min-width: 32px;
    font-size: 13px;
  }
  .icon-btn[data-size='md'] {
    width: 40px;
    height: 40px;
    min-width: 40px;
    font-size: 17px;
  }
  .icon-btn[data-size='lg'] {
    width: 48px;
    height: 48px;
    min-width: 48px;
    font-size: 20px;
  }

  .icon-btn[data-tone='on-photo'] {
    background: transparent;
    color: var(--text-on-photo);
    border-color: var(--border-on-photo);
  }
  .icon-btn[data-tone='on-photo']:hover {
    background: rgba(253, 252, 247, 0.2);
  }
  .icon-btn[data-tone='solid'] {
    background: var(--action-fill);
    color: var(--action-text);
  }
  .icon-btn[data-tone='deep'] {
    background: var(--green-800);
    color: var(--cream-100);
  }
  .icon-btn:hover {
    transform: translateY(-2px);
  }
</style>
