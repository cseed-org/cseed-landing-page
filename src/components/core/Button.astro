---
interface Props {
  variant?: 'primary' | 'solid' | 'ghost' | 'quiet';
  size?: 'sm' | 'md' | 'lg';
  arrow?: 'none' | 'right' | 'up-right';
  href?: string;
  class?: string;
}

const { variant = 'primary', size = 'md', arrow = 'none', href, class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
const glyph = arrow === 'up-right' ? '↗' : arrow === 'right' ? '→' : null;
---

<Tag class:list={['btn', className]} data-variant={variant} data-size={size} href={href}>
  <slot />
  {glyph && <span class="btn-arrow" aria-hidden="true">{glyph}</span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    border-radius: var(--radius-pill);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    border: 1px solid transparent;
    box-shadow: var(--shadow-soft);
    transition:
      transform var(--dur-tap) var(--ease-out-soft),
      background var(--dur-hover) var(--ease-out-soft),
      box-shadow var(--dur-hover) var(--ease-out-soft);
  }
  .btn[data-size='sm'] {
    padding: 9px 16px;
    font-size: 14px;
    line-height: 1;
  }
  .btn[data-size='md'] {
    padding: 13px 22px;
    font-size: 15px;
    line-height: 1;
  }
  .btn[data-size='lg'] {
    padding: 16px 28px;
    font-size: 17px;
    line-height: 1;
  }

  .btn[data-variant='primary'] {
    background: var(--action-fill);
    color: var(--action-text);
  }
  .btn[data-variant='primary']:hover {
    background: var(--action-fill-hover);
    box-shadow: var(--shadow-card);
    transform: translateY(var(--lift-hover));
  }

  .btn[data-variant='solid'] {
    background: var(--action-fill-solid);
    color: var(--action-text-solid);
  }
  .btn[data-variant='solid']:hover {
    background: var(--green-600);
    transform: translateY(var(--lift-hover));
  }

  .btn[data-variant='ghost'] {
    background: transparent;
    color: var(--text-on-photo);
    border-color: var(--action-ghost-border);
    box-shadow: none;
  }
  .btn[data-variant='ghost']:hover {
    background: rgba(253, 252, 247, 0.14);
    transform: translateY(var(--lift-hover));
  }

  .btn[data-variant='quiet'] {
    background: var(--capsule-fill-light);
    color: var(--action-text);
    border-color: var(--border-hairline);
  }
  .btn[data-variant='quiet']:hover {
    transform: translateY(var(--lift-hover));
  }

  .btn:active {
    transform: scale(var(--press-scale));
  }

  .btn-arrow {
    font-size: 1.05em;
    transition: transform var(--dur-hover) var(--ease-out-soft);
  }
  .btn:hover .btn-arrow {
    transform: translateX(2px);
  }
</style>
