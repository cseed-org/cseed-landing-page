---
const ARROWS: Record<string, string> = {
  'down-right': 'M4 6 C 26 10, 44 24, 58 44',
  'down-left': 'M58 6 C 36 10, 18 24, 6 44',
  'up-right': 'M4 46 C 26 40, 44 26, 58 6',
  right: 'M2 26 C 20 10, 42 10, 60 24',
};
const HEADS: Record<string, string> = {
  'down-right': 'M58 44 l -12 -3 M58 44 l 2 -12',
  'down-left': 'M6 44 l 12 -3 M6 44 l -2 -12',
  'up-right': 'M58 6 l -12 2 M58 6 l 1 12',
  right: 'M60 24 l -12 -3 M60 24 l -9 9',
};

interface Props {
  arrow?: 'none' | 'down-right' | 'down-left' | 'up-right' | 'right';
  tone?: 'cream' | 'deep';
  rotate?: number;
  align?: 'left' | 'right';
  class?: string;
}

const { arrow = 'none', tone = 'cream', rotate = -4, align = 'left', class: className } = Astro.props;
---

<div
  class:list={['annotation', className]}
  data-tone={tone}
  data-align={align}
  style={`--annotation-rotate:${rotate}deg`}
>
  <span class="annotation-text"><slot /></span>
  {
    arrow !== 'none' && (
      <svg class="annotation-arrow" width="62" height="50" viewBox="0 0 62 50" fill="none" aria-hidden="true">
        <path d={ARROWS[arrow]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <path d={HEADS[arrow]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    )
  }
</div>

<style>
  .annotation {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    transform: rotate(var(--annotation-rotate));
  }
  .annotation[data-align='left'] {
    align-items: flex-start;
  }
  .annotation[data-align='right'] {
    align-items: flex-end;
  }
  .annotation[data-tone='cream'] {
    color: var(--text-annotation);
  }
  .annotation[data-tone='deep'] {
    color: var(--text-annotation-on-light);
  }
  .annotation-text {
    font-family: var(--font-hand);
    font-weight: var(--weight-medium);
    font-size: var(--type-hand-size);
    line-height: var(--type-hand-leading);
    white-space: pre-line;
    text-align: inherit;
  }
  .annotation[data-align='right'] .annotation-text {
    text-align: right;
  }
  .annotation-arrow {
    opacity: 0.9;
  }
  .annotation[data-align='right'] .annotation-arrow {
    align-self: flex-end;
  }
</style>
