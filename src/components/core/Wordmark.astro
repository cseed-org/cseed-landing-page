---
interface Props {
  size?: number;
  color?: string;
  as?: 'span' | 'div';
  class?: string;
}

const { size = 60, color = 'var(--text-wordmark-page)', as: Tag = 'span', class: className } = Astro.props;
---

<Tag class:list={['wordmark', className]} style={`font-size:${size}px; color:${color}`}>cseed</Tag>

<style>
  .wordmark {
    display: inline-block;
    font-family: var(--font-wordmark);
    font-weight: var(--weight-wordmark);
    line-height: 200px;
    letter-spacing: var(--tracking-wordmark);
    white-space: nowrap;
  }
</style>
