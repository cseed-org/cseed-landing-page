---
/* Source node 1:61 "image 115" -- 347x99 sponsor lockup, contained, no crop. */
interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt = '', width = 347, height = 99, class: className } = Astro.props;
---

<div
  class:list={['sponsor-logo', className]}
  role="img"
  aria-label={alt}
  style={`width:${width}px; height:${height}px; background:url("${src}") center / contain no-repeat`}
>
</div>

<style>
  .sponsor-logo {
    flex: none;
  }
</style>
