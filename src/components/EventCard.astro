---
/**
 * One event, rendered as a linked card. Takes a whole collection entry rather
 * than a pile of loose props, so adding a field to the schema does not mean
 * threading it through every caller.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatTime, isoDate } from '~/lib/datetime';

interface Props {
  event: CollectionEntry<'event-graphics'>;
  /** Larger treatment for the featured slot on the home page. */
  featured?: boolean;
  /** `eager` for cards above the fold, `lazy` (default) for the rest. */
  loading?: 'eager' | 'lazy';
}

const { event, featured = false, loading = 'lazy' } = Astro.props;
const { title, date, location, summary, graphic, graphicAlt, tags, draft } = event.data;
const href = `/events/${event.id}/`;
---

<article class:list={['card', { 'card--featured': featured }]}>
  <div class="media">
    <Image
      src={graphic}
      alt={graphicAlt}
      widths={[400, 800, 1200]}
      sizes={featured ? '(max-width: 60rem) 100vw, 60rem' : '(max-width: 48rem) 100vw, 22rem'}
      loading={loading}
    />
    {draft && <span class="badge">Draft</span>}
  </div>

  <div class="body">
    <p class="when">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      {formatTime(date)}
    </p>

    <h3>
      {/* The whole card is clickable via the ::after overlay in the styles below. */}
      <a href={href}>{title}</a>
    </h3>

    <p class="where">{location}</p>
    <p class="summary">{summary}</p>

    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>#{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
  }

  /* Focus ring belongs to the card, not just the small link inside it. */
  .card:focus-within {
    outline: 3px solid var(--brand-bright);
    outline-offset: 2px;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--border);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    background: var(--accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border-radius: 999px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
  }

  .when {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--brand);
    display: flex;
    gap: 0.4em;
  }

  h3 {
    font-size: var(--step-1);
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the title link across the card so the whole thing is one hit target. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:focus-visible {
    outline: none;
  }

  .where {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .summary {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin-top: var(--space-xs);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .tags li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15em 0.6em;
  }

  /* Featured cards go side-by-side once there is room. */
  @media (min-width: 52rem) {
    .card--featured {
      flex-direction: row;
    }

    .card--featured .media {
      flex: 1 1 55%;
      aspect-ratio: auto;
    }

    .card--featured .body {
      flex: 1 1 45%;
      justify-content: center;
      padding: var(--space-lg);
    }
  }
</style>
