---
import TeamPolaroid from './TeamPolaroid.astro';

const TEAM = [
  {
    key: 'general',
    tag: 'the general team',
    members: [
      ['Maya Chen', 'president'],
      ['Jordan Reyes', 'vice president'],
      ['Priya Patel', 'operations'],
      ['Sam Okafor', 'events'],
      ['Lena Park', 'finance'],
      ['Theo Russo', 'outreach'],
    ],
  },
  {
    key: 'design',
    tag: 'design + media',
    members: [
      ['Ava Lindqvist', 'design lead'],
      ['Noah Kim', 'designer'],
      ['Isla Moreno', 'media lead'],
      ['Kai Tanaka', 'photographer'],
    ],
  },
  {
    key: 'buildspace',
    tag: 'buildspace',
    members: [
      ['Ethan Wright', 'lead'],
      ['Zara Ahmed', 'lead'],
      ['Leo Novak', 'mentor'],
      ['Mia Santos', 'mentor'],
      ['Omar Haddad', 'mentor'],
      ['Ruby Clarke', 'coordinator'],
    ],
  },
  {
    key: 'buildher',
    tag: 'buildher',
    members: [
      ['Nina Osei', 'lead'],
      ['Chloe Martin', 'lead'],
      ['Hana Suzuki', 'workshops'],
      ['Grace Liu', 'community'],
    ],
  },
];
---
<div class="cseed-team-tabs">
  <div class="cseed-team-tabs__bar">
    {TEAM.map((group, i) => (
      <button
        type="button"
        class="cseed-team-tabs__btn"
        data-tab-btn
        data-tab-index={i}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >{group.tag}</button>
    ))}
  </div>

  <div class="cseed-team-tabs__viewport">
    <div class="cseed-team-tabs__track" data-tab-track>
      {TEAM.map((group, i) => (
        <div class="cseed-team-tabs__panel" data-tab-panel data-tab-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <div class="cseed-team-tabs__row" style={`grid-template-columns:repeat(${group.members.length}, minmax(0,1fr));gap:${group.members.length <= 4 ? 90 : 40}px;padding:0 ${group.members.length <= 4 ? 60 : 0}px;`}>
            {group.members.map(([name, role], mi) => (
              <div data-reveal="fade" style={`transition-delay:${mi * 90}ms;`}>
                <TeamPolaroid name={name} role={role} w="auto" h={group.members.length <= 4 ? 460 : 330} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-tab-track]').forEach((track) => {
    const wrap = track.closest('.cseed-team-tabs');
    if (!wrap) return;
    const buttons = wrap.querySelectorAll('[data-tab-btn]');
    const panels = wrap.querySelectorAll('[data-tab-panel]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = btn.getAttribute('data-tab-index');
        track.style.setProperty('--active-tab', index);
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        panels.forEach((p) => p.setAttribute('aria-hidden', String(p.getAttribute('data-tab-index') !== index)));
      });
    });
  });
</script>

<style>
  .cseed-team-tabs__bar {
    display: flex;
    gap: 72px;
    border-bottom: 1px solid var(--cseed-ink);
  }
  .cseed-team-tabs__btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 0 0 22px;
    cursor: pointer;
    font: 400 52px/1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--cseed-ink);
    opacity: 0.4;
    box-shadow: none;
    transition: opacity 300ms var(--ease-soft);
  }
  .cseed-team-tabs__btn[aria-pressed='true'] {
    opacity: 1;
    box-shadow: inset 0 -4px 0 var(--cseed-ink);
  }
  .cseed-team-tabs__viewport {
    overflow: hidden;
    margin: 50px -100px 0;
    padding: 40px 0 60px;
  }
  .cseed-team-tabs__track {
    --active-tab: 0;
    display: flex;
    transform: translateX(calc(var(--active-tab) * -100%));
    transition: transform 900ms cubic-bezier(0.65, 0, 0.2, 1);
  }
  .cseed-team-tabs__panel {
    flex: 0 0 100%;
    box-sizing: border-box;
    padding: 0 100px;
    opacity: 0.25;
    transition: opacity 900ms var(--ease-soft);
  }
  .cseed-team-tabs__panel[aria-hidden='false'] {
    opacity: 1;
  }
  .cseed-team-tabs__row {
    display: grid;
    align-items: start;
  }
</style>
