---
interface Props {
  eyebrow: string;
  title: string;
  align?: 'left' | 'right';
}
const { eyebrow, title, align = 'left' } = Astro.props;
---
<div class="cseed-section-head" style={`align-items:${align === 'left' ? 'flex-start' : 'flex-end'};`}>
  <div data-reveal class="cseed-section-head__eyebrow">{eyebrow}</div>
  <div data-reveal style="transition-delay:120ms;">
    <h2 class="cseed-section-head__title">{title}</h2>
  </div>
</div>

<style>
  .cseed-section-head {
    display: flex;
    flex-direction: column;
    gap: 34px;
    margin-bottom: 130px;
  }
  .cseed-section-head__eyebrow {
    font: 400 18px/1 var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cseed-ink);
  }
  .cseed-section-head__title {
    font: 400 150px/0.95 var(--font-display);
    letter-spacing: -0.045em;
    color: var(--cseed-ink);
    margin: 0;
  }
</style>
