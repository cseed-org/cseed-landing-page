---
const STATS = [
  { value: '1000+', label: 'members' },
  { value: '300+', label: 'projects' },
  { value: 'unlimited', label: 'potential' },
];

interface Props {
  direction?: 'row' | 'column';
  size?: number;
  gap?: number;
  style?: string;
}
const { direction = 'row', size = 120, gap = 110, style = '' } = Astro.props;
---
<div class="cseed-stats-row" style={`flex-direction:${direction};gap:${gap}px;${style}`}>
  {STATS.map((stat, i) => (
    <div data-reveal style={`transition-delay:${i * 120}ms;`}>
      <div class="cseed-stats-row__item">
        <div class="cseed-stats-row__value" style={`font-size:${size}px;`}>{stat.value}</div>
        <div class="cseed-stats-row__rule"></div>
        <div class="cseed-stats-row__label">{stat.label}</div>
      </div>
    </div>
  ))}
</div>

<style>
  .cseed-stats-row {
    display: flex;
  }
  .cseed-stats-row__item {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .cseed-stats-row__value {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--cseed-ink);
  }
  .cseed-stats-row__rule {
    height: 3px;
    width: 100%;
    background: var(--cseed-ink);
  }
  .cseed-stats-row__label {
    font: 400 18px/1 var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cseed-ink);
  }
</style>
