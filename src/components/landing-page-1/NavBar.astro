---
import Wordmark from './Wordmark.astro';
import DropdownNav from './DropdownNav.astro';
import Rule from './Rule.astro';

interface Props {
  width?: number;
  height?: number;
  itemSize?: number;
  wordmarkSize?: number;
  page?: 'landing' | 'about';
  style?: string;
  class?: string;
}
const {
  width = 2085,
  height = 140,
  itemSize = 52,
  wordmarkSize = 46,
  page = 'landing',
  style = '',
  class: className,
} = Astro.props;

const ABOUT_PAGE_PATH = '/landing-page-1/about/';
const LANDING_PAGE_PATH = '/landing-page-1/';

const brand =
  page === 'landing' ? { target: 'top' } : { external: LANDING_PAGE_PATH };

// On the landing page every item scrolls in-page except "about us", which
// jumps to the standalone about page. On the about page it is the reverse:
// "about us" scrolls to its own top and everything else goes back to the
// landing page (without preserving which section — matches the source file).
const items =
  page === 'landing'
    ? [
        {
          label: 'programs',
          target: 'programs',
          dropdown: [
            { label: 'buildspace', target: 'programs' },
            { label: 'buildher', target: 'programs' },
            { label: 'saturdays', target: 'programs' },
          ],
        },
        { label: 'about us', external: ABOUT_PAGE_PATH },
        { label: 'sponsors', target: 'sponsors' },
        { label: 'join', target: 'join' },
      ]
    : [
        {
          label: 'programs',
          external: LANDING_PAGE_PATH,
          dropdown: [
            { label: 'buildspace', external: LANDING_PAGE_PATH },
            { label: 'buildher', external: LANDING_PAGE_PATH },
            { label: 'saturdays', external: LANDING_PAGE_PATH },
          ],
        },
        { label: 'about us', target: 'top' },
        { label: 'sponsors', external: LANDING_PAGE_PATH },
        { label: 'join', external: LANDING_PAGE_PATH },
      ];
---
<div class={`cseed-navbar ${className ?? ''}`} style={`position:relative;width:${width}px;height:${height}px;background:var(--surface-page);${style}`}>
  <div class="cseed-navbar__brand" style={`height:${height}px;`}>
    <a
      href={brand.external ?? `#${brand.target}`}
      {...(brand.target ? { 'data-nav-link': true, 'data-nav-target': brand.target } : {})}
      style="text-decoration:none;"
    >
      <Wordmark size={wordmarkSize} style={`line-height:${height}px;`} />
    </a>
  </div>

  <div class="cseed-navbar__items" style={`height:${height}px;`}>
    {items.map((item) => (
      <div class="cseed-navitem">
        <a
          href={item.external ?? `#${item.target}`}
          {...(item.target ? { 'data-nav-link': true, 'data-nav-target': item.target } : {})}
          class="cseed-navitem__link"
          style={`font:${'var(--weight-display)'} ${itemSize}px/1 var(--font-display);letter-spacing:var(--tracking-display);`}
        >{item.label}</a>
        {item.dropdown && (
          <div class="cseed-navitem__dropdown" style={`top:${height - 1}px;`}>
            <DropdownNav items={item.dropdown} />
          </div>
        )}
      </div>
    ))}
  </div>

  <Rule width={width} weight={1} style={`position:absolute;left:0;top:${height - 1}px;`} />
</div>

<style>
  .cseed-navbar__brand {
    position: absolute;
    left: 41px;
    top: 0;
    display: flex;
    align-items: center;
  }
  .cseed-navbar__items {
    position: absolute;
    right: 77px;
    top: 0;
    display: flex;
    align-items: center;
    gap: 44px;
  }
  .cseed-navitem {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .cseed-navitem__link {
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    opacity: 1;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .cseed-navbar__items:has(.cseed-navitem:hover) .cseed-navitem:not(:hover) .cseed-navitem__link {
    opacity: 0.45;
  }
  .cseed-navitem__dropdown {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) translateY(-12px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-hover) var(--ease-soft), transform var(--dur-hover) var(--ease-soft);
    z-index: 4;
  }
  .cseed-navitem:hover .cseed-navitem__dropdown,
  .cseed-navitem:focus-within .cseed-navitem__dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
</style>
