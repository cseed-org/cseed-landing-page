---
import Wordmark from './Wordmark.astro';
import DropdownNav from './DropdownNav.astro';
import Rule from './Rule.astro';

interface Props {
  width?: number;
  height?: number;
  itemSize?: number;
  wordmarkSize?: number;
  style?: string;
  class?: string;
}
const {
  width = 2085,
  height = 140,
  itemSize = 52,
  wordmarkSize = 46,
  style = '',
  class: className,
} = Astro.props;

const items = [
  { label: 'programs', target: 'programs', dropdown: true },
  { label: 'about us', target: 'about', dropdown: false },
  { label: 'sponsors', target: 'sponsors', dropdown: false },
  { label: 'join', target: 'join', dropdown: false },
];
---
<div class={`cseed-navbar ${className ?? ''}`} style={`position:relative;width:${width}px;height:${height}px;background:var(--surface-page);${style}`}>
  <div class="cseed-navbar__brand" style={`height:${height}px;`}>
    <a href="#top" data-nav-link data-nav-target="top" style="text-decoration:none;">
      <Wordmark size={wordmarkSize} style={`line-height:${height}px;`} />
    </a>
  </div>

  <div class="cseed-navbar__items" style={`height:${height}px;`}>
    {items.map((item) => (
      <div class="cseed-navitem">
        <a
          href={`#${item.target}`}
          data-nav-link
          data-nav-target={item.target}
          class="cseed-navitem__link"
          style={`font:${'var(--weight-display)'} ${itemSize}px/1 var(--font-display);letter-spacing:var(--tracking-display);`}
        >{item.label}</a>
        {item.dropdown && (
          <div class="cseed-navitem__dropdown" style={`top:${height - 1}px;`}>
            <DropdownNav />
          </div>
        )}
      </div>
    ))}
  </div>

  <Rule width={width} weight={1} style={`position:absolute;left:0;top:${height - 1}px;`} />
</div>

<style>
  .cseed-navbar__brand {
    position: absolute;
    left: 41px;
    top: 0;
    display: flex;
    align-items: center;
  }
  .cseed-navbar__items {
    position: absolute;
    right: 77px;
    top: 0;
    display: flex;
    align-items: center;
    gap: 44px;
  }
  .cseed-navitem {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .cseed-navitem__link {
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    opacity: 1;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .cseed-navbar__items:has(.cseed-navitem:hover) .cseed-navitem:not(:hover) .cseed-navitem__link {
    opacity: 0.45;
  }
  .cseed-navitem__dropdown {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) translateY(-12px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-hover) var(--ease-soft), transform var(--dur-hover) var(--ease-soft);
    z-index: 4;
  }
  .cseed-navitem:hover .cseed-navitem__dropdown,
  .cseed-navitem:focus-within .cseed-navitem__dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
</style>
