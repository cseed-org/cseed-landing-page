---
import SectionHeading from './SectionHeading.astro';
import TextLink from './TextLink.astro';

interface Props {
  heading?: string;
  linkLabel?: string;
  target?: string;
  width?: number;
  style?: string;
  class?: string;
}
const {
  heading = 'interested in our mission?',
  linkLabel = 'sponsor us',
  target = 'sponsors',
  width = 2083,
  style = '',
  class: className,
} = Astro.props;
---
<div class={className} style={`width:${width}px;display:flex;flex-direction:column;align-items:center;gap:26px;${style}`}>
  <div data-reveal>
    <SectionHeading width={981}>{heading}</SectionHeading>
  </div>
  <div data-reveal style="transition-delay:120ms;">
    <TextLink href={`#${target}`} arrowLength={36.235} data-nav-link data-nav-target={target}>{linkLabel}</TextLink>
  </div>
</div>
