---
interface Props {
  src?: string;
  w: number;
  h: number;
  rotate?: number;
  position?: string;
  size?: string;
  style?: string;
  class?: string;
}
const { src, w, h, rotate = 0, position = 'center', size = 'cover', style = '', class: className } = Astro.props;
---
<div
  class={`cseed-polaroid ${className ?? ''}`}
  style={`--rotate:${rotate};position:absolute;width:${w}px;height:${h}px;${style}`}
>
  <div class="cseed-polaroid__frame">
    <div
      class="cseed-polaroid__img"
      style={src
        ? `background-image:url("${src}");background-position:${position};background-size:${size};background-repeat:no-repeat;`
        : 'background:var(--surface-placeholder);'}
    ></div>
  </div>
</div>

<style>
  .cseed-polaroid {
    padding: 18px;
    box-sizing: content-box;
    background: var(--cseed-white);
    box-shadow: 0 14px 34px -16px rgba(40, 34, 20, 0.28), 0 2px 6px rgba(40, 34, 20, 0.06);
    transform: rotate(calc(var(--rotate) * 1deg));
    transition: transform 700ms var(--ease-soft), box-shadow 700ms var(--ease-soft);
  }
  .cseed-polaroid:hover {
    box-shadow: 0 30px 60px -20px rgba(40, 34, 20, 0.32), 0 4px 10px rgba(40, 34, 20, 0.08);
    transform: rotate(calc(var(--rotate) * 0.35deg)) translateY(-12px);
  }
  .cseed-polaroid__frame {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .cseed-polaroid__img {
    width: 100%;
    height: 100%;
    transition: transform 1200ms var(--ease-soft);
  }
  .cseed-polaroid:hover .cseed-polaroid__img {
    transform: scale(1.03);
  }
</style>
