---
interface Item { label: string; target: string }
interface Props {
  label?: string;
  items?: Item[];
  style?: string;
  class?: string;
}
const {
  label,
  items = [
    { label: 'buildspace', target: 'programs' },
    { label: 'buildher', target: 'programs' },
    { label: 'saturdays', target: 'programs' },
  ],
  style = '',
  class: className,
} = Astro.props;
---
<div class={`cseed-dropdown ${className ?? ''}`} style={`width:703px;padding-bottom:98px;${style}`}>
  <div class="cseed-dropdown__panel">
    {label && (
      <div class="cseed-dropdown__label" style="width:703px;text-align:center;font:var(--type-display-nav);letter-spacing:var(--tracking-display);color:var(--text-body);">
        {label}
      </div>
    )}
    <div style={`padding-top:${label ? 0 : 20}px;padding-bottom:20px;`}>
      {items.map((item) => (
        <a
          href={`#${item.target}`}
          data-nav-link
          data-nav-target={item.target}
          class="cseed-dropdown__item"
        >
          <span>{item.label}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .cseed-dropdown__panel {
    background: var(--cseed-white);
    box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.35), 0 4px 12px rgba(0, 0, 0, 0.08);
  }
  .cseed-dropdown__item {
    display: block;
    width: 703px;
    height: 72px;
    line-height: 72px;
    text-align: center;
    font: var(--weight-body) 28px/72px var(--font-body);
    letter-spacing: var(--tracking-body);
    color: var(--link-ink);
    text-decoration: none;
  }
  .cseed-dropdown__item span {
    display: inline-block;
    padding-bottom: 4px;
    background-image: linear-gradient(var(--rule-ink), var(--rule-ink));
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 0% 0.5px;
    transition: background-size var(--dur-hover) var(--ease-soft);
  }
  .cseed-dropdown__item:hover span {
    background-size: 100% 0.5px;
  }
</style>
