---
import TextLink from './TextLink.astro';

interface Props {
  n: string;
  eyebrow: string;
  name: string;
  blurb: string;
  link: string;
  style?: string;
}
const { n, eyebrow, name, blurb, link, style = '' } = Astro.props;
---
<div class="cseed-program-copy" style={`position:absolute;${style}`}>
  <div data-reveal><div class="cseed-program-copy__eyebrow">{n} / {eyebrow}</div></div>
  <div data-reveal style="transition-delay:120ms;"><h3 class="cseed-program-copy__name">{name}</h3></div>
  <div data-reveal style="transition-delay:240ms;"><p class="cseed-program-copy__blurb">{blurb}</p></div>
  <div data-reveal style="transition-delay:360ms;">
    <div style="margin-top:34px;">
      <TextLink href="#join" arrowLength={22} class="cseed-program-copy__link" data-nav-link data-nav-target="join">{link}</TextLink>
    </div>
  </div>
</div>

<style>
  .cseed-program-copy__eyebrow {
    font: 400 18px/1 var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cseed-ink);
  }
  .cseed-program-copy__name {
    font: 400 118px/0.95 var(--font-display);
    letter-spacing: -0.045em;
    color: var(--cseed-ink);
    margin: 26px 0 0;
  }
  .cseed-program-copy__blurb {
    font: 300 27px/1.5 var(--font-body);
    letter-spacing: 0;
    color: var(--cseed-ink);
    margin: 32px 0 0;
    width: 560px;
    white-space: pre-line;
  }
</style>
