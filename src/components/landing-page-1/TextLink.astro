---
import Arrow from './Arrow.astro';

interface Props {
  href?: string;
  variant?: 'default' | 'mono';
  arrow?: boolean;
  arrowLength?: number;
  color?: string;
  style?: string;
  class?: string;
}
const {
  href = '#',
  variant = 'default',
  arrow = variant === 'default',
  arrowLength = 30.052,
  color,
  style = '',
  class: className,
} = Astro.props;

const mono = variant === 'mono';
const ink = color || (mono ? 'var(--link-on-photo)' : 'var(--link-ink)');
---
<a
  href={href}
  class={`cseed-textlink ${mono ? 'is-mono' : ''} ${className ?? ''}`}
  style={`--tl-color:${ink};${style}`}
>
  <span class="cseed-textlink__label"><slot /></span>
  {arrow && (
    <span class="cseed-textlink__arrow">
      <Arrow length={arrowLength} angle={-45} color={ink} />
    </span>
  )}
</a>

<style>
  .cseed-textlink {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    text-decoration: none;
    color: var(--tl-color);
    font: var(--type-body-default);
    letter-spacing: var(--tracking-body);
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .cseed-textlink:hover {
    opacity: 0.62;
    color: var(--tl-color);
  }
  .cseed-textlink.is-mono {
    align-items: baseline;
    gap: 0;
    font: var(--type-mono-cta);
    letter-spacing: var(--tracking-mono);
  }
  .cseed-textlink__label {
    position: relative;
    padding-bottom: 6px;
    background-image: linear-gradient(var(--tl-color), var(--tl-color));
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 100% 0.5px;
  }
  .is-mono .cseed-textlink__label {
    padding-bottom: 14px;
    background-size: 100% 1.5px;
  }
  .cseed-textlink__arrow {
    flex: none;
    display: inline-flex;
    transform: translateY(-3px) rotate(-45deg) translate(0, 0);
    transition: transform var(--dur-hover) var(--ease-soft);
  }
  .cseed-textlink:hover .cseed-textlink__arrow {
    transform: translateY(-3px) rotate(-45deg) translate(6px, 0);
  }
</style>
