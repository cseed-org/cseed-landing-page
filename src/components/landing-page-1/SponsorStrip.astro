---
import SponsorLogo from './SponsorLogo.astro';

interface Logo { src: string; alt: string }
interface Props {
  logos: Logo[];
  width?: number;
  drift?: boolean;
  style?: string;
  class?: string;
}
const { logos, width = 2083, drift = true, style = '', class: className } = Astro.props;
const run = drift ? [...logos, ...logos] : logos;
---
<div class={className} style={`width:${width}px;height:289px;background:var(--surface-strip);overflow:hidden;display:flex;align-items:center;${style}`}>
  <div
    class="cseed-sponsor-strip__track"
    style={drift ? 'animation:cseed-marquee 72s linear infinite;' : ''}
  >
    {run.map((logo) => (
      <SponsorLogo src={logo.src} alt={logo.alt} />
    ))}
  </div>
</div>

<style>
  .cseed-sponsor-strip__track {
    display: flex;
    align-items: center;
    gap: 124px;
    padding-left: 14px;
    flex: none;
  }
</style>
