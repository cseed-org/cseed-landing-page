---
import SectionHeading from '../core/SectionHeading.astro';
import TextLink from '../core/TextLink.astro';

interface Props {
  heading?: string;
  linkLabel?: string;
  href?: string;
}
const {
  heading = 'interested in our mission?',
  linkLabel = 'sponsor us',
  href = 'mailto:partnerships@cseed.co',
} = Astro.props;
---

<div class="mission-prompt">
  <div data-reveal>
    <SectionHeading width={981}>{heading}</SectionHeading>
  </div>
  <div data-reveal style="transition-delay:120ms">
    <TextLink href={href} arrowLength={36.235} mail={href.startsWith('mailto:')}>{linkLabel}</TextLink>
  </div>
</div>

<style>
  .mission-prompt {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  @media (max-width: 900px) {
    :global(html[data-responsive]) .mission-prompt {
      padding: 0 40px;
      gap: 40px;
    }
  }
</style>
