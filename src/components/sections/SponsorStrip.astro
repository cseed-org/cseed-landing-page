---
import SponsorLogo from '../core/SponsorLogo.astro';

/* The light band -- 289px of --surface-strip carrying a single, centered row of
   347x99 partner lockups. Static rather than a marquee while the list is short. */
interface Props {
  logos: { src: string; alt: string }[];
}
const { logos } = Astro.props;
---

<div class="sponsor-strip">
  <div class="sponsor-strip-row">
    {logos.map((logo) => <SponsorLogo src={logo.src} alt={logo.alt} />)}
  </div>
</div>

<style>
  .sponsor-strip {
    width: 100%;
    height: 289px;
    background: var(--surface-strip);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sponsor-strip-row {
    display: flex;
    align-items: center;
    gap: 360px;
  }

  /* Mobile canvas (responsive pages only): logos wrap two to a row. */
  @media (max-width: 900px) {
    :global(html[data-responsive]) .sponsor-strip {
      height: auto;
      padding: 64px 40px;
    }
    :global(html[data-responsive]) .sponsor-strip-row {
      zoom: 0.6;
      max-width: 900px;
      flex-wrap: wrap;
      justify-content: center;
      gap: 80px;
    }
  }
</style>
