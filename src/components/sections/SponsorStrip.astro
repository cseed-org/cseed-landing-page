---
import SponsorLogo from '../core/SponsorLogo.astro';

/* The light band -- 289px of --surface-strip carrying a 124px-gap row of
   347x99 partner lockups, doubled so the marquee loops seamlessly. */
interface Props {
  logos: { src: string; alt: string }[];
}
const { logos } = Astro.props;
const run = [...logos, ...logos];
---

<div class="sponsor-strip">
  <div class="sponsor-strip-track">
    {run.map((logo) => <SponsorLogo src={logo.src} alt={logo.alt} />)}
  </div>
</div>

<style>
  .sponsor-strip {
    width: 100%;
    height: 289px;
    background: var(--surface-strip);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .sponsor-strip-track {
    display: flex;
    align-items: center;
    gap: 124px;
    padding-left: 14px;
    flex: none;
    animation: cseed-marquee 72s linear infinite;
  }
</style>
