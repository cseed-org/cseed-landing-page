---
import TextLink from '../core/TextLink.astro';

/*
 * Source node "hero" -- a photograph bled past the 2083px-wide canvas,
 * plant logo, display line in --cseed-sun, and a centred white
 * mono CTA. All other positions below are the literal pixel values
 * from the source design, authored against this fixed canvas -- the whole
 * page (see BaseLayout's script) is scaled as one unit via CSS `zoom`, so
 * mobile overrides use the narrower 780px canvas.
 *
 * Height is set client-side to fill the viewport (see `fitHero()` in
 * BaseLayout's script); 1293 is only the pre-JS default.
 */
interface Props {
  display?: string;
  cta?: string;
}
const { display = 'good people. curious ideas.', cta = 'scroll down' } = Astro.props;
---

<section class="hero" data-hero style="height:1293px">
  <div class="hero-photo" aria-hidden="true"></div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-wordmark">
    <img src="/images/cseed-logo-white.png" alt="cseed" width="266" height="60" />
  </div>
  <div class="hero-content">
    <h1 class="hero-display">{display}</h1>
    <a
      class="hero-events"
      href="https://luma.com/uwcseed"
      target="_blank"
      rel="noopener noreferrer"
    >
      Event Calendar <span aria-hidden="true">&#8599;</span>
    </a>
  </div>
  <div class="hero-cta" data-hero-cta>
    <TextLink variant="mono" href="#programs" style="font-size:32px">{cta}</TextLink>
  </div>
</section>

<script>
  /* Show "scroll down" only after 3s at the top of the page without scrolling. */
  const cta = document.querySelector<HTMLElement>('[data-hero-cta]');
  if (cta) {
    let timer = 0;
    const arm = () => {
      window.clearTimeout(timer);
      cta.classList.remove('is-visible');
      if (window.scrollY > 8) return;
      timer = window.setTimeout(() => {
        if (window.scrollY <= 8) cta.classList.add('is-visible');
      }, 3000);
    };
    arm();
    window.addEventListener('scroll', arm, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    width: var(--canvas-width);
    min-height: 640px;
    overflow: hidden;
    background: var(--surface-photo);
  }
  .hero-photo {
    position: absolute;
    left: -19px;
    top: -112px;
    width: 2417px;
    height: max(1603px, calc(100% + 280px));
    background: url('/images/hero.webp') center / cover no-repeat;
    animation:
      cseed-fade var(--dur-hero) var(--ease-soft) both,
      cseed-hero-drift 24000ms var(--ease-soft) both;
  }
  .hero-scrim {
    position: absolute;
    left: -58px;
    top: 28px;
    right: -315px;
    bottom: -168px;
    pointer-events: none;
    background: linear-gradient(rgba(20, 16, 10, 0) 28%, rgba(20, 16, 10, 0.52) 52%, rgba(20, 16, 10, 0.72) 100%);
  }
  .hero-wordmark {
    --logo-width: 266px;
    position: absolute;
    left: 0;
    right: 0;
    top: 60px;
    /* The letters occupy the first 471px of the 640px logo. Center that
       portion and let the plant extend to its right. */
    width: calc(var(--logo-width) * 471 / 640);
    margin-inline: auto;
    animation: cseed-fade-up var(--dur-hero) var(--ease-soft) 200ms both;
  }
  .hero-wordmark img {
    width: var(--logo-width);
    max-width: none;
    height: auto;
  }
  /* Keep the headline and calendar together as text wraps or grows. */
  .hero-content {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 214px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }
  .hero-display {
    margin: 0;
    width: 100%;
    line-height: 1.2;
    text-align: center;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-hero);
    color: var(--text-display-hero);
    white-space: nowrap;
    font-size: 130px;
    animation: cseed-hero-settle var(--dur-hero) var(--ease-soft) 420ms both;
  }
  .hero-events {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: max(76px, calc(44px / var(--page-zoom, 1)));
    padding: 18px 32px;
    border: 1.5px solid color-mix(in srgb, var(--cseed-sun) 65%, transparent);
    background: rgba(20, 16, 10, 0.18);
    color: var(--text-on-photo);
    font: 400 28px/1.2 var(--font-mono);
    text-decoration: none;
    transition:
      background var(--dur-hover) var(--ease-soft),
      border-color var(--dur-hover) var(--ease-soft);
  }
  .hero-events span {
    color: var(--cseed-sun);
  }
  .hero-events:hover {
    background: color-mix(in srgb, var(--cseed-sun) 12%, transparent);
    border-color: var(--cseed-sun);
  }
  .hero-events:focus-visible {
    outline: 3px solid var(--cseed-sun);
    outline-offset: 6px;
  }
  .hero-cta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 132px;
    text-align: center;
    /* Hidden until the visitor has sat on the hero for 3s without scrolling
       (see the script below), then it rises in and bobs gently. */
    opacity: 0;
    transform: translateY(28px);
    pointer-events: none;
    transition:
      opacity 800ms var(--ease-soft),
      transform 800ms var(--ease-soft);
  }
  .hero-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .hero-cta.is-visible :global(.text-link) {
    animation: hero-cta-bob 3000ms ease-in-out 900ms infinite;
  }
  @keyframes hero-cta-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }
  /* smaller CTA with a thin underline tucked close to "scroll down" */
  .hero-cta :global(.text-link) {
    line-height: 1;
  }
  .hero-cta :global(.text-link-label) {
    background-size: 100% 0.75px;
    line-height: 1;
    padding-bottom: 4px;
  }

  /* Mobile canvas (responsive pages only): photo covers the frame, wordmark
     centred, and the display line wraps instead of running off the edge. */
  @media (max-width: 900px), (pointer: coarse) and (max-height: 500px) {
    :global(html[data-responsive]) .hero-photo {
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      /* Center the pair and remove desktop overscan to keep both faces in frame. */
      background-position: 43% center;
    }
    :global(html[data-responsive]) .hero-scrim {
      left: 0;
      right: 0;
    }
    :global(html[data-responsive]) .hero-display {
      white-space: normal;
      font-size: 104px;
      line-height: 1;
    }
    :global(html[data-responsive]) .hero-events {
      min-height: max(96px, calc(44px / var(--page-zoom, 1)));
      padding: 24px 36px;
      font-size: 34px;
    }
  }
</style>
