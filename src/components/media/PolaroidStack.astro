---
interface Props {
  count?: number;
  size?: number;
  class?: string;
}

const TILTS = [-7, 4, -3, 8];
const PLACEHOLDERS = ['ph-meadow', 'ph-forest', 'ph-meadow', 'ph-sky'];
const { count = 3, size = 104, class: className } = Astro.props;
const photos = Array.from({ length: count }, (_, i) => i);
---

<div class:list={['polaroid-stack', className]}>
  {
    photos.map((i) => (
      <figure
        class="polaroid"
        style={`margin-left:${i ? `-${size * 0.22}px` : '0'}; z-index:${i}; transform:rotate(${TILTS[i % TILTS.length]}deg)`}
      >
        <span
          class:list={['polaroid-photo', 'ph', PLACEHOLDERS[i % PLACEHOLDERS.length]]}
          style={`width:${size}px; height:${size * 0.78}px`}
        />
      </figure>
    ))
  }
</div>

<style>
  .polaroid-stack {
    display: flex;
    align-items: center;
  }
  .polaroid {
    margin: 0;
    padding: 6px;
    padding-bottom: 10px;
    background: var(--white);
    border-radius: var(--radius-polaroid);
    box-shadow: var(--shadow-polaroid);
    transition: transform var(--dur-hover) var(--ease-grow);
  }
  .polaroid-photo {
    display: block;
    border-radius: 1px;
  }
</style>
