---
interface Props {
  label: string;
  help?: string;
  span?: number;
  required?: boolean;
}
const { label, help, span = 1, required = false } = Astro.props;
---

<label
  class="jn-field"
  style={`grid-column: span ${span}`}
  data-jn-required={required ? '' : undefined}
>
  <span class="jn-label">
    {label}
    {required && <span class="jn-req">*</span>}
  </span>
  <div class="jn-control">
    <slot />
    <div class="jn-focus-bar"></div>
  </div>
  {help && <span class="jn-help">{help}</span>}
</label>

<style>
  .jn-field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .jn-label {
    font: 400 24px/1.2 var(--font-body);
    color: var(--cseed-ink);
  }
  .jn-control {
    position: relative;
  }
  .jn-focus-bar {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background: var(--cseed-sun);
    transition: width 600ms var(--ease-soft);
  }
  .jn-field:focus-within .jn-focus-bar {
    width: 100%;
  }
  .jn-help {
    margin-top: 6px;
    font: 300 18px/1.4 var(--font-body);
    color: var(--cseed-ink-soft);
  }
  .jn-req {
    color: var(--cseed-ink-soft);
    margin-left: 4px;
  }
  /* Flagged by the join form's step validation when a required field is left empty. */
  .jn-field.is-invalid .jn-label {
    color: #b3261e;
  }
  .jn-field.is-invalid :global(.jn-input) {
    border-bottom-color: #b3261e;
  }

  /* Mobile canvas: the page renders at about half size on phones. */
  @media (max-width: 900px), (hover: none) and (pointer: coarse) and (max-width: 1400px) {
    :global(html[data-responsive]) .jn-label {
      font-size: 28px;
    }
    :global(html[data-responsive]) .jn-help {
      font-size: 24px;
    }
  }
</style>
