---
import Reveal from '../core/Reveal.astro';

interface Props {
  num: string;
  title: string;
}
const { num, title } = Astro.props;
---

<section class="jn-block">
  <Reveal>
    <div class="jn-block-head">
      <div class="t-eyebrow">{num}</div>
      <h2 class="t-serif" style="font-size:80px">{title}</h2>
    </div>
  </Reveal>
  <Reveal delay={120}>
    <div class="jn-block-fields"><slot /></div>
  </Reveal>
</section>

<style>
  .jn-block {
    display: grid;
    grid-template-columns: 520px minmax(0, 1fr);
    column-gap: 120px;
    padding-top: 70px;
  }
  .jn-block-head {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .jn-block-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 80px;
    row-gap: 80px;
  }
</style>
