---
import Reveal from '../core/Reveal.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="jn-block">
  <Reveal>
    <h2 class="t-serif jn-block-title">{title}</h2>
  </Reveal>
  <Reveal delay={120}>
    <div class="jn-block-fields"><slot /></div>
  </Reveal>
</section>

<style>
  /* The source frames (Figma "Join — Form 1/2/3") centre the step title over a
     full-width field panel, instead of the 520px serif side-column this block
     used to carry. */
  .jn-block {
    padding-top: 28px;
  }
  .jn-block-title {
    font-size: 72px;
    text-align: center;
  }
  .jn-block-fields {
    max-width: 1500px;
    margin: 48px auto 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 80px;
    row-gap: 40px;
  }
</style>
