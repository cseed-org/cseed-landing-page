---
/** Top-of-page banner. Content comes from props so other pages can reuse it. */
interface Props {
  eyebrow?: string;
  title: string;
  /** Supporting sentence under the title. */
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="hero">
  <div class="wrap inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <div class="actions">
      <!-- `<slot />` renders whatever the page puts between <Hero>...</Hero>. -->
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        60rem 30rem at 15% -10%,
        color-mix(in oklab, var(--brand) 22%, transparent),
        transparent
      ),
      radial-gradient(
        50rem 26rem at 90% 10%,
        color-mix(in oklab, var(--accent) 16%, transparent),
        transparent
      );
    border-bottom: 1px solid var(--border);
  }

  .inner {
    padding-block: var(--space-xl);
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .eyebrow {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: var(--space-sm);
  }

  .lede {
    margin-top: var(--space-md);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-top: var(--space-lg);
  }

  /* Collapse the margin when a page passes nothing into the slot. */
  .actions:empty {
    display: none;
  }
</style>
