---
/*
 * PondHero — buildher's signature hero: an interactive canvas pond. Shimmering
 * water (drifting caustic light), lilypads and water lilies floating on top,
 * and ripples that trail the cursor and gently shove the pads around. Its own
 * thing — the sibling idea to buildspace's WebGL galaxy, not a copy of it.
 * Copy is passed in via the default slot and overlaid on the water.
 * Falls back to a calm static pond when prefers-reduced-motion is set.
 */
---

<section class="pond-hero" data-nav-dark-hero>
  <canvas class="pond-canvas" data-pond aria-hidden="true"></canvas>
  <div class="pond-copy"><slot /></div>
</section>

<style>
  .pond-hero {
    position: relative;
    height: 1360px;
    overflow: hidden;
    color: var(--cseed-white);
    background: linear-gradient(180deg, #123f49 0%, #0d323c 46%, #0a2831 100%);
  }
  .pond-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .pond-copy {
    position: relative;
    padding: 330px 100px 0;
    pointer-events: none;
  }
  .pond-copy :global(a),
  .pond-copy :global(button) {
    pointer-events: auto;
  }

  /* mobile canvas */
  @media (max-width: 900px), (pointer: coarse) and (max-height: 500px) {
    .pond-hero {
      height: 900px;
    }
    .pond-copy {
      padding: 250px 40px 0;
    }
  }
</style>

<script>
  type Pad = {
    x: number; y: number; r: number; rot: number; vr: number;
    vx: number; vy: number; drift: number; phase: number; seed: number; shade: number; kind: 'pad' | 'lily';
  };
  type Ripple = { x: number; y: number; r: number; max: number; life: number; seed: number };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLCanvasElement>('[data-pond]').forEach((canvas) => {
    const context = canvas.getContext('2d');
    if (!context) return;
    const ctx = context;
    const host = canvas.closest<HTMLElement>('.pond-hero')!;

    const padImg = new Image();
    let padReady = false;
    padImg.onload = () => (padReady = true);
    padImg.src = '/images/buildher/lilypad2.webp';

    const lilyImg = new Image();
    let lilyReady = false;
    lilyImg.onload = () => (lilyReady = true);
    lilyImg.src = '/images/buildher/lily.webp';

    // grayscale fractal-noise tile (SVG feTurbulence) — a real organic texture for the water
    const noiseImg = new Image();
    let noiseReady = false;
    noiseImg.onload = () => { noiseReady = true; buildTexture(); };
    noiseImg.src =
      'data:image/svg+xml,' +
      encodeURIComponent(
        "<svg xmlns='http://www.w3.org/2000/svg' width='340' height='340'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='340' height='340' filter='url(#n)'/></svg>",
      );

    let W = 0, H = 0, dpr = 1;
    let tex: HTMLCanvasElement | null = null;

    // A lake surface: a soft, organic teal depth (not a mechanical top→bottom line) with a
    // gentle grain over it so it isn't glassy-smooth, kept light so it never reads murky.
    function buildTexture() {
      tex = document.createElement('canvas');
      tex.width = W;
      tex.height = H;
      const c = tex.getContext('2d');
      if (!c) return;

      // the original vertical teal gradient, a touch lighter
      const g = c.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, '#1a5764');
      g.addColorStop(0.46, '#144a55');
      g.addColorStop(1, '#0f3e48');
      c.fillStyle = g;
      c.fillRect(0, 0, W, H);

      // gentle grain so the surface isn't glassy-smooth (soft-light keeps the colour)
      if (noiseReady) {
        const pat = c.createPattern(noiseImg, 'repeat');
        if (pat) {
          c.save();
          c.globalCompositeOperation = 'soft-light';
          c.globalAlpha = 0.5;
          c.fillStyle = pat;
          c.fillRect(0, 0, W, H);
          c.restore();
        }
      }
    }

    const resize = () => {
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildTexture();
    };
    resize();
    window.addEventListener('resize', resize);

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    const padScale = W < 1200 ? 0.6 : 1;

    // place lilypads + lilies with spacing (rejection sampling), clear of the copy zone
    const pads: Pad[] = [];
    const N = 9;
    const czx = 0.22, czy = 0.33, czr = 0.3; // normalized copy-zone ellipse to keep clear
    let guard = 0;
    while (pads.length < N && guard++ < 3000) {
      const lily = pads.length % 3 === 0;
      const r = (lily ? rand(28, 40) : rand(66, 110)) * padScale;
      const nx = rand(0.06, 0.94), ny = rand(0.12, 0.9);
      const ex = (nx - czx) / czr, ey = (ny - czy) / (czr * 0.9);
      if (ex * ex + ey * ey < 1) continue; // don't spawn over the text
      const x = nx * W, y = ny * H;
      if (pads.some((q) => Math.hypot(q.x - x, q.y - y) < q.r + r + 50)) continue; // keep them apart
      pads.push({
        x, y, r,
        rot: rand(0, Math.PI * 2),
        vr: rand(-0.06, 0.06) * 0.01,
        vx: 0, vy: 0,
        drift: rand(4, 10),
        phase: rand(0, Math.PI * 2),
        seed: rand(0, 1000),
        shade: 0.5,
        kind: lily ? 'lily' : 'pad',
      });
    }
    pads.sort((a, b) => a.r - b.r); // big pads drawn first (behind)

    const ripples: Ripple[] = [];
    const spawnRipple = (x: number, y: number, strength = 1) => {
      ripples.push({ x, y, r: 6, max: rand(150, 240) * strength, life: 1, seed: rand(0, 100) });
      // shove nearby pads outward
      for (const p of pads) {
        const dx = p.x - x, dy = p.y - y;
        const d = Math.hypot(dx, dy) || 1;
        if (d < 260) {
          const f = ((260 - d) / 260) * 0.9 * strength;
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f;
          p.vr += rand(-0.01, 0.01);
        }
      }
    };

    let lastRipple = 0;
    const pointer = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const sx = canvas.clientWidth / rect.width;
      const sy = canvas.clientHeight / rect.height;
      const x = (e.clientX - rect.left) * sx;
      const y = (e.clientY - rect.top) * sy;
      const now = performance.now();
      if (now - lastRipple > 150) {
        lastRipple = now;
        spawnRipple(x, y, 0.6);
      }
    };
    // On touch, a trailing ripple under every move reads as jittery while scrolling —
    // so only mice get the cursor trail. Taps still ripple, anywhere on the hero.
    const fine = window.matchMedia('(pointer: fine)').matches;
    if (!reduce) {
      if (fine) host.addEventListener('pointermove', pointer);
      host.addEventListener('pointerdown', (e) => spawnRipple(
        (e.clientX - canvas.getBoundingClientRect().left) * (canvas.clientWidth / canvas.getBoundingClientRect().width),
        (e.clientY - canvas.getBoundingClientRect().top) * (canvas.clientHeight / canvas.getBoundingClientRect().height),
        1.4,
      ));
    }

    /* ---- drawing ---- */
    function drawWater(t: number) {
      // painted base
      if (tex) ctx.drawImage(tex, 0, 0, W, H);
      // moving caustic light blobs
      for (let i = 0; i < 5; i++) {
        const bx = W * (0.5 + 0.42 * Math.sin(t * 0.00007 * (i + 1) + i * 1.7));
        const by = H * (0.5 + 0.4 * Math.cos(t * 0.00006 * (i + 1.3) + i));
        const rad = Math.min(W, H) * (0.28 + 0.06 * Math.sin(t * 0.0004 + i));
        const g = ctx.createRadialGradient(bx, by, 0, bx, by, rad);
        g.addColorStop(0, 'rgba(140, 205, 210, 0.1)');
        g.addColorStop(1, 'rgba(140, 205, 210, 0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, W, H);
      }
      // faint horizontal shimmer lines
      ctx.strokeStyle = 'rgba(180, 230, 235, 0.05)';
      ctx.lineWidth = 1;
      for (let i = 0; i < 6; i++) {
        const y = (H * (i + 0.5)) / 6 + Math.sin(t * 0.0006 + i) * 8;
        ctx.beginPath();
        for (let x = 0; x <= W; x += 24) ctx.lineTo(x, y + Math.sin(x * 0.01 + t * 0.001 + i) * 5);
        ctx.stroke();
      }
    }

    function drawPad(p: Pad) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      // soft shadow on the water
      ctx.shadowColor = 'rgba(0, 20, 24, 0.4)';
      ctx.shadowBlur = 18;
      ctx.shadowOffsetY = 10;
      if (p.kind === 'lily') {
        if (lilyReady) {
          ctx.rotate(-p.rot); // keep the bloom upright regardless of drift
          const w = p.r * 2.6;
          const h = w * (lilyImg.height / lilyImg.width);
          ctx.drawImage(lilyImg, -w / 2, -h / 2, w, h);
        }
      } else if (padReady) {
        // hand-painted lilypad sprite (some flipped for variety)
        const w = p.r * 2.2;
        const h = w * (padImg.height / padImg.width);
        if (p.seed % 2 < 1) ctx.scale(-1, 1);
        ctx.drawImage(padImg, -w / 2, -h / 2, w, h);
      }
      ctx.restore();
    }

    function drawRipples() {
      const ring = (rp: Ripple, radius: number, alpha: number) => {
        ctx.strokeStyle = `rgba(200, 240, 245, ${alpha * rp.life})`;
        ctx.beginPath();
        const steps = 42;
        for (let i = 0; i <= steps; i++) {
          const a = (i / steps) * Math.PI * 2;
          // wobble + slight squash so ripples aren't perfect circles
          const wob = 1 + 0.04 * Math.sin(a * 3 + rp.seed) + 0.022 * Math.sin(a * 5 - rp.seed * 1.3);
          const x = rp.x + Math.cos(a) * radius * wob;
          const y = rp.y + Math.sin(a) * radius * wob * 0.9;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      };
      for (const rp of ripples) {
        ctx.lineWidth = 1.6;
        ring(rp, rp.r, 0.38);
        ctx.lineWidth = 1.2;
        ring(rp, rp.r * 0.62, 0.16);
      }
    }

    function frame(now: number) {
      ctx.clearRect(0, 0, W, H);
      drawWater(now);

      // keep pads spaced apart so drifting never lumps them together
      for (let i = 0; i < pads.length; i++) {
        for (let j = i + 1; j < pads.length; j++) {
          const a = pads[i], b = pads[j];
          const dx = b.x - a.x, dy = b.y - a.y;
          const d = Math.hypot(dx, dy) || 1;
          const min = a.r + b.r + 30;
          if (d < min) {
            const f = ((min - d) / min) * 0.15;
            const ux = dx / d, uy = dy / d;
            a.vx -= ux * f; a.vy -= uy * f;
            b.vx += ux * f; b.vy += uy * f;
          }
        }
      }

      for (const p of pads) {
        // gentle drift + bob
        p.x += Math.sin(now * 0.0002 + p.phase) * 0.06 + p.vx;
        p.y += Math.cos(now * 0.00017 + p.phase) * 0.05 + p.vy;
        p.rot += p.vr;
        p.vx *= 0.94;
        p.vy *= 0.94;
        p.vr *= 0.96;
        // keep pads drifting out of the copy zone (top-left) so text stays readable
        const czx = W * 0.22, czy = H * 0.33, rx = W * 0.28, ry = H * 0.26;
        const nx = (p.x - czx) / rx, ny = (p.y - czy) / ry;
        const dd = nx * nx + ny * ny;
        if (dd < 1) {
          const dx = p.x - czx, dy = p.y - czy, d = Math.hypot(dx, dy) || 1;
          const f = (1 - Math.sqrt(dd)) * 0.6;
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f;
        }
        // wrap around the pond
        const m = p.r + 40;
        if (p.x < -m) p.x = W + m;
        if (p.x > W + m) p.x = -m;
        if (p.y < -m) p.y = H + m;
        if (p.y > H + m) p.y = -m;
        drawPad(p);
      }

      for (let i = ripples.length - 1; i >= 0; i--) {
        const rp = ripples[i];
        rp.r += (rp.max - rp.r) * 0.04 + 0.6;
        rp.life -= 0.012;
        if (rp.life <= 0 || rp.r >= rp.max) ripples.splice(i, 1);
      }
      drawRipples();

      if (running) requestAnimationFrame(frame);
    }

    let running = false;
    const start = () => { if (!running) { running = true; requestAnimationFrame(frame); } };
    const stop = () => { running = false; };

    if (reduce) {
      // one calm static frame
      ctx.clearRect(0, 0, W, H);
      drawWater(0);
      for (const p of pads) drawPad(p);
    } else {
      new IntersectionObserver((es) => {
        es[0].isIntersecting ? start() : stop();
      }).observe(host);
    }
  });
</script>
