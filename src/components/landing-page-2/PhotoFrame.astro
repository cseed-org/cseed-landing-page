---
/* Photo clipped to the source's torn-edge frame vector, greyscale like the draft.
   `src` is optional: without a full-res asset it falls back to the placeholder fill. */
interface Props {
  src?: string;
  alt?: string;
  width?: string;
  grayscale?: boolean;
  position?: string;
}
const { src, alt = '', width = '100%', grayscale = true, position = 'center' } = Astro.props;
const fill = src
  ? `background:var(--cs-grey-placeholder) url('${src}') ${position} / cover no-repeat;`
  : `background:var(--cs-grey-placeholder);`;
---
<div
  class="cs-photoframe"
  role="img"
  aria-label={alt}
  style={`width:${width};${fill}${grayscale ? 'filter:grayscale(1) contrast(1.05);' : ''}`}
></div>

<style define:vars={{ frame: "url('/landing-page-2/photo-frame.svg')" }}>
  .cs-photoframe {
    aspect-ratio: 658.871 / 685.127;
    mask: var(--frame) center / 100% 100% no-repeat;
    -webkit-mask: var(--frame) center / 100% 100% no-repeat;
  }
</style>
