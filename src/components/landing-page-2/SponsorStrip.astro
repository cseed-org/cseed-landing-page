---
/* Full-bleed sponsor marquee between two hairlines. Two identical lanes loop -50%,
   paused on hover via CSS alone (no JS state needed for that part). */
interface Logo {
  src?: string;
  alt: string;
}
interface Props {
  logos: Logo[];
  speed?: number;
  logoHeight?: number;
}
const { logos, speed = 32, logoHeight = 52 } = Astro.props;
---
<div class="cs-sponsor-strip" style={`--speed:${speed}s;`}>
  <div class="cs-sponsor-strip__track">
    {[0, 1].map((copy) => (
      <div class="cs-sponsor-strip__lane" aria-hidden={copy === 1}>
        {logos.map((logo) =>
          logo.src ? (
            <img src={logo.src} alt={copy === 0 ? logo.alt : ''} style={`height:${logoHeight}px;`} />
          ) : (
            <div
              role="img"
              aria-label={copy === 0 ? logo.alt : ''}
              class="cs-sponsor-strip__placeholder"
              style={`height:${logoHeight}px;`}
            >{logo.alt}</div>
          )
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .cs-sponsor-strip {
    border-top: 1px solid var(--cs-black);
    border-bottom: 1px solid var(--cs-black);
    overflow: hidden;
    padding: clamp(28px, 3.4vw, 44px) 0;
  }
  .cs-sponsor-strip__track {
    display: flex;
    width: max-content;
    animation: cs-marquee var(--speed) linear infinite;
  }
  .cs-sponsor-strip:hover .cs-sponsor-strip__track {
    animation-play-state: paused;
  }
  .cs-sponsor-strip__lane {
    display: flex;
    align-items: center;
    gap: clamp(48px, 6vw, 96px);
    padding-right: clamp(48px, 6vw, 96px);
  }
  .cs-sponsor-strip__lane img {
    width: auto;
    flex-shrink: 0;
  }
  .cs-sponsor-strip__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 160px;
    padding: 0 14px;
    background: var(--cs-grey-placeholder);
    border-radius: 4px;
    font-family: var(--font-brand);
    font-size: 13px;
    color: var(--cs-brown);
    text-align: center;
  }
</style>
