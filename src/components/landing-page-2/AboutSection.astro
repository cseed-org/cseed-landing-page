---
import HighlightSpan from './HighlightSpan.astro';
import PhotoFrame from './PhotoFrame.astro';

/* Blue slanted card: statement with two highlights, torn-edge photo, tape, ticks.
   about-photo.png could not be pulled from the design source (over the design
   MCP's per-file size cap), so the photo frame falls back to its placeholder fill —
   see PhotoFrame.astro. */
---
<section id="about" class="cs-about">
  <div class="cs-about__panel">
    <div class="cs-about__fill"></div>
    <div class="cs-about__tape cs-about__tape--tl"></div>
    <div class="cs-about__tape cs-about__tape--br"></div>

    <div class="cs-about__grid">
      <p class="cs-about__statement">
        <span data-reveal-line>cseed is a place where</span>
        <span data-reveal-line><HighlightSpan tone="yellow">people</HighlightSpan> of every experience</span>
        <span data-reveal-line>level come to</span>
        <span data-reveal-line><HighlightSpan tone="pink">ship something</HighlightSpan></span>
      </p>

      <div class="cs-about__photo-wrap">
        <svg class="cs-about__ticks" viewBox="0 0 40 40" aria-hidden="true">
          <g stroke="var(--cs-black)" stroke-width="2.6" stroke-linecap="round">
            <line x1="6" y1="10" x2="18" y2="34" />
            <line x1="18" y1="4" x2="30" y2="28" />
          </g>
        </svg>
        <div class="cs-about__photo" data-reveal-photo>
          <PhotoFrame alt="A cseed builder demoing a project" position="50% 20%" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cs-about {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .cs-about__panel {
    position: relative;
  }
  .cs-about__fill {
    position: absolute;
    inset: 0;
    background: var(--surface-about);
    clip-path: polygon(0 3%, 98% 0, 96.5% 100%, 0 92%);
  }
  .cs-about__tape {
    position: absolute;
    width: clamp(72px, 9vw, 128px);
    height: clamp(20px, 2.4vw, 32px);
    background: var(--cs-tape);
    z-index: 3;
    transform: rotate(-36deg);
  }
  .cs-about__tape--tl {
    left: -1.5%;
    top: -2%;
  }
  .cs-about__tape--br {
    right: -2.5%;
    bottom: 4%;
  }
  .cs-about__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(36px, 5.5vw, 80px) 0 clamp(44px, 6.5vw, 96px) clamp(28px, 5.5vw, 72px);
  }
  .cs-about__statement {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-statement);
    line-height: var(--lh-statement);
    color: var(--cs-ink);
    letter-spacing: -0.01em;
  }
  .cs-about__statement span {
    display: block;
  }
  .cs-about__photo-wrap {
    position: relative;
    margin-right: -6%;
  }
  .cs-about__ticks {
    position: absolute;
    left: -4%;
    top: 44%;
    width: 12%;
    z-index: 2;
  }
  .cs-about__photo {
    transition:
      opacity 800ms var(--ease-out-soft) 200ms,
      transform 1100ms var(--ease-out-soft) 200ms;
  }

  @media (max-width: 720px) {
    .cs-about__grid {
      grid-template-columns: 1fr;
      padding-right: clamp(20px, 5.5vw, 40px);
    }
    .cs-about__photo-wrap {
      margin-right: 0;
    }
  }
</style>

<script>
  const lines = document.querySelectorAll<HTMLElement>('.cs-about__statement [data-reveal-line]');
  lines.forEach((el, i) => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = `opacity 600ms var(--ease-out-soft) ${i * 90}ms, transform 900ms var(--ease-out-soft) ${i * 90}ms`;
  });

  const photo = document.querySelector<HTMLElement>('[data-reveal-photo]');
  if (photo) {
    photo.style.opacity = '0';
    photo.style.transform = 'translateY(16px) rotate(-3deg) scale(.96)';
  }

  const section = document.querySelector('.cs-about');
  if (section && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          lines.forEach((el) => {
            el.style.opacity = '1';
            el.style.transform = 'none';
          });
          if (photo) {
            photo.style.opacity = '1';
            photo.style.transform = 'none';
          }
          io.disconnect();
        });
      },
      { threshold: 0.2 }
    );
    io.observe(section);
  } else {
    lines.forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
    if (photo) {
      photo.style.opacity = '1';
      photo.style.transform = 'none';
    }
  }
</script>
