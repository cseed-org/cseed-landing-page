---
import Eyebrow from './Eyebrow.astro';
import DisplayHeading from './DisplayHeading.astro';
import ProgramPanel from './ProgramPanel.astro';

const PROGRAMS = [
  {
    id: 'buildspace',
    program: 'buildspace' as const,
    color: 'blue',
    name: 'buildspace',
    description: 'A six-week cohort to build the idea that never left your mind.',
    linkLabel: 'explore buildspace',
    topLeft: 5,
    topRight: 0,
  },
  {
    id: 'buildher',
    program: 'buildher' as const,
    color: 'yellow',
    name: 'buildher',
    description: 'A community for women and non-binary people exploring STEM.',
    linkLabel: 'explore buildher',
    topLeft: 0,
    topRight: 3,
  },
  {
    id: 'saturdays',
    program: 'saturdays' as const,
    color: 'pink',
    name: 'saturdays',
    description: 'Make time for your ideas. Find people to build with.',
    linkLabel: 'explore saturdays',
    topLeft: 0,
    topRight: 5,
    bottomLeft: 0,
    bottomRight: 4,
  },
];

const heading = 'find your way to build.';
const words = heading.split(' ');
---
<section class="cs-programs">
  <div class="cs-programs__intro">
    <Eyebrow>Our Programs</Eyebrow>
    <DisplayHeading style="margin-top:10px;">
      <span class="cs-programs__reveal-words" data-reveal-words>
        {words.map((w, i) => (
          <span data-reveal-word><span style={`transition-delay:${i * 80}ms`}>{w}</span></span>
        ))}
      </span>
    </DisplayHeading>
  </div>

  {PROGRAMS.map((p) => (
    <ProgramPanel {...p} href={`#${p.id}`} />
  ))}
</section>

<style>
  .cs-programs {
    padding-top: var(--section-gap);
  }
  .cs-programs__intro {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter) clamp(12px, 1.5vw, 24px);
  }
  .cs-programs__reveal-words {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.26em;
  }
</style>
