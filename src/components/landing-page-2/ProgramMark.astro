---
/**
 * The three program marks, transcribed from the source vectors:
 * buildspace — green inverted rounded triangle with a deep-green star
 * buildher   — pink bowl with a hot-pink sunburst (small bowl + three rays)
 * saturdays  — gold star on a light-gold star
 */
const BLOB =
  'M 587.595 0 L 119.461 0 C 77.346 0 57.359 51.887 88.591 80.14 L 329.387 297.965 C 347.289 314.16 374.661 313.767 392.091 297.066 L 619.431 79.241 C 649.375 50.55 629.067 0 587.595 0 Z';
const STAR_LG =
  'M 12.539 9.115 C 8.612 6.26 10.647 0.048 15.501 0.07 L 490.073 2.221 C 494.921 2.243 496.904 8.459 492.964 11.284 L 376.447 94.83 C 374.668 96.106 373.925 98.39 374.614 100.468 L 442.821 306.133 C 444.343 310.722 439.114 314.584 435.176 311.781 L 256.33 184.475 C 254.595 183.239 252.267 183.239 250.531 184.475 L 71.685 311.781 C 67.747 314.584 62.518 310.722 64.04 306.133 L 132.255 100.444 C 132.94 98.378 132.21 96.105 130.449 94.826 L 12.539 9.115 Z';
const STAR_SM =
  'M 12.882 9.169 C 8.903 6.337 10.928 0.066 15.812 0.096 L 241.834 1.469 C 246.687 1.499 248.657 7.728 244.703 10.542 L 185.103 52.967 C 183.315 54.24 182.566 56.531 183.257 58.614 L 209.627 138.127 C 211.148 142.716 205.92 146.578 201.981 143.774 L 132.657 94.427 C 130.921 93.192 128.593 93.192 126.857 94.427 L 57.533 143.774 C 53.594 146.578 48.365 142.716 49.887 138.127 L 76.257 58.614 C 76.948 56.531 76.199 54.24 74.411 52.967 L 12.882 9.169 Z';
const CIRCLE_LG =
  'M 490.554 0 C 492.41 12.153 493.372 24.599 493.372 37.268 C 493.372 173.007 382.927 283.045 246.686 283.045 C 110.445 283.045 0 173.007 0 37.268 C 0 36.319 0.005 35.372 0.016 34.426 L 490.554 0 Z';
const CIRCLE_SM =
  'M 170.566 0 C 171.081 3.741 171.347 7.561 171.347 11.441 C 171.347 58.067 132.979 95.864 85.65 95.864 C 39.274 95.864 1.502 59.573 0 14.246 L 170.566 0 Z';

const VIEWBOX: Record<string, [number, number]> = {
  buildspace: [702.133, 318],
  buildher: [493.372, 283.045],
  saturdays: [513.75, 334.045],
};

interface Props {
  program?: 'buildspace' | 'buildher' | 'saturdays';
  width?: string;
  class?: string;
}
const { program = 'buildspace', width = '240px', class: className } = Astro.props;
const [vbW, vbH] = VIEWBOX[program] ?? VIEWBOX.buildspace;
---
<svg
  class={`cs-mark ${className ?? ''}`}
  viewBox={`0 0 ${vbW} ${vbH}`}
  style={`width:${width};aspect-ratio:${vbW} / ${vbH};`}
  aria-hidden="true"
>
  {program === 'buildspace' && (
    <g fill-rule="nonzero">
      <path d={BLOB} fill="var(--cs-green)" />
      <path d={STAR_LG} fill="var(--cs-green-deep)" transform="translate(169 6) scale(.72)" />
    </g>
  )}
  {program === 'buildher' && (
    <g fill-rule="nonzero">
      <path d={CIRCLE_LG} fill="var(--cs-pink)" />
      <g fill="var(--cs-pink-hot)">
        <rect x="233" y="40" width="27" height="150" transform="rotate(0 246.5 40)" />
        <rect x="233" y="40" width="27" height="150" transform="rotate(60 246.5 40)" />
        <rect x="233" y="40" width="27" height="150" transform="rotate(-60 246.5 40)" />
        <path d={CIRCLE_SM} transform="translate(161 0)" />
      </g>
    </g>
  )}
  {program === 'saturdays' && (
    <g fill-rule="nonzero">
      <path d={STAR_LG} fill="var(--cs-gold-light)" transform="matrix(1,0.027,-0.026,1,8.424,0)" />
      <path d={STAR_SM} fill="var(--cs-gold)" transform="matrix(1,0.027,-0.026,1,131.677,0)" />
    </g>
  )}
</svg>

<style>
  .cs-mark {
    display: block;
    height: auto;
    overflow: visible;
    transform: rotate(var(--spin, 0deg));
  }
</style>
