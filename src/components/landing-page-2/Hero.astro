---
import Wordmark from './Wordmark.astro';
---
<section class="cs-hero" data-hero>
  <h1 class="cs-hero__word" data-reveal>
    <Wordmark size="var(--fs-wordmark-hero)" highlight />
  </h1>
</section>

<style>
  .cs-hero {
    display: grid;
    place-items: center;
    padding: clamp(72px, 9vw, 128px) var(--gutter) clamp(96px, 12vw, 176px);
  }
  .cs-hero__word {
    margin: 0;
    transition:
      opacity var(--dur-slow) var(--ease-out-soft),
      transform 1100ms var(--ease-out-soft);
  }
  .cs-hero__word[data-reveal] {
    transform: translateY(32px) rotate(-1.5deg);
  }
  .cs-hero__word[data-reveal].is-revealed {
    transform: none;
  }
</style>
