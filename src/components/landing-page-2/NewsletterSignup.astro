---
/* Tan signup card: 1px black box, Poppins title, one white field.
   No mailing-list backend is wired up yet (mirrors the source design's own
   local-only "sent" state) — this only upgrades the UI on submit. */
interface Props {
  title?: string;
  placeholder?: string;
}
const { title = 'Newsletter sign up', placeholder = 'email' } = Astro.props;
---
<form class="cs-newsletter" data-newsletter-form novalidate>
  <p class="cs-newsletter__title" data-newsletter-title>{title}</p>
  <input
    class="cs-newsletter__input"
    type="email"
    name="email"
    placeholder={placeholder}
    aria-label="Email address"
    required
  />
</form>

<style>
  .cs-newsletter {
    background: var(--surface-callout);
    border: 1px solid var(--cs-black);
    padding: clamp(48px, 6vw, 72px) var(--gutter) clamp(56px, 7vw, 88px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .cs-newsletter__title {
    margin: 0;
    font-family: var(--font-brand);
    font-size: var(--fs-callout-title);
    line-height: 1.2;
    letter-spacing: var(--ls-tight);
    color: var(--cs-black);
    text-align: center;
  }
  .cs-newsletter__input {
    width: min(440px, 100%);
    height: 46px;
    border-radius: var(--radius-field);
    border: none;
    outline: none;
    background: var(--surface-field);
    padding: 0 16px;
    font-family: var(--font-brand);
    font-size: var(--fs-field);
    color: var(--cs-black);
  }
  .cs-newsletter__input:disabled {
    opacity: 0.6;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('.cs-newsletter__input');
      const title = form.querySelector<HTMLElement>('[data-newsletter-title]');
      if (!input || !input.value) return;
      input.disabled = true;
      if (title) title.textContent = "thanks — you're on the list.";
    });
  });
</script>
