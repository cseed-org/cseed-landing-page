---
/* "explore buildspace" — Inter over a hairline rule, arrow slides out on hover. */
interface Props {
  label: string;
  href?: string;
  color?: string;
}
const { label, href = '#', color = 'var(--cs-ink)' } = Astro.props;
---
<a href={href} class="cs-explore" style={`color:${color};border-bottom-color:${color};`}>
  <span>{label}</span>
  <svg class="cs-explore__arrow" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M5 19 L19 5 M9 5 H19 V15" fill="none" stroke={color} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<style>
  .cs-explore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 5px;
    border-bottom: 1px solid;
    font-family: var(--font-body);
    font-size: var(--fs-link);
    line-height: 1.2;
    text-decoration: none;
  }
  .cs-explore:hover {
    color: inherit;
  }
  .cs-explore__arrow {
    transition: transform var(--dur-mid) var(--ease-out-soft);
  }
  .cs-explore:hover .cs-explore__arrow {
    transform: translate(3px, -3px);
  }
</style>
