---
/**
 * The cseed wordmark is always type — the source ships no logo file.
 * Poppins Bold, tight tracking, optionally sat on the yellow highlight block.
 */
interface Props {
  size?: string;
  highlight?: boolean;
  color?: string;
  class?: string;
}
const { size = '30px', highlight = false, color = 'var(--cs-brown)', class: className } = Astro.props;
---
<span
  class={`cs-wordmark ${className ?? ''}`}
  style={`font-size:${size};color:${color};${highlight ? 'background:var(--highlight-wordmark);' : ''}`}
>cseed</span>

<style>
  .cs-wordmark {
    display: inline-block;
    font-family: var(--font-brand);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    white-space: nowrap;
    padding: 0;
  }
  .cs-wordmark[style*='background'] {
    padding: 0.04em 0.07em 0.1em;
  }
</style>
