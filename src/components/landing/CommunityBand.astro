---
import SectionHeading from '../core/SectionHeading.astro';
import TextLink from '../core/TextLink.astro';
import Reveal from '../core/Reveal.astro';

/* "come as you are. make something yours." -- heading, one link, and the
   two community photo plates (1344x644 + 560x644). */
---

<div class="community-band" id="join">
  <Reveal style="margin-left:83px; margin-top:128px">
    <SectionHeading align="left" width={1400}>come as you are. make something yours.</SectionHeading
    >
  </Reveal>
  <Reveal delay={120} style="margin-left:83px; margin-top:-32px">
    <TextLink href="/join/" arrowLength={39.408}>join cseed</TextLink>
  </Reveal>
  <Reveal delay={240} mode="fade" style="margin-top:104px; padding-left:47px">
    <div class="community-photos">
      <img
        class="community-photo community-photo--wide"
        src="/images/community-wide.webp"
        alt="cseed members posing together on a pier overlooking Elliott Bay"
        width="1344"
        height="644"
      />
      <img
        class="community-photo community-photo--tall"
        src="/images/community-tall.webp"
        alt="A cseed member holding up a uw cseed sticker in front of their face"
        width="560"
        height="644"
      />
    </div>
  </Reveal>
</div>

<style>
  .community-band {
    width: var(--canvas-width);
  }
  .community-photos {
    display: flex;
    gap: 67px;
  }
  .community-photo {
    flex: none;
    display: block;
    object-fit: cover;
  }
  .community-photo--wide {
    width: 1344px;
    height: 644px;
  }
  .community-photo--tall {
    width: 560px;
    height: 644px;
  }

  /* Mobile canvas (responsive pages only): even 40px gutters, and the two photos
     keep their side-by-side proportions at the narrower width. */
  @media (max-width: 900px), (pointer: coarse) and (max-height: 500px) {
    :global(html[data-responsive]) .community-band {
      padding: 0 40px;
    }
    :global(html[data-responsive]) .community-band > :global(.reveal) {
      margin-left: 0 !important;
      padding-left: 0 !important;
    }
    :global(html[data-responsive]) .community-band > :global(.reveal:first-child) {
      margin-top: 110px !important;
    }
    :global(html[data-responsive]) .community-band > :global(.reveal:nth-child(2)) {
      margin-top: 28px !important;
    }
    :global(html[data-responsive]) .community-band > :global(.reveal:nth-child(3)) {
      margin-top: 64px !important;
    }
    :global(html[data-responsive]) .community-photos {
      gap: 20px;
    }
    :global(html[data-responsive]) .community-photo--wide {
      flex: 1344 1 0;
      min-width: 0;
      width: auto;
      height: auto;
      aspect-ratio: 1344 / 644;
    }
    :global(html[data-responsive]) .community-photo--tall {
      flex: 560 1 0;
      min-width: 0;
      width: auto;
      height: auto;
      aspect-ratio: 560 / 644;
    }
  }
</style>
