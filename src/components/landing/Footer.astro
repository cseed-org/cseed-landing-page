---
const columns = [
  {
    title: 'programs',
    links: [
      ['buildspace', '/buildspace/'],
      ['buildher', '/join/'],
      ['saturdays', '/saturdays/'],
    ],
  },
  {
    title: 'cseed',
    links: [
      ['about us', '/about-us/'],
      ['join', '/join/'],
      ['sponsors', '/#sponsors'],
      ['code of conduct', '/code-of-conduct/'],
    ],
  },
];

// Social links, shown as icons along the bottom of the footer.
const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/cseeduw/', icon: 'instagram' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/cseeduw/posts/', icon: 'linkedin' },
  { label: 'Email', href: 'mailto:email@cseed.org', icon: 'email' },
  { label: 'GitHub', href: 'https://github.com/cseed-org', icon: 'github' },
];
---

<footer class="site-footer">
  <div class="site-footer-top">
    <div class="site-footer-brand">
      <img
        class="site-footer-logo"
        src="/images/cseed-logo.png"
        alt="cseed"
        width="176"
        height="40"
      />
      <p>good people. curious ideas.</p>
    </div>
    <div class="site-footer-columns">
      {
        columns.map((col) => (
          <div class="site-footer-column">
            <span class="site-footer-column-title">{col.title}</span>
            {col.links.map(([label, href]) => (
              <a class="site-footer-link" href={href}>
                {label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="site-footer-note">
    <div class="site-footer-socials">
      {
        socials.map((s) => (
          <a
            class="site-footer-social"
            href={s.href}
            aria-label={s.label}
            title={s.label}
            {...(s.icon === 'email' ? {} : { target: '_blank', rel: 'noopener' })}
          >
            <svg width="36" height="36" viewBox="0 0 24 24" aria-hidden="true">
              {s.icon === 'instagram' && (
                <g fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none" />
                </g>
              )}
              {s.icon === 'linkedin' && (
                <g fill="currentColor">
                  <path d="M3 5.5a2 2 0 1 1 4 0 2 2 0 0 1-4 0zM3.3 9h3.4v11.5H3.3zM9.2 9h3.3v1.6c.5-.9 1.7-1.9 3.5-1.9 3.6 0 4.3 2.4 4.3 5.4v6.4h-3.4v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3v5.8H9.2z" />
                </g>
              )}
              {s.icon === 'email' && (
                <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M3.5 6.5 12 13l8.5-6.5" />
                </g>
              )}
              {s.icon === 'github' && (
                <path
                  fill="currentColor"
                  d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"
                />
              )}
            </svg>
          </a>
        ))
      }
    </div>
    <span>made with love by our design team &lt;3</span>
    <span>© 2026 cseed. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    box-sizing: border-box;
    padding: 96px 40px 48px;
    gap: 96px;
    background: var(--cseed-sun);
    color: var(--cseed-ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .site-footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .site-footer-logo {
    display: block;
    width: 176px;
    height: auto;
  }
  .site-footer-brand p {
    margin: 0;
    font: 400 24px/1.3 var(--font-body);
    max-width: 560px;
  }
  .site-footer-columns {
    display: grid;
    grid-template-columns: repeat(2, 236px);
    padding-right: 40px;
  }
  .site-footer-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .site-footer-column-title {
    font: 700 26px/1.2 var(--font-body);
    margin-bottom: 12px;
  }
  .site-footer-link {
    font: 400 21px/1.2 var(--font-body);
    color: var(--cseed-ink);
    text-decoration: none;
    opacity: 0.72;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .site-footer-link:hover {
    opacity: 1;
    color: var(--cseed-ink);
  }
  .site-footer-note {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font: 400 20px/1 var(--font-body);
  }
  .site-footer-socials {
    display: flex;
    gap: 36px;
    margin-bottom: 28px;
  }
  .site-footer-social {
    display: flex;
    color: var(--cseed-ink);
    opacity: 0.72;
    transition:
      opacity var(--dur-hover) var(--ease-soft),
      transform var(--dur-hover) var(--ease-soft);
  }
  .site-footer-social:hover {
    opacity: 1;
    color: var(--cseed-ink);
    transform: translateY(-2px);
  }

  /* Mobile canvas (responsive pages only): brand above the link columns. */
  @media (max-width: 900px) {
    :global(html[data-responsive]) .site-footer {
      padding: 80px 40px 44px;
      gap: 80px;
    }
    :global(html[data-responsive]) .site-footer-top {
      flex-direction: column;
      gap: 64px;
    }
    :global(html[data-responsive]) .site-footer-brand p {
      font-size: 28px;
    }
    :global(html[data-responsive]) .site-footer-columns {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-right: 0;
    }
    :global(html[data-responsive]) .site-footer-column-title {
      font-size: 26px;
    }
    :global(html[data-responsive]) .site-footer-link {
      font-size: 24px;
    }
    :global(html[data-responsive]) .site-footer-note {
      font-size: 22px;
      text-align: center;
    }
  }
</style>
