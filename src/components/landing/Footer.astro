---
import MailIcon from '../core/MailIcon.astro';
import SocialIcon from '../core/SocialIcon.astro';
import { SOCIALS } from '../../data/socials';

const columns = [
  {
    title: 'programs',
    links: [
      ['buildspace', '/buildspace/'],
      ['buildher', '/buildher/'],
      ['saturdays', '/saturdays/'],
    ],
  },
  {
    title: 'cseed',
    links: [
      ['about us', '/about-us/'],
      ['join', '/join/'],
      ['sponsors', '/#sponsors'],
    ],
  },
  {
    title: 'more links',
    links: [
      ['Event Calendar', 'https://luma.com/uwcseed'],
      ['code of conduct', '/code-of-conduct/'],
      ['github', 'https://github.com/cseed-org'],
      ['back to top ↑', '#top'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer-top">
    <div class="site-footer-main">
      <div class="site-footer-brand">
        <img
          class="site-footer-logo"
          src="/images/cseed-logo.png"
          alt="cseed"
          width="176"
          height="40"
        />
        <p>Experiment, Reflect, Iterate!</p>
      </div>
      <div class="site-footer-socials">
        {
          SOCIALS.map((s) => (
            <a
              class="site-footer-social"
              href={s.href}
              aria-label={s.label}
              title={s.label}
              target="_blank"
              rel="noopener"
            >
              <SocialIcon icon={s.icon} size={36} />
            </a>
          ))
        }
      </div>
      <a class="site-footer-contact" href="mailto:questions@cseed.co">
        <MailIcon size={30} />
        <span>questions@cseed.co</span>
      </a>
    </div>
    <div class="site-footer-columns">
      {
        columns.map((col) => (
          <div class="site-footer-column">
            <span class="site-footer-column-title">{col.title}</span>
            {col.links.map(([label, href]) =>
              href.startsWith('http') ? (
                <a class="site-footer-link" href={href} target="_blank" rel="noopener">
                  {label}
                </a>
              ) : (
                <a class="site-footer-link" href={href}>
                  {label}
                </a>
              ),
            )}
          </div>
        ))
      }
    </div>
  </div>
  <div class="site-footer-base">
    <img
      class="site-footer-people"
      src="/images/footer/members-cutout.webp"
      alt="cseed members cut out in black and white"
      width="1406"
      height="652"
      loading="lazy"
    />
    <!-- Each phrase is its own flex item: Astro drops whitespace that wraps around inline links. -->
    <div class="site-footer-note">
      <p>
        <span>&copy; 2026 cseed</span>
        <span>made with love by our design team &lt;3</span>
      </p>
      <p class="site-footer-legal">
        <span>text, photos &amp; branding: <a href="/content-notice/">all rights reserved</a></span>
        <span>code: <a href="/mit-license/">MIT license</a></span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    box-sizing: border-box;
    padding: 96px 40px 40px;
    background: var(--cseed-sun);
    color: var(--cseed-ink);
    display: flex;
    flex-direction: column;
  }
  /* Tall enough for the member cutout, which stands on the rule below. */
  .site-footer-top {
    min-height: 420px;
    box-sizing: border-box;
    padding-bottom: 56px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .site-footer-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .site-footer-logo {
    display: block;
    width: 176px;
    height: auto;
  }
  .site-footer-brand p {
    margin: 0;
    font: 400 24px/1.3 var(--font-body);
    max-width: 560px;
  }
  .site-footer-socials {
    display: flex;
    gap: 28px;
    margin: 36px 0 32px;
  }
  .site-footer-social {
    display: flex;
    color: var(--cseed-ink);
    opacity: 0.72;
    transition:
      opacity var(--dur-hover) var(--ease-soft),
      transform var(--dur-hover) var(--ease-soft);
  }
  .site-footer-social:hover {
    opacity: 1;
    color: var(--cseed-ink);
    transform: translateY(-2px);
  }
  .site-footer-contact {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 26px;
    border: 1.5px solid var(--cseed-ink);
    color: var(--cseed-ink);
    font: 400 21px/1 var(--font-body);
    text-decoration: none;
    transition:
      background var(--dur-hover) var(--ease-soft),
      color var(--dur-hover) var(--ease-soft);
  }
  .site-footer-contact:hover {
    background: var(--cseed-ink);
    color: var(--cseed-sun);
  }
  .site-footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 190px);
    padding-right: 40px;
  }
  .site-footer-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .site-footer-column-title {
    font: 700 26px/1.2 var(--font-body);
    margin-bottom: 12px;
  }
  .site-footer-link {
    font: 400 21px/1.2 var(--font-body);
    color: var(--cseed-ink);
    text-decoration: none;
    opacity: 0.72;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .site-footer-link:hover {
    opacity: 1;
    color: var(--cseed-ink);
  }
  .site-footer-base {
    position: relative;
  }
  /* Black-and-white member cutout standing on the rule, centered on the footer. */
  .site-footer-people {
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 33%;
    height: auto;
    transform: translateX(-50%);
    display: block;
  }
  .site-footer-note {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 48px;
    padding-top: 24px;
    border-top: var(--rule-nav) solid var(--rule-ink);
    font: 400 20px/1.5 var(--font-body);
  }
  .site-footer-note p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
  }
  .site-footer-note span + span::before {
    content: '·';
    margin: 0 0.6em;
  }
  .site-footer-note a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  /* Mobile canvas (responsive pages only): everything stacks, cutout above the rule. */
  @media (max-width: 900px), (hover: none) and (pointer: coarse) and (max-width: 1400px) {
    :global(html[data-responsive]) .site-footer {
      padding: 80px 40px 36px;
    }
    :global(html[data-responsive]) .site-footer-top {
      min-height: 0;
      padding-bottom: 72px;
      flex-direction: column;
      gap: 64px;
    }
    :global(html[data-responsive]) .site-footer-brand p {
      font-size: 28px;
    }
    /* Padded tap targets; the negative margin keeps the first icon on the text edge. */
    :global(html[data-responsive]) .site-footer-socials {
      gap: 24px;
      margin: 28px 0 28px -12px;
    }
    :global(html[data-responsive]) .site-footer-social {
      padding: 12px;
    }
    :global(html[data-responsive]) .site-footer-social :global(svg) {
      width: 52px;
      height: 52px;
    }
    :global(html[data-responsive]) .site-footer-contact {
      gap: 18px;
      padding: 22px 32px;
      font-size: 28px;
    }
    /* :global -- the icon is MailIcon's svg, which this file's scoped styles can't reach. */
    :global(html[data-responsive]) .site-footer-contact :global(svg) {
      width: 40px;
      height: 40px;
    }
    :global(html[data-responsive]) .site-footer-columns {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 56px;
      padding-right: 0;
    }
    :global(html[data-responsive]) .site-footer-column-title {
      font-size: 26px;
    }
    :global(html[data-responsive]) .site-footer-column {
      gap: 4px;
    }
    /* Padded so each link is a comfortable tap target. */
    :global(html[data-responsive]) .site-footer-link {
      padding: 12px 0;
      font-size: 30px;
    }
    :global(html[data-responsive]) .site-footer-people {
      position: static;
      width: 100%;
      transform: none;
    }
    :global(html[data-responsive]) .site-footer-note {
      flex-direction: column;
      font-size: 24px;
    }
    :global(html[data-responsive]) .site-footer-legal {
      flex-direction: column;
    }
    :global(html[data-responsive]) .site-footer-legal span::before {
      content: none;
    }
  }
</style>
