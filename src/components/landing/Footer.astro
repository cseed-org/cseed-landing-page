---

const columns = [
  {
    title: 'programs',
    links: [
      ['buildspace', '/buildspace/'],
      ['buildher', '/join/'],
      ['saturdays', '/saturdays/'],
    ],
  },
  {
    title: 'cseed',
    links: [
      ['about us', '/about-us/'],
      ['join', '/join/'],
      ['sponsors', '/#sponsors'],
      ['code of conduct', '/code-of-conduct/'],
    ],
  },
  {
    title: 'connect',
    links: [
      ['instagram', '#'],
      ['linkedin', '#'],
      ['github', 'https://github.com/cseed-org'],
      ['email@cseed.org', 'mailto:email@cseed.org'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer-top">
    <div class="site-footer-brand">
      <img class="site-footer-logo" src="/images/cseed-logo.png" alt="cseed" width="176" height="40" />
      <p>good people. curious ideas.</p>
    </div>
    <div class="site-footer-columns">
      {
        columns.map((col) => (
          <div class="site-footer-column">
            <span class="site-footer-column-title">{col.title}</span>
            {col.links.map(([label, href]) => (
              <a class="site-footer-link" href={href}>
                {label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="site-footer-note">
    <span>made with love by our design team &lt;3</span>
    <span>© 2026 cseed. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    box-sizing: border-box;
    padding: 96px 40px 48px;
    gap: 96px;
    background: var(--cseed-sun);
    color: var(--cseed-ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .site-footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .site-footer-logo {
    display: block;
    width: 176px;
    height: auto;
  }
  .site-footer-brand p {
    margin: 0;
    font: 400 24px/1.3 var(--font-body);
    max-width: 560px;
  }
  .site-footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 236px);
    padding-right: 40px;
  }
  .site-footer-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .site-footer-column-title {
    font: 700 26px/1.2 var(--font-body);
    margin-bottom: 12px;
  }
  .site-footer-link {
    font: 400 21px/1.2 var(--font-body);
    color: var(--cseed-ink);
    text-decoration: none;
    opacity: 0.72;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .site-footer-link:hover {
    opacity: 1;
    color: var(--cseed-ink);
  }
  .site-footer-note {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font: 400 20px/1 var(--font-body);
  }

  /* Mobile canvas (responsive pages only): brand above the link columns. */
  @media (max-width: 900px) {
    :global(html[data-responsive]) .site-footer {
      padding: 80px 40px 44px;
      gap: 80px;
    }
    :global(html[data-responsive]) .site-footer-top {
      flex-direction: column;
      gap: 64px;
    }
    :global(html[data-responsive]) .site-footer-brand p {
      font-size: 28px;
    }
    :global(html[data-responsive]) .site-footer-columns {
      width: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-right: 0;
    }
    :global(html[data-responsive]) .site-footer-column-title {
      font-size: 26px;
    }
    :global(html[data-responsive]) .site-footer-link {
      font-size: 24px;
    }
    :global(html[data-responsive]) .site-footer-note {
      font-size: 22px;
      text-align: center;
    }
  }
</style>
