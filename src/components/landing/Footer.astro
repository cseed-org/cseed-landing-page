---
import Wordmark from '../core/Wordmark.astro';

const columns = [
  {
    title: 'programs',
    links: [
      ['buildspace', '/buildspace/'],
      ['buildher', '/join/'],
      ['saturdays', '/saturdays/'],
    ],
  },
  {
    title: 'cseed',
    links: [
      ['about us', '/about-us/'],
      ['join', '/join/'],
      ['sponsors', '/#sponsors'],
    ],
  },
  {
    title: 'connect',
    links: [
      ['instagram', '#'],
      ['linkedin', '#'],
      ['email us', '#'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer-top">
    <div class="site-footer-brand">
      <Wordmark size={40} color="var(--cseed-ink)" />
      <p>good people. curious ideas.</p>
    </div>
    <div class="site-footer-columns">
      {
        columns.map((col) => (
          <div class="site-footer-column">
            <span class="site-footer-column-title">{col.title}</span>
            {col.links.map(([label, href]) => (
              <a class="site-footer-link" href={href}>
                {label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="site-footer-note">© 2026 cseed. All rights reserved.</div>
</footer>

<style>
  .site-footer {
    width: 2083px;
    height: 760px;
    box-sizing: border-box;
    padding: 200px 40px 72px;
    background: var(--cseed-sun);
    color: var(--cseed-ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .site-footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }
  .site-footer-brand p {
    margin: 0;
    font: 400 24px/1.3 var(--font-body);
    max-width: 560px;
  }
  .site-footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 236px);
    padding-right: 40px;
  }
  .site-footer-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .site-footer-column-title {
    font: 500 22px/1.2 var(--font-body);
    margin-bottom: 4px;
  }
  .site-footer-link {
    font: 400 21px/1.2 var(--font-body);
    color: var(--cseed-ink);
    text-decoration: none;
    opacity: 0.72;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .site-footer-link:hover {
    opacity: 1;
    color: var(--cseed-ink);
  }
  .site-footer-note {
    text-align: center;
    font: 400 20px/1 var(--font-body);
  }
</style>
