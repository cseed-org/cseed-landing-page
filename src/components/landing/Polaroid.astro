---
interface Props {
  photoId: string;
  w: number;
  h: number;
  rotate?: number;
  position?: string;
  style?: string;
  z?: number;
  src?: string;
  alt?: string;
}
const { photoId, w, h, rotate = 0, position = 'center', style = '', z, src, alt = '' } = Astro.props;
---

<figure
  class="polaroid"
  data-photo={photoId}
  style={`--pl-rotate:${rotate}deg; ${z !== undefined ? `z-index:${z};` : ''} ${style}`}
>
  {
    src ? (
      <img class="polaroid-photo" src={src} alt={alt} width={w} height={h} style={`object-position:${position}`} />
    ) : (
      <div class="polaroid-photo ph-light" style={`width:${w}px; height:${h}px; background-position:${position}`} />
    )
  }
</figure>

<style>
  /* relative (not absolute like the source) so the positioned Reveal wrapper
     around it gets a real box -- a zero-size wrapper never triggers the
     scroll observer, which left the photos permanently invisible. */
  .polaroid {
    position: relative;
    margin: 0;
    padding: 18px;
    box-sizing: content-box;
    background: var(--cseed-white);
    box-shadow:
      0 14px 34px -16px rgba(40, 34, 20, 0.28),
      0 2px 6px rgba(40, 34, 20, 0.06);
    transform: rotate(var(--pl-rotate));
    transition:
      transform 700ms var(--ease-soft),
      box-shadow 700ms var(--ease-soft);
  }
  /* Hover-only, so a tapped photo doesn't stay lifted on touch screens. */
  @media (hover: hover) {
    .polaroid:hover {
      transform: rotate(calc(var(--pl-rotate) * 0.35)) translateY(-12px);
      box-shadow:
        0 30px 60px -20px rgba(40, 34, 20, 0.32),
        0 4px 10px rgba(40, 34, 20, 0.08);
    }
  }
  .polaroid-photo {
    overflow: hidden;
  }
  img.polaroid-photo {
    display: block;
    object-fit: cover;
  }
</style>
