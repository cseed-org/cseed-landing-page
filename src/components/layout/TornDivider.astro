---
const TEARS: Record<string, string> = {
  a: 'M0,40 C 60,10 120,52 190,34 C 262,16 318,58 392,44 C 470,29 520,8 600,26 C 676,43 730,60 800,44 C 872,28 930,6 1000,30 L1000,100 L0,100 Z',
  b: 'M0,26 C 74,54 128,12 200,30 C 276,49 322,66 398,52 C 468,39 524,4 598,22 C 670,40 726,64 798,50 C 868,36 932,52 1000,36 L1000,100 L0,100 Z',
};

interface Props {
  fill?: string;
  tear?: 'a' | 'b';
  flip?: boolean;
  height?: number;
  class?: string;
}

const { fill = 'var(--cream-200)', tear = 'a', flip = false, height = 44, class: className } = Astro.props;
---

<div
  class:list={['torn-divider', className]}
  aria-hidden="true"
  style={`height:${height}px; transform:${flip ? 'scaleY(-1)' : 'none'}`}
>
  <svg viewBox="0 0 1000 100" preserveAspectRatio="none" width="100%" height="100%">
    <path d={TEARS[tear]} fill={fill} />
  </svg>
</div>

<style>
  .torn-divider {
    position: relative;
    width: 100%;
    line-height: 0;
  }
  .torn-divider svg {
    display: block;
  }
</style>
