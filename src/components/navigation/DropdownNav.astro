---
interface Item {
  label: string;
  href: string;
}
interface Props {
  items: Item[];
  width?: number | string;
  class?: string;
}

const { items, width = 703, class: className } = Astro.props;
---

<div class:list={['dropdown-nav', className]} style={`width:${typeof width === 'number' ? width + 'px' : width}`}>
  {
    items.map((item) => (
      <a class="dropdown-nav-item" href={item.href}>
        <span>{item.label}</span>
      </a>
    ))
  }
</div>

<style>
  .dropdown-nav {
    position: relative;
    padding-bottom: 10px;
    padding-top: 20px;
  }
  .dropdown-nav-item {
    display: block;
    width: 100%;
    white-space: nowrap;
    height: 56px;
    line-height: 56px;
    text-align: center;
    font: var(--weight-body) 24px/56px var(--font-body);
    letter-spacing: var(--tracking-body);
    color: var(--link-ink);
    text-decoration: none;
  }
  .dropdown-nav-item span {
    display: inline-block;
    padding-bottom: 4px;
    background-image: linear-gradient(var(--rule-ink), var(--rule-ink));
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 0% 0.5px;
    transition: background-size var(--dur-hover) var(--ease-soft);
  }
  .dropdown-nav-item:hover span {
    background-size: 100% 0.5px;
  }
</style>
