---
import Wordmark from '../core/Wordmark.astro';

interface FooterColumn {
  title: string;
  links: string[];
}

interface Props {
  tagline?: string;
  columns?: FooterColumn[];
  note?: string;
  class?: string;
}

const {
  tagline = 'a community for the next generation of builders',
  columns = [],
  note = '2026 cseed. all rights reserved.',
  class: className,
} = Astro.props;
---

<footer class:list={['site-footer', 'ph', 'ph-meadow', className]}>
  <div class="site-footer-scrim" aria-hidden="true"></div>
  <div class="site-footer-content">
    <div class="site-footer-brand">
      <Wordmark size={30} />
      <p>{tagline}</p>
    </div>
    <div class="site-footer-columns">
      {
        columns.map((col) => (
          <div class="site-footer-column">
            <span class="site-footer-column-title">{col.title}</span>
            {col.links.map((link) => (
              <a href="#">{link}</a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <p class="site-footer-note">{note}</p>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: var(--space-96) var(--gutter-page) var(--space-40);
    color: var(--cream-100);
  }
  .site-footer-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(22, 33, 15, 0.34), rgba(22, 33, 15, 0.12));
  }
  .site-footer-content {
    position: relative;
    display: flex;
    gap: var(--space-56);
    flex-wrap: wrap;
    justify-content: space-between;
    max-width: var(--max-page);
    margin: 0 auto;
  }
  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: var(--measure-narrow);
  }
  .site-footer-brand p {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-small-size);
    line-height: 1.5;
    opacity: 0.9;
  }
  .site-footer-columns {
    display: flex;
    gap: var(--space-56);
    flex-wrap: wrap;
  }
  .site-footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .site-footer-column-title {
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--type-label-size);
    letter-spacing: var(--type-label-tracking);
    text-transform: lowercase;
  }
  .site-footer-column a {
    color: var(--cream-100);
    opacity: 0.78;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--type-small-size);
  }
  .site-footer-column a:hover {
    opacity: 1;
  }
  .site-footer-note {
    position: relative;
    margin: var(--space-72) 0 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--type-label-size);
    opacity: 0.75;
  }
</style>
