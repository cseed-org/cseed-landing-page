---
import Wordmark from '../core/Wordmark.astro';
import Rule from '../core/Rule.astro';
import DropdownNav from './DropdownNav.astro';

/* Source node "nav bar" -- 2085x200, wordmark inset 41px, Playfair 80 items
   right-aligned, 1px black rule 182px down. Rendered here at a 100px band
   (itemSize 38 / wordmarkSize 36) -- same ratio every source page renders it at. */
const items = [
  {
    label: 'programs',
    href: '/#programs',
    children: [
      { label: 'buildspace', href: '/buildspace/' },
      { label: 'buildher', href: '/buildher/' },
      { label: 'saturdays', href: '/saturdays/' },
    ],
  },
  { label: 'about us', href: '/about-us/' },
  { label: 'join', href: '/join/' },
];
const height = 100;
---

<div class="nav-bar" style={`height:${height}px`}>
  <a class="nav-bar-mark" href="/" style={`height:${height}px`}>
    <Wordmark size={36} />
  </a>
  <div class="nav-bar-items" style={`height:${height}px`}>
    {
      items.map((item) => (
        <div class="nav-bar-item" style={`height:${height}px`}>
          <a
            href={item.href}
            class:list={['nav-bar-link', { 'nav-bar-link--join': item.label === 'join' }]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="nav-bar-dropdown" style={`top:${height}px`}>
              <DropdownNav items={item.children} width="max-content" />
            </div>
          )}
        </div>
      ))
    }
  </div>
  <Rule width={2085} weight={1} class="nav-bar-rule" />
</div>

<style>
  .nav-bar {
    position: relative;
    width: 100%;
    background: var(--surface-page);
  }
  .nav-bar-mark {
    position: absolute;
    left: 41px;
    top: 0;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .nav-bar-items {
    position: absolute;
    right: 77px;
    top: 0;
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .nav-bar-item {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-bar-link {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 38px;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .nav-bar-items:has(.nav-bar-item:hover) .nav-bar-item:not(:hover) .nav-bar-link {
    opacity: 0.45;
  }
  .nav-bar-link--join {
    padding: 0 8px;
    margin: 0 -8px;
    background: linear-gradient(
      transparent 42%,
      var(--cseed-sun) 42%,
      var(--cseed-sun) 92%,
      transparent 92%
    );
  }
  .nav-bar-dropdown {
    position: absolute;
    left: 50%;
    min-width: 100%;
    transform: translateX(-50%) translateY(-12px);
    opacity: 0;
    pointer-events: none;
    padding: 0 32px 24px;
    box-sizing: border-box;
    background: var(--surface-page);
    transition:
      opacity var(--dur-hover) var(--ease-soft),
      transform var(--dur-hover) var(--ease-soft);
    z-index: 4;
  }
  .nav-bar-item:hover .nav-bar-dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .nav-bar :global(.nav-bar-rule) {
    position: absolute;
    left: 0;
    bottom: 0;
  }
</style>
