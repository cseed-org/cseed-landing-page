---
import Rule from '../core/Rule.astro';
import DropdownNav from './DropdownNav.astro';

/* Source node "nav bar" -- 2085x200, wordmark inset 41px, Playfair 80 items
   right-aligned, 1px black rule 182px down. Rendered here at a compact 72px band
   (itemSize 28 / wordmarkSize 28). */
const items = [
  {
    label: 'programs',
    children: [
      { label: 'buildspace', href: '/buildspace/' },
      { label: 'buildher', href: '/buildher/' },
      { label: 'saturdays', href: '/saturdays/' },
    ],
  },
  { label: 'about us', href: '/about-us/' },
  { label: 'join', href: '/join/' },
];
const height = 72;
---

<div class="nav-bar" style={`height:${height}px`}>
  <a class="nav-bar-mark" href="/" style={`height:${height}px`}>
    <img class="nav-bar-logo" src="/images/cseed-logo.png" alt="cseed" width="69" height="16" />
    <img class="nav-bar-logo nav-bar-logo--white" src="/images/cseed-logo-white.png" alt="" aria-hidden="true" width="69" height="16" />
  </a>
  <div class="nav-bar-items" style={`height:${height}px`}>
    {
      items.map((item) => (
        <div class="nav-bar-item" style={`height:${height}px`}>
          {item.children ? (
            <button type="button" class="nav-bar-link nav-bar-link--menu" aria-haspopup="true">
              {item.label}
            </button>
          ) : (
            <a
              href={item.href}
              class:list={['nav-bar-link', { 'nav-bar-link--join': item.label === 'join' }]}
            >
              {item.label}
            </a>
          )}
          {item.children && (
            <div class="nav-bar-dropdown" style={`top:${height}px`}>
              <DropdownNav items={item.children} width="max-content" />
            </div>
          )}
        </div>
      ))
    }
  </div>
  <Rule width={2085} weight={1} class="nav-bar-rule" />
</div>

<style>
  .nav-bar-logo {
    display: block;
    width: 69px;
    height: auto;
  }
  .nav-bar {
    position: relative;
    width: 100%;
    background: var(--surface-page);
    transition: background-color var(--dur-hover) var(--ease-soft);
  }
  .nav-bar-logo--white {
    display: none;
  }

  /* Over a dark hero (the page opts in with data-nav-dark-hero; PageLayout toggles
     .is-on-dark while the hero is behind the nav): transparent band, white type. */
  :global(.is-on-dark) .nav-bar {
    background: transparent;
  }
  :global(.is-on-dark) .nav-bar-logo {
    display: none;
  }
  :global(.is-on-dark) .nav-bar-logo--white {
    display: block;
  }
  :global(.is-on-dark) .nav-bar-link {
    color: var(--cseed-white);
  }
  :global(.is-on-dark) .nav-bar-link--join {
    background: none;
  }
  :global(.is-on-dark) .nav-bar :global(.nav-bar-rule) {
    background: rgba(255, 255, 255, 0.4) !important;
  }
  :global(.is-on-dark) .nav-bar-dropdown {
    background: transparent;
  }
  :global(.is-on-dark) .nav-bar-dropdown :global(.dropdown-nav-item) {
    color: var(--cseed-white);
  }
  .nav-bar-mark {
    position: absolute;
    left: 41px;
    top: 0;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .nav-bar-items {
    position: absolute;
    right: 77px;
    top: 0;
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .nav-bar-item {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-bar-link {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 28px;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  .nav-bar-items:has(.nav-bar-item:hover) .nav-bar-item:not(:hover) .nav-bar-link {
    opacity: 0.45;
  }
  /* "programs" only opens its dropdown; the program links do the navigating. */
  .nav-bar-link--menu {
    padding: 0;
    border: 0;
    background: none;
    cursor: default;
  }
  .nav-bar-link--join {
    padding: 0 8px;
    margin: 0 -8px;
    background: linear-gradient(
      transparent 42%,
      var(--cseed-sun) 42%,
      var(--cseed-sun) 92%,
      transparent 92%
    );
  }
  .nav-bar-dropdown {
    position: absolute;
    left: 50%;
    min-width: 100%;
    transform: translateX(-50%) translateY(-12px);
    opacity: 0;
    visibility: hidden;
    padding: 0 27px 20px;
    box-sizing: border-box;
    background: var(--surface-page);
    /* Closing waits 250ms, so a mouse that briefly slips off "programs" on its way
       down (e.g. heading diagonally for "saturdays") can still reach the menu. */
    transition:
      opacity var(--dur-hover) var(--ease-soft) 250ms,
      transform var(--dur-hover) var(--ease-soft) 250ms,
      visibility 0s linear calc(var(--dur-hover) + 250ms);
    z-index: 4;
  }
  .nav-bar-item:hover .nav-bar-dropdown,
  .nav-bar-item:focus-within .nav-bar-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    transition:
      opacity var(--dur-hover) var(--ease-soft),
      transform var(--dur-hover) var(--ease-soft),
      visibility 0s;
  }
  .nav-bar :global(.nav-bar-rule) {
    position: absolute;
    left: 0;
    bottom: 0;
    pointer-events: none;
  }
</style>
