---
import Rule from '../core/Rule.astro';

/* Source node "nav bar" -- 2085x200, wordmark inset 41px, Playfair 80 items
   right-aligned, 1px black rule 182px down. Rendered here at a compact 72px band
   (itemSize 28 / wordmarkSize 28); the band height is `--nav-h` below. */
const items = [
  { label: 'buildspace', href: '/buildspace/' },
  { label: 'buildher', href: '/buildher/' },
  { label: 'about us', href: '/about-us/' },
  { label: 'join', href: '/join/' },
];
---

<div class="nav-bar">
  <a class="nav-bar-mark" href="/">
    <img class="nav-bar-logo" src="/images/cseed-logo.png" alt="cseed" width="69" height="16" />
    <img class="nav-bar-logo nav-bar-logo--white" src="/images/cseed-logo-white.png" alt="" aria-hidden="true" width="69" height="16" />
  </a>
  <div class="nav-bar-items">
    {
      items.map((item) => (
        <div class="nav-bar-item">
          <a
            href={item.href}
            class:list={['nav-bar-link', { 'nav-bar-link--join': item.label === 'join' }]}
          >
            {item.label}
          </a>
        </div>
      ))
    }
  </div>
  <Rule width={2085} weight={1} class="nav-bar-rule" />
</div>

<style>
  .nav-bar-logo {
    display: block;
    width: 96px;
    height: auto;
  }
  .nav-bar {
    --nav-h: 72px;
    position: relative;
    width: 100%;
    height: var(--nav-h);
    background: var(--surface-page);
    transition: background-color var(--dur-hover) var(--ease-soft);
  }
  .nav-bar-logo--white {
    display: none;
  }

  /* Over a dark hero (the page opts in with data-nav-dark-hero; PageLayout toggles
     .is-on-dark while the hero is behind the nav): transparent band, white type. */
  :global(.is-on-dark) .nav-bar {
    background: transparent;
  }
  :global(.is-on-dark) .nav-bar-logo {
    display: none;
  }
  :global(.is-on-dark) .nav-bar-logo--white {
    display: block;
  }
  :global(.is-on-dark) .nav-bar-link {
    color: var(--cseed-white);
  }
  :global(.is-on-dark) .nav-bar-link--join {
    background: none;
  }
  :global(.is-on-dark) .nav-bar :global(.nav-bar-rule) {
    background: rgba(255, 255, 255, 0.4) !important;
  }

  .nav-bar-mark {
    position: absolute;
    left: 41px;
    top: 0;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .nav-bar-items {
    position: absolute;
    right: 77px;
    top: 0;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .nav-bar-item {
    position: relative;
    height: var(--nav-h);
    display: flex;
    align-items: center;
  }
  .nav-bar-link {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 28px;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  @media (hover: hover) {
    .nav-bar-items:has(.nav-bar-item:hover) .nav-bar-item:not(:hover) .nav-bar-link {
      opacity: 0.45;
    }
  }
  .nav-bar-link--join {
    padding: 0 8px;
    margin: 0 -8px;
    background: linear-gradient(
      transparent 42%,
      var(--cseed-sun) 42%,
      var(--cseed-sun) 92%,
      transparent 92%
    );
  }
  .nav-bar :global(.nav-bar-rule) {
    position: absolute;
    left: 0;
    bottom: 0;
    pointer-events: none;
  }

  /* Mobile canvas (responsive pages only). The band grows to 88px (about 44px on a
     phone), and each link's tap area stretches to the band's full height. */
  @media (max-width: 900px) {
    :global(html[data-responsive]) .nav-bar {
      --nav-h: 88px;
    }
    :global(html[data-responsive]) .nav-bar-link {
      position: relative;
    }
    :global(html[data-responsive]) .nav-bar-link::after {
      content: '';
      position: absolute;
      left: -13px;
      right: -13px;
      top: 50%;
      height: var(--nav-h);
      transform: translateY(-50%);
    }
    :global(html[data-responsive]) .nav-bar-mark {
      left: 32px;
    }
    :global(html[data-responsive]) .nav-bar-items {
      right: 32px;
      gap: 26px;
    }
    :global(html[data-responsive]) .nav-bar-logo {
      width: 88px;
    }
    :global(html[data-responsive]) .nav-bar-link {
      font-size: 30px;
    }
    :global(html[data-responsive]) .nav-bar :global(.nav-bar-rule) {
      width: 100% !important;
    }
  }
</style>
