---
/** Site footer. Rendered by BaseLayout on every page. */
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap inner">
    <p class="note">
      &copy; {year} CSEED. Placeholder copy — replace before launch.
    </p>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/events/">Events</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-xl);
    padding-block: var(--space-lg);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .note {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  a {
    color: var(--text-muted);
  }

  a:hover {
    color: var(--brand);
  }
</style>
