{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cseed-membership-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
  },
  // UTC candidates for 7am Pacific; the handler selects PDT or PST by scheduledTime.
  "triggers": { "crons": ["0 14 * * *", "0 15 * * *"] },
  "vars": {
    // TURNSTILE_SECRET_KEY, MEMBER_NAMES_EXPORT_TOKEN and SITE_DEPLOY_HOOK_URL
    // must be set with wrangler secret put, never here.
    "ALLOWED_ORIGINS": "https://cseed.co,https://www.cseed.co",
    "SUBMISSIONS_ENABLED": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cseed-membership",
      "database_id": "e441a235-0501-439e-bdf7-8dbb4060571f",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "TOTAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
}
