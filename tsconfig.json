{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    // Lets you write `import Foo from '~/components/Foo.astro'` from any depth
    // instead of counting `../../`s.
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  }
}
